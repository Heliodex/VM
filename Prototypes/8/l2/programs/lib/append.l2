Joins two lists. The input is the pair (xs . ys); the output is Ok of xs followed by ys.
---

---
fn p
	let xs = (fst p)
	let ys = (snd p)
	letrec app = fn l
		if (= (@ l) 1)
			(Ok ys)
		else
			let h = ((head l)?)
			let t = ((tail l)?)
			let r = ((app t)?)
			(Ok (cons h r))
	(app xs)
---
(~ . ~) => Ok ~ fuel 1000
([1 2] . [3]) => Ok [1 2 3] fuel 1000
(~ . [4]) => Ok [4] fuel 1000
([1] . ~) => Ok [1] fuel 1000

