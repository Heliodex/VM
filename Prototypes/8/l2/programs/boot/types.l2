The first part of the L2 checker, written in L2 with no mutation. The state is a value: a counter for the next variable, the bindings of the variables, and the errors so far. A binding is a list of (id . Bind), and a new binding is consed on the front, so a lookup finds the newest. Every operation gives back the state it changes. This file holds the types, the state, and unification. A test's output is the rendered first type, with the errors, as the Luau checker writes them.
---
---
type Ty = TVar Int | TCon ⟨[Int] [Ty]⟩
type Bind = Unbound Int | Bound Ty
type St = St ⟨Int ⟨Tr ⟨[[Int]] [⟨⟨Int Int⟩ Ty⟩]⟩⟩⟩
type Scheme = Scheme ⟨[Int] Ty⟩
type Entry =
	| EVar Scheme
	| ECtor ⟨[Int] ⟨[Int] ⟨Int ⟨Int Ty⟩⟩⟩⟩
	| ESum ⟨[Int] ⟨[Int] [⟨[Int] ⟨Int Int⟩⟩]⟩⟩
	| ERecC ⟨[Int] ⟨[Int] ⟨Int ⟨[[Int]] Ty⟩⟩⟩⟩
	| EAcc ⟨[Int] ⟨Int Int⟩⟩
type Look = Found Entry | Missing
type EN = EN ⟨[Entry] [⟨Int EN⟩]⟩
type PTy =
	| TName ⟨[Int] ⟨Int Int⟩⟩
	| TApp ⟨[Int] ⟨[PTy] ⟨Int Int⟩⟩⟩
	| TPair ⟨PTy ⟨PTy ⟨Int Int⟩⟩⟩
	| TList ⟨PTy ⟨Int Int⟩⟩
	| TFun ⟨PTy ⟨PTy ⟨Int Int⟩⟩⟩
	| NoType
	| TRec [⟨[Int] ⟨PTy ⟨Int Int⟩⟩⟩]
type Test =
	| KAny
	| KNil
	| KInt
	| KFn
	| KPin
	| KPair ⟨Test Test⟩
	| KList ⟨Test Test⟩
	| KSum [⟨Int Test⟩]
	| KRec [Int]
	| KFixdef ⟨[Int] Test⟩
type InputCheck =
	| NoInputCheck
	| HasInputCheck ⟨Test [Int]⟩
type Req =
	| Unify ⟨Ty Ty⟩
	| Gen ⟨Int Ty⟩
	| Inst ⟨Int Scheme⟩
	| Infer ⟨[⟨[Int] ⟨[[Int]] ⟨[⟨[Int] ⟨PTy ⟨Int Int⟩⟩⟩] ⟨Int Int⟩⟩⟩⟩] Expr⟩
	| InferI ⟨[⟨[Int] ⟨[⟨[Int] ⟨[[Int]] ⟨[⟨[Int] ⟨PTy ⟨Int Int⟩⟩⟩] ⟨Int Int⟩⟩⟩⟩] Expr⟩⟩] ⟨[⟨[Int] ⟨[[Int]] ⟨[⟨[Int] ⟨PTy ⟨Int Int⟩⟩⟩] ⟨Int Int⟩⟩⟩⟩] Expr⟩⟩
	| InferT ⟨[⟨[Int] ⟨[⟨[Int] ⟨[[Int]] ⟨[⟨[Int] ⟨PTy ⟨Int Int⟩⟩⟩] ⟨Int Int⟩⟩⟩⟩] Expr⟩⟩] ⟨[⟨[Int] ⟨[[Int]] ⟨[⟨[Int] ⟨PTy ⟨Int Int⟩⟩⟩] ⟨Int Int⟩⟩⟩⟩] Expr⟩⟩
type MS = MS ⟨St ⟨Int ⟨[Int] ⟨Ty ⟨[Ty] ⟨[Int] Int⟩⟩⟩⟩⟩⟩
type Expr =
	| EInt ⟨Int ⟨Int Int⟩⟩
	| EStr ⟨[Int] ⟨Int Int⟩⟩
	| ENil ⟨Int Int⟩
	| EName ⟨[Int] ⟨Int Int⟩⟩
	| EList ⟨[Expr] ⟨Int Int⟩⟩
	| EPair ⟨Expr ⟨Expr ⟨Int Int⟩⟩⟩
	| EApp ⟨Expr ⟨[Expr] ⟨Int Int⟩⟩⟩
	| EFn ⟨[[Int]] ⟨Expr ⟨Int Int⟩⟩⟩
	| ELet ⟨[Int] ⟨Expr ⟨Expr ⟨Int ⟨Int Int⟩⟩⟩⟩⟩
	| EMutual ⟨[⟨[Int] ⟨Expr ⟨Int Int⟩⟩⟩] ⟨Expr ⟨Int Int⟩⟩⟩
	| EIf ⟨Expr ⟨Expr ⟨Expr ⟨Int Int⟩⟩⟩⟩
	| EMatch ⟨Expr ⟨[⟨Pat ⟨Expr ⟨Int Int⟩⟩⟩] ⟨Int Int⟩⟩⟩
	| ETry ⟨Expr ⟨Int Int⟩⟩
	| ECheck ⟨Expr ⟨Int Int⟩⟩
	| EUntyped ⟨Expr ⟨Int Int⟩⟩
	| ERec ⟨[Int] ⟨[⟨[Int] ⟨Expr ⟨Int Int⟩⟩⟩] ⟨Int Int⟩⟩⟩
	| EWith ⟨Expr ⟨[⟨[Int] ⟨Expr ⟨Int Int⟩⟩⟩] ⟨Int Int⟩⟩⟩
type Tr = TEmpty | TNode ⟨Bind ⟨Tr ⟨Tr ⟨Tr Tr⟩⟩⟩⟩
type Pat =
	| PCon ⟨[Int] ⟨[Int] ⟨Int Int⟩⟩⟩
	| PBind ⟨[Int] ⟨Int Int⟩⟩
	| PWild ⟨Int Int⟩
	| PRec ⟨[Int] ⟨[⟨[Int] ⟨[Int] ⟨Int Int⟩⟩⟩] ⟨Int Int⟩⟩⟩
let hdOr = fn (l dflt)
	match (head l)
		Ok x -> x
		Err e -> dflt
let first = fn l
	match (head l)
		Ok c -> c
		Err e -> -1
let tl = fn l
	match (tail l)
		Ok t -> t
		Err e -> ~
let div10 = fn n
	match (/ n 10)
		Ok q -> q
		Err e -> 0
let mod10 = fn n
	match (% n 10)
		Ok r -> r
		Err e -> 0
; Names are compared a byte at a time. Each step reads the head of each list once, through the builtin (a match, not a call to first), since this is the innermost loop of the name environment.
letrec same = fn (a b)
	match (head a)
		Err e -> (if (= (@ b) 1) 1 0)
		Ok x ->
			match (head b)
				Err f -> 0
				Ok y ->
					if (= x y)
						match (tail a)
							Err g -> 0
							Ok ta ->
								match (tail b)
									Err h -> 0
									Ok tb -> (same ta tb)
					else
						0
letrec lenOf = fn l
	(if (= (@ l) 1) 0 (+ 1 (lenOf (tl l))))
letrec cat = fn (a b)
	(if (= (@ a) 1) b (cons (first a) (cat (tl a) b)))
letrec showNat = fn n
	(if (< n 10) (cons (+ 48 n) ~) (cat (showNat (div10 n)) (cons (+ 48 (mod10 n)) ~)))
let varName = fn id
	(cat "?" (showNat id))
let stP = fn st
	match st
		St p -> p
let nextOf = fn st
	(fst (stP st))
let bindsOf = fn st
	(fst (snd (stP st)))
let errsOf = fn st
	(fst (snd (snd (stP st))))
let pendOf = fn st
	(snd (snd (snd (stP st))))
let mkSt = fn (n bs es)
	(St ⟨n ⟨bs ⟨es ~⟩⟩⟩)
let restate = fn (st n bs es)
	(St ⟨n ⟨bs ⟨es (pendOf st)⟩⟩⟩)
let addPend = fn (st at ty)
	(St ⟨(nextOf st) ⟨(bindsOf st) ⟨(errsOf st) (cons ⟨at ty⟩ (pendOf st))⟩⟩⟩)
letrec snoc = fn (l x)
	if (= (@ l) 1)
		(cons x ~)
	else
		match (head l)
			Ok h -> (cons h (snoc (tl l) x))
			Err e -> (cons x ~)
let addErr = fn (st msg)
	(restate st (nextOf st) (bindsOf st) (snoc (errsOf st) msg))
; The binding store is a radix-4 trie on the id. A node holds the binding of the id that is 0 at that node (the node's own), and four children, one for each remainder r = id mod 4; a child is reached with id div 4. So a lookup takes about log4 of the id in levels, each with one division, where the binary trie it replaces took log2 with two. The children are a nest of pairs (c0 . (c1 . (c2 . c3))), read with fst and snd, so no list is walked.
letrec findB = fn (bs id)
	match (/ id 4)
		Ok q ->
			match bs
				TEmpty -> (Unbound 0)
				TNode p ->
					if (= id 0)
						fst p
					else
						let r = (- id (* 4 q))
						let kids = (snd p)
						if (< r 2)
							(if (= r 0) (findB (fst kids) q) (findB (fst (snd kids)) q))
						elseif (= r 2)
							findB (fst (snd (snd kids))) q
						else
							findB (snd (snd (snd kids))) q
		Err e -> (Unbound 0)
letrec setB = fn (bs id b)
	match (/ id 4)
		Ok q ->
			match bs
				TEmpty -> (setB (TNode ⟨(Unbound 0) ⟨TEmpty ⟨TEmpty ⟨TEmpty TEmpty⟩⟩⟩⟩) id b)
				TNode p ->
					if (= id 0)
						TNode ⟨b (snd p)⟩
					else
						let r = (- id (* 4 q))
						let kids = (snd p)
						if (= r 0)
							TNode ⟨(fst p) ⟨(setB (fst kids) q b) (snd kids)⟩⟩
						elseif (= r 1)
							TNode ⟨(fst p) ⟨(fst kids) ⟨(setB (fst (snd kids)) q b) (snd (snd kids))⟩⟩⟩
						elseif (= r 2)
							TNode ⟨(fst p) ⟨(fst kids) ⟨(fst (snd kids)) ⟨(setB (fst (snd (snd kids))) q b) (snd (snd (snd kids)))⟩⟩⟩⟩
						else
							TNode ⟨(fst p) ⟨(fst kids) ⟨(fst (snd kids)) ⟨(fst (snd (snd kids))) (setB (snd (snd (snd kids))) q b)⟩⟩⟩⟩
		Err e -> bs
let levelOf = fn b
	match b
		Unbound lv -> lv
		Bound t -> 0
let fresh = fn (st level)
	let n = (nextOf st)
	⟨(TVar n) (restate st (+ n 1) (setB (bindsOf st) n (Unbound level)) (errsOf st))⟩
letrec prune = fn (bs t)
	match t
		TVar id ->
			match (findB bs id)
				Bound u -> (prune bs u)
				Unbound lv -> t
		TCon p -> t
letrec occurs = fn (bs id t)
	letrec all = fn args
		(if (= (@ args) 1) 0 (if (occurs bs id (hdOr args (TVar 0))) 1 (all (tl args))))
	match (prune bs t)
		TVar y -> (= y id)
		TCon p -> (all (snd p))
letrec lowerT = fn (bs t level)
	letrec lowerArgs = fn (b args)
		(if (= (@ args) 1) b (lowerArgs (lowerT b (hdOr args (TVar 0)) level) (tl args)))
	match (prune bs t)
		TVar y -> (if (< level (levelOf (findB bs y))) (setB bs y (Unbound level)) bs)
		TCon p -> (lowerArgs bs (snd p))
let hasArgs = fn (bs a)
	match (prune bs a)
		TVar y -> 0
		TCon p -> (if (= (@ (snd p)) 1) 0 1)
let startsOpen = fn s
	(if (= (hdOr s 0) 40) 1 (if (= (hdOr s 0) 91) 1 (= (hdOr s 0) 10216)))
letrec hasSpaceL = fn s
	(if (= (@ s) 1) 0 (if (= (hdOr s 0) 32) 1 (hasSpaceL (tl s))))
let pairPart = fn s
	(if (hasSpaceL s) (if (startsOpen s) s (cat "(" (cat s ")"))) s)
letrec render = fn (bs t)
	letrec argText = fn a
		(if (= (hasArgs bs a) 1) (cat "(" (cat (render bs a) ")")) (render bs a))
	letrec argsText = fn args
		(if (= (@ args) 1) ~ (cat " " (cat (argText (hdOr args (TVar 0))) (argsText (tl args)))))
	letrec renderCon = fn (name args)
		(if (same name "->") (cat "(" (cat (render bs (hdOr args (TVar 0))) (cat " -> " (cat (render bs (hdOr (tl args) (TVar 0))) ")")))) (if (same name "pair") (cat "⟨" (cat (pairPart (render bs (hdOr args (TVar 0)))) (cat " " (cat (pairPart (render bs (hdOr (tl args) (TVar 0)))) "⟩")))) (if (same name "list") (cat "[" (cat (render bs (hdOr args (TVar 0))) "]")) (if (= (@ args) 1) name (cat name (argsText args))))))
	match (prune bs t)
		TVar y -> (varName y)
		TCon p -> (renderCon (fst p) (snd p))
let mismatch = fn (st a e)
	(addErr st (cat "expected " (cat (render (bindsOf st) e) (cat ", but this is " (render (bindsOf st) a)))))
let bindVar = fn (st id t)
	(if (occurs (bindsOf st) id t) (addErr st (cat (varName id) " would be an infinite type")) (restate st (nextOf st) (setB (lowerT (bindsOf st) t (levelOf (findB (bindsOf st) id))) id (Bound t)) (errsOf st)))
letrec unify = fn (st a0 e0)
	letrec unifyArgs = fn (st0 aa ea)
		if (= (@ aa) 1)
			st0
		else
			let st1 = (unify st0 (hdOr aa (TVar 0)) (hdOr ea (TVar 0)))
			(if (< (lenOf (errsOf st0)) (lenOf (errsOf st1))) st1 (unifyArgs st1 (tl aa) (tl ea)))
	let unifyCon = fn (st2 na aa ne ea a e)
		(if (if (same na "Dyn") (same ne "Dyn") 0) st2 (if (if (same na "Dyn") 1 (same ne "Dyn")) (mismatch st2 a e) (if (if (same na ne) (= (lenOf aa) (lenOf ea)) 0) (unifyArgs st2 aa ea) (mismatch st2 a e))))
	let bs = (bindsOf st)
	let a = (prune bs a0)
	let e = (prune bs e0)
	match a
		TVar x ->
			match e
				TVar y -> (if (= x y) st (bindVar st x e))
				TCon q -> (bindVar st x e)
		TCon p ->
			match e
				TVar y -> (bindVar st y a)
				TCon q -> (unifyCon st (fst p) (snd p) (fst q) (snd q) a e)
letrec memberI = fn (x l)
	match (head l)
		Err e -> 0
		Ok y ->
			if (= y x)
				1
			else
				memberI x (tl l)
letrec freeAbove = fn (bs level t acc)
	letrec argsFree = fn (acc2 args)
		(if (= (@ args) 1) acc2 (argsFree (freeAbove bs level (hdOr args (TVar 0)) acc2) (tl args)))
	match (prune bs t)
		TVar y -> (if (if (< level (levelOf (findB bs y))) (if (memberI y acc) 0 1) 0) (snoc acc y) acc)
		TCon p -> (argsFree acc (snd p))
let generalize = fn (st level t)
	(Scheme ⟨(freeAbove (bindsOf st) level t ~) t⟩)
let schemeVars = fn s
	match s
		Scheme p -> (fst p)
let schemeTy = fn s
	match s
		Scheme p -> (snd p)
letrec lookupM = fn (m id dflt)
	match (head m)
		Err e -> dflt
		Ok c ->
			if (= (fst c) id)
				snd c
			else
				lookupM (tl m) id dflt
letrec subst = fn (bs m t)
	letrec substArgs = fn args
		(if (= (@ args) 1) ~ (cons (subst bs m (hdOr args (TVar 0))) (substArgs (tl args))))
	match (prune bs t)
		TVar y -> (lookupM m y (TVar y))
		TCon p -> (TCon ⟨(fst p) (substArgs (snd p))⟩)
letrec instMap = fn (st level m vars)
	if (= (@ vars) 1)
		⟨st m⟩
	else
		let fr = (fresh st level)
		(instMap (snd fr) level (cons ⟨(first vars) (fst fr)⟩ m) (tl vars))
let instantiate = fn (st level s)
	let r = (instMap st level ~ (schemeVars s))
	⟨(subst (bindsOf (fst r)) (snd r) (schemeTy s)) (fst r)⟩
letrec idsText = fn l
	(if (= (@ l) 1) ~ (cat (varName (first l)) (if (= (@ (tl l)) 1) ~ (cat " " (idsText (tl l))))))
let schemeText = fn (bs s)
	(if (= (@ (schemeVars s)) 1) (render bs (schemeTy s)) (cat "forall " (cat (idsText (schemeVars s)) (cat ". " (render bs (schemeTy s))))))
let runUnify = fn q
	let st = (unify (mkSt 1000 TEmpty ~) (fst q) (snd q))
	⟨(render (bindsOf st) (fst q)) (errsOf st)⟩
let runGen = fn q
	let st = (mkSt 1000 TEmpty ~)
	let s = (generalize st (fst q) (snd q))
	⟨(schemeText (bindsOf st) s) ~⟩
let runInst = fn q
	let st = (mkSt 1000 TEmpty ~)
	let r = (instantiate st (fst q) (snd q))
	⟨(render (bindsOf (snd r)) (fst r)) (errsOf (snd r))⟩
let atOfE = fn e
	match e
		ERec p -> (snd (snd p))
		EWith p -> (snd (snd p))
		EInt p -> (snd p)
		EStr p -> (snd p)
		ENil p -> p
		EName p -> (snd p)
		EList p -> (snd p)
		EPair p -> (snd (snd p))
		EApp p -> (snd (snd p))
		EFn p -> (snd (snd p))
		ELet p -> (snd (snd (snd (snd p))))
		EMutual p -> (snd (snd p))
		EIf p -> (snd (snd (snd p)))
		EMatch p -> (snd (snd p))
		ETry p -> (snd p)
		ECheck p -> (snd p)
		EUntyped p -> (snd p)
letrec lastMsg = fn l
	(if (= (@ (tl l)) 1) (hdOr l ~) (lastMsg (tl l)))
let posMsg = fn (at msg)
	(cat "line " (cat (showNat (fst at)) (cat ", column " (cat (showNat (snd at)) (cat ": " msg)))))
let tInt = (TCon ⟨"Int" ~⟩)
let tDyn = (TCon ⟨"Dyn" ~⟩)
let tArrow = fn (a b)
	(TCon ⟨"->" [a b]⟩)
let tList = fn a
	(TCon ⟨"list" [a]⟩)
let tPair = fn (a b)
	(TCon ⟨"pair" [a b]⟩)
let tRes = fn (a e)
	(TCon ⟨"Result" [a e]⟩)
let tPin = fn a
	(TCon ⟨"Pin" [a]⟩)
let mono = fn (name ty)
	⟨name (EVar (Scheme ⟨~ ty⟩))⟩
let poly = fn (vars name ty)
	⟨name (EVar (Scheme ⟨vars ty⟩))⟩
let builtinList = [(mono "+" (tArrow tInt (tArrow tInt tInt))) (mono "-" (tArrow tInt (tArrow tInt tInt))) (mono "*" (tArrow tInt (tArrow tInt tInt))) (mono "<" (tArrow tInt (tArrow tInt tInt))) (poly [1] "=" (tArrow (TVar 1) (tArrow (TVar 1) tInt))) (mono "/" (tArrow tInt (tArrow tInt (tRes tInt (tList tInt))))) (mono "%" (tArrow tInt (tArrow tInt (tRes tInt (tList tInt))))) (poly [1] "@" (tArrow (TVar 1) tInt)) (poly [1] "head" (tArrow (tList (TVar 1)) (tRes (TVar 1) (tList tInt)))) (poly [1] "tail" (tArrow (tList (TVar 1)) (tRes (tList (TVar 1)) (tList tInt)))) (poly [1 2] "fst" (tArrow (tPair (TVar 1) (TVar 2)) (TVar 1))) (poly [1 2] "snd" (tArrow (tPair (TVar 1) (TVar 2)) (TVar 2))) (poly [1] "cons" (tArrow (TVar 1) (tArrow (tList (TVar 1)) (tList (TVar 1))))) (poly [1] "pin" (tArrow (TVar 1) (tPin (TVar 1)))) (poly [1] "force" (tArrow (tPin (TVar 1)) (TVar 1))) (poly [1] "fix" (tArrow (tArrow (TVar 1) (TVar 1)) (TVar 1))) ⟨"Ok" (ECtor ⟨"Result" ⟨[1 2] ⟨0 ⟨1 (TVar 1)⟩⟩⟩⟩)⟩ ⟨"Err" (ECtor ⟨"Result" ⟨[1 2] ⟨1 ⟨1 (TVar 2)⟩⟩⟩⟩)⟩ ⟨"#Result" (ESum ⟨"Result" ⟨[1 2] [⟨"Ok" ⟨0 1⟩⟩ ⟨"Err" ⟨1 1⟩⟩]⟩⟩)⟩]
; The name environment is a persistent trie on the bytes of a name, not a list. A lookup walks the name, so it costs the same however many names are in scope, and a list walk was the quadratic term of the checker (Phase 0). A node is (entries . children): the entries bound at exactly this name (a list of at most one, the newest), and the children, a list of (byte . node). Binding copies the nodes on one path, so an outer environment is unchanged by a binding made inside it, as a list was.
let envEmpty = (EN ⟨~ ~⟩)
letrec envKid = fn (kids b)
	match (head kids)
		Err e -> (EN ⟨~ ~⟩)
		Ok c ->
			if (= (fst c) b)
				snd c
			else
				match (tail kids)
					Err g -> (envKid ~ b)
					Ok t -> (envKid t b)
letrec envPut = fn (kids b child)
	match (head kids)
		Err e -> cons ⟨b child⟩ ~
		Ok c ->
			if (= (fst c) b)
				match (tail kids)
					Err g -> cons ⟨b child⟩ ~
					Ok t -> cons ⟨b child⟩ t
			else
				match (tail kids)
					Err g -> cons c (envPut ~ b child)
					Ok t -> cons c (envPut t b child)
letrec envBind = fn (node name e)
	match node
		EN p ->
			if (= (@ name) 1)
				EN ⟨(cons e ~) (snd p)⟩
			else
				let b = (hdOr name 0)
				let child = (envKid (snd p) b)
				EN ⟨(fst p) (envPut (snd p) b (envBind child (tl name) e))⟩
let envCons = fn (env pr)
	envBind env (fst pr) (snd pr)
letrec envFind = fn (node name)
	match node
		EN p ->
			if (= (@ name) 1)
				(if (= (@ (fst p)) 1) Missing (Found (hdOr (fst p) (EVar (Scheme ⟨~ (TVar 0)⟩)))))
			else
				envFind (envKid (snd p) (hdOr name 0)) (tl name)
letrec findE = fn (env name)
	envFind env name
letrec envFromList = fn l
	if (= (@ l) 1)
		envEmpty
	else
		envCons (envFromList (tl l)) (hdOr l ⟨~ (EVar (Scheme ⟨~ (TVar 0)⟩))⟩)
let builtinEnv = envFromList builtinList
let addPos = fn (st0 st1 at)
	(if (< (lenOf (errsOf st0)) (lenOf (errsOf st1))) (restate st1 (nextOf st1) (bindsOf st1) (snoc (errsOf st0) (posMsg at (lastMsg (errsOf st1))))) st1)
let unifyAt = fn (st at a e)
	(addPos st (unify st a e) at)
letrec varsOf = fn l
	(if (= (@ l) 1) ~ (cons (TVar (first l)) (varsOf (tl l))))
let ctorSch = fn (name params hasPay payload)
	(if (= hasPay 1) (Scheme ⟨params (tArrow payload (TCon ⟨name (varsOf params)⟩))⟩) (Scheme ⟨params (TCon ⟨name (varsOf params)⟩)⟩))
let ctorScheme = fn c
	match c
		ECtor p -> (ctorSch (fst p) (fst (snd p)) (fst (snd (snd (snd p)))) (snd (snd (snd (snd p)))))
		_ -> (Scheme ⟨~ (TVar 0)⟩)
let retEntry = fn e
	match e
		EVar s -> (schemeTy s)
		_ -> (TVar 0)
let retOf = fn env
	match (findE env "#ret")
		Found e -> (retEntry e)
		Missing -> (TVar 0)
let notBound = fn (st p level)
	let fr = (fresh st level)
	⟨(fst fr) (addErr (snd fr) (posMsg (snd p) (cat (fst p) " is not bound")))⟩
let lookupEntry = fn (st e p level)
	match e
		EVar s -> (instantiate st level s)
		ECtor c -> (instantiate st level (ctorScheme (ECtor c)))
		ERecC r ->
			let fr = (fresh st level)
			⟨(fst fr) (addErr (snd fr) (posMsg (snd p) (cat (fst p) " is a record: write its fields in braces")))⟩
		_ -> (notBound st p level)
let lookupName = fn (st env p level)
	match (findE env (fst p))
		Found e -> (lookupEntry st e p level)
		Missing -> (notBound st p level)
let badProgram = fn (bs t)
	match (prune bs t)
		TVar y -> 0
		TCon p -> (if (same (fst p) "->") 0 1)
let grew = fn (a b)
	(if (< (lenOf (errsOf a)) (lenOf (errsOf b))) 1 0)
let msP = fn ms
	match ms
		MS p -> p
let msSt = fn ms
	(fst (msP ms))
let msFixed = fn ms
	(fst (snd (msP ms)))
let msName = fn ms
	(fst (snd (snd (msP ms))))
let msTy = fn ms
	(fst (snd (snd (snd (msP ms)))))
let msArgs = fn ms
	(fst (snd (snd (snd (snd (msP ms))))))
let msCov = fn ms
	(fst (snd (snd (snd (snd (snd (msP ms)))))))
let msCatch = fn ms
	(snd (snd (snd (snd (snd (snd (msP ms)))))))
let mkMS = fn (st fixed nm ty args cov catch)
	(MS ⟨st ⟨fixed ⟨nm ⟨ty ⟨args ⟨cov catch⟩⟩⟩⟩⟩⟩)
let withSt = fn (ms st)
	(mkMS st (msFixed ms) (msName ms) (msTy ms) (msArgs ms) (msCov ms) (msCatch ms))
let withCatch = fn ms
	(mkMS (msSt ms) (msFixed ms) (msName ms) (msTy ms) (msArgs ms) (msCov ms) 1)
letrec freshN = fn (st0 n level)
	if (= n 0)
		⟨~ st0⟩
	else
		let r = (fresh st0 level)
		let more = (freshN (snd r) (- n 1) level)
		⟨(cons (fst r) (fst more)) (snd more)⟩
letrec zipM = fn (ps as)
	(if (= (@ ps) 1) ~ (cons ⟨(first ps) (hdOr as (TVar 0))⟩ (zipM (tl ps) (tl as))))
letrec missingNames = fn (ctors cov)
	if (= (@ ctors) 1)
		~
	else
		let rest = (missingNames (tl ctors) cov)
		(if (= (memberI (fst (snd (hdOr ctors ⟨~ ⟨0 0⟩⟩))) cov) 1) rest (cons (fst (hdOr ctors ⟨~ ⟨0 0⟩⟩)) rest))
letrec joinNames = fn l
	(if (= (@ l) 1) ~ (if (= (@ (tl l)) 1) (hdOr l ~) (cat (hdOr l ~) (cat ", " (joinNames (tl l))))))
let argsOfT = fn t
	match t
		TVar y -> ~
		TCon p -> (snd p)
letrec fieldAtT = fn (t index count)
	(if (= index 1) (if (= count 1) t (hdOr (argsOfT t) (TVar 0))) (fieldAtT (hdOr (tl (argsOfT t)) (TVar 0)) (- index 1) (- count 1)))
letrec payloadOfT = fn tys
	(if (= (@ (tl tys)) 1) (hdOr tys (TVar 0)) (tPair (hdOr tys (TVar 0)) (payloadOfT (tl tys))))
letrec nameIn = fn (n l)
	(if (= (@ l) 1) 0 (if (same n (hdOr l ~)) 1 (nameIn n (tl l))))
letrec nameIndex = fn (n l j)
	(if (= (@ l) 1) 0 (if (same n (hdOr l ~)) j (nameIndex n (tl l) (+ j 1))))
letrec initFor = fn (n inits)
	(if (= (@ inits) 1) ⟨~ ⟨(ENil ⟨0 0⟩) ⟨0 0⟩⟩⟩ (if (same (fst (hdOr inits ⟨~ ⟨(ENil ⟨0 0⟩) ⟨0 0⟩⟩⟩)) n) (hdOr inits ⟨~ ⟨(ENil ⟨0 0⟩) ⟨0 0⟩⟩⟩) (initFor n (tl inits))))
letrec hasInit = fn (n inits)
	(if (= (@ inits) 1) 0 (if (same (fst (hdOr inits ⟨~ ⟨(ENil ⟨0 0⟩) ⟨0 0⟩⟩⟩)) n) 1 (hasInit n (tl inits))))
let recDefault = ⟨~ ⟨~ ⟨0 ⟨~ (TVar 0)⟩⟩⟩⟩
let accDefault = ⟨~ ⟨0 0⟩⟩
let recEntry = fn e
	match e
		ERecC r -> ⟨1 r⟩
		_ -> ⟨0 recDefault⟩
let recOf = fn (env name)
	match (findE env name)
		Found e -> (recEntry e)
		Missing -> ⟨0 recDefault⟩
let accEntry = fn e
	match e
		EAcc a -> ⟨1 a⟩
		_ -> ⟨0 accDefault⟩
let accOf = fn (env name)
	match (findE env (cat "@" name))
		Found e -> (accEntry e)
		Missing -> ⟨0 accDefault⟩
let isRecT = fn t
	match t
		TRec fs -> 1
		_ -> 0
let recFieldsOf = fn t
	match t
		TRec fs -> fs
		_ -> ~
letrec fieldNames = fn fs
	(if (= (@ fs) 1) ~ (cons (fst (hdOr fs ⟨~ ⟨NoType ⟨0 0⟩⟩⟩)) (fieldNames (tl fs))))
letrec firstBadInit = fn (name names inits seen isWith)
	if (= (@ inits) 1)
		⟨0 ⟨⟨0 0⟩ ~⟩⟩
	else
		let it = (hdOr inits ⟨~ ⟨(ENil ⟨0 0⟩) ⟨0 0⟩⟩⟩)
		(if (= (nameIn (fst it) names) 0) ⟨1 ⟨(snd (snd it)) (if (= isWith 1) (cat (fst it) (cat " is not a field of " (cat name ", which the with takes from its first field"))) (cat name (cat " has no field " (fst it))))⟩⟩ (if (= (nameIn (fst it) seen) 1) ⟨1 ⟨(snd (snd it)) (cat (fst it) " is given twice")⟩⟩ (firstBadInit name names (tl inits) (cons (fst it) seen) isWith)))
letrec firstMissing = fn (names inits)
	(if (= (@ names) 1) ⟨0 ~⟩ (if (= (hasInit (hdOr names ~) inits) 1) (firstMissing (tl names) inits) ⟨1 (hdOr names ~)⟩))
letrec litVals = fn (inf st env level names inits payT j n)
	if (= (@ names) 1)
		⟨1 st⟩
	else
		let init = (initFor (hdOr names ~) inits)
		let fty = (fieldAtT payT j n)
		let r = (inf st env (fst (snd init)) level)
		let s1 = (unifyAt (snd r) (atOfE (fst (snd init))) (fst r) fty)
		(if (= (grew (snd r) s1) 1) ⟨0 s1⟩ (litVals inf s1 env level (tl names) inits payT (+ j 1) n))
let recLit = fn (inf st env node level)
	let name = (fst node)
	let inits = (fst (snd node))
	let at = (snd (snd node))
	let ro = (recOf env name)
	if (= (fst ro) 0)
		let fr = (fresh st level)
		⟨(fst fr) (addErr (snd fr) (posMsg at (cat name " is not a record")))⟩
	else
		let r = (snd ro)
		let sumN = (fst r)
		let ids = (fst (snd r))
		let names = (fst (snd (snd (snd r))))
		let pay = (snd (snd (snd (snd r))))
		let inst = (instMap st level ~ ids)
		let st1 = (fst inst)
		let m = (snd inst)
		let payT = (subst (bindsOf st1) m pay)
		let sumT = (subst (bindsOf st1) m (TCon ⟨sumN (varsOf ids)⟩))
		let bad = (firstBadInit name names inits ~ 0)
		if (= (fst bad) 1)
			(fresh (addErr st1 (posMsg (fst (snd bad)) (snd (snd bad)))) level)
		else
			let mis = (firstMissing names inits)
			if (= (fst mis) 1)
				(fresh (addErr st1 (posMsg at (cat name (cat " needs the field " (snd mis))))) level)
			else
				let fl = (litVals inf st1 env level names inits payT 1 (lenOf names))
				(if (= (fst fl) 0) (fresh (snd fl) level) ⟨sumT (snd fl)⟩)
letrec withVals = fn (inf st env level names inits payT n)
	if (= (@ inits) 1)
		⟨1 st⟩
	else
		let init = (hdOr inits ⟨~ ⟨(ENil ⟨0 0⟩) ⟨0 0⟩⟩⟩)
		let fty = (fieldAtT payT (nameIndex (fst init) names 1) n)
		let r = (inf st env (fst (snd init)) level)
		let s1 = (unifyAt (snd r) (atOfE (fst (snd init))) (fst r) fty)
		(if (= (grew (snd r) s1) 1) ⟨0 s1⟩ (withVals inf s1 env level names (tl inits) payT n))
let withE = fn (inf st env node level)
	let base = (fst node)
	let inits = (fst (snd node))
	let at = (snd (snd node))
	let ao = (accOf env (fst (hdOr inits ⟨~ ⟨(ENil ⟨0 0⟩) ⟨0 0⟩⟩⟩)))
	if (= (fst ao) 0)
		let first = (hdOr inits ⟨~ ⟨(ENil ⟨0 0⟩) ⟨0 0⟩⟩⟩)
		let fr = (fresh st level)
		⟨(fst fr) (addErr (snd fr) (posMsg (snd (snd first)) (cat (fst first) " is not a field of any record: a with takes its record from its first field")))⟩
	else
		let recName = (fst (snd ao))
		let ro = (recOf env recName)
		let r = (snd ro)
		let ids = (fst (snd r))
		let names = (fst (snd (snd (snd r))))
		let pay = (snd (snd (snd (snd r))))
		let inst = (instMap st level ~ ids)
		let st1 = (fst inst)
		let m = (snd inst)
		let payT = (subst (bindsOf st1) m pay)
		let sumT = (subst (bindsOf st1) m (TCon ⟨(fst r) (varsOf ids)⟩))
		let br = (inf st1 env base level)
		let s2 = (unifyAt (snd br) (atOfE base) (fst br) sumT)
		if (= (grew (snd br) s2) 1)
			(fresh (addErr (snd br) (posMsg (atOfE base) (cat "the base of a with must be " (cat (render (bindsOf (snd br)) sumT) (cat ", the record its first field names, but this is " (render (bindsOf (snd br)) (fst br))))))) level)
		else
			let bad = (firstBadInit recName names inits ~ 1)
			if (= (fst bad) 1)
				(fresh (addErr s2 (posMsg (fst (snd bad)) (snd (snd bad)))) level)
			else
				let vs = (withVals inf s2 env level names inits payT (lenOf names))
				(if (= (fst vs) 0) (fresh (snd vs) level) ⟨sumT (snd vs)⟩)
letrec recMissing = fn (ms env seen names name at)
	(if (= (@ names) 1) ⟨1 ⟨ms env⟩⟩ (if (= (nameIn (hdOr names ~) seen) 1) (recMissing ms env seen (tl names) name at) ⟨0 ⟨(withSt ms (addErr (msSt ms) (posMsg at (cat name (cat " needs the field " (hdOr names ~)))))) env⟩⟩))
letrec recPats = fn (ms env seen pats names pt name at)
	if (= (@ pats) 1)
		(recMissing ms env seen names name at)
	else
		let pf = (hdOr pats ⟨~ ⟨~ ⟨0 0⟩⟩⟩)
		let fname = (fst pf)
		let j = (nameIndex fname names 1)
		if (= j 0)
			⟨0 ⟨(withSt ms (addErr (msSt ms) (posMsg (snd (snd pf)) (cat name (cat " has no field " fname))))) env⟩⟩
		elseif (= (nameIn fname seen) 1)
			⟨0 ⟨(withSt ms (addErr (msSt ms) (posMsg (snd (snd pf)) (cat fname " is given twice")))) env⟩⟩
		else
			let env2 = (if (= (@ (fst (snd pf))) 1) env (envCons env ⟨(fst (snd pf)) (EVar (Scheme ⟨~ (fieldAtT pt j (lenOf names))⟩))⟩))
			(recPats ms env2 (cons fname seen) (tl pats) names pt name at)
let recBind = fn (ms env pats names ids pay tag name at)
	let ms1 = (mkMS (msSt ms) (msFixed ms) (msName ms) (msTy ms) (msArgs ms) (cons tag (msCov ms)) (msCatch ms))
	let pt = (subst (bindsOf (msSt ms1)) (zipM ids (msArgs ms1)) pay)
	(recPats ms1 env ~ pats names pt name at)
let recPat = fn (ms env p scrutTy scrutAt level)
	let name = (fst p)
	let pats = (fst (snd p))
	let at = (snd (snd p))
	let ro = (recOf env name)
	if (= (fst ro) 0)
		⟨0 ⟨(withSt ms (addErr (msSt ms) (posMsg at (cat name " is not a record")))) env⟩⟩
	else
		let r = (snd ro)
		let sumN = (fst r)
		let ids = (fst (snd r))
		let tag = (fst (snd (snd r)))
		let names = (fst (snd (snd (snd r))))
		let pay = (snd (snd (snd (snd r))))
		if (= (msFixed ms) 1)
			(if (same sumN (msName ms)) (recBind ms env pats names ids pay tag name at) ⟨0 ⟨(withSt ms (addErr (msSt ms) (posMsg at (cat name (cat " belongs to " (cat sumN (cat ", but the match is on " (msName ms)))))))) env⟩⟩)
		else
			let fr = (freshN (msSt ms) (lenOf ids) level)
			let sumT = (TCon ⟨sumN (fst fr)⟩)
			let s2 = (unifyAt (snd fr) scrutAt scrutTy sumT)
			(if (= (grew (snd fr) s2) 1) ⟨0 ⟨(withSt ms s2) env⟩⟩ (recBind (mkMS s2 1 sumN sumT (fst fr) (msCov ms) (msCatch ms)) env pats names ids pay tag name at))
let conPatGo = fn (ms env name bind at tagv hasPay pay params scrutTy level)
	let ms1 = (mkMS (msSt ms) (msFixed ms) (msName ms) (msTy ms) (msArgs ms) (cons tagv (msCov ms)) (msCatch ms))
	let pt = (subst (bindsOf (msSt ms1)) (zipM params (msArgs ms1)) pay)
	(if (= (@ bind) 1) ⟨1 ⟨ms1 env⟩⟩ (if (= hasPay 0) ⟨0 ⟨(withSt ms1 (addErr (msSt ms1) (posMsg at (cat name " has no payload to bind")))) env⟩⟩ ⟨1 ⟨ms1 (envCons env ⟨bind (EVar (Scheme ⟨~ pt⟩))⟩)⟩⟩))
let conCtor = fn (ms env c name bind at scrutTy scrutAt level)
	if (= (msFixed ms) 1)
		(if (same (fst c) (msName ms)) (conPatGo ms env name bind at (fst (snd (snd c))) (fst (snd (snd (snd c)))) (snd (snd (snd (snd c)))) (fst (snd c)) scrutTy level) ⟨0 ⟨(withSt ms (addErr (msSt ms) (posMsg at (cat name (cat " belongs to " (cat (fst c) (cat ", but the match is on " (msName ms)))))))) env⟩⟩)
	else
		let fr = (freshN (msSt ms) (lenOf (fst (snd c))) level)
		let sumT = (TCon ⟨(fst c) (fst fr)⟩)
		let s2 = (unifyAt (snd fr) scrutAt scrutTy sumT)
		(if (= (grew (snd fr) s2) 1) ⟨0 ⟨(withSt ms s2) env⟩⟩ (conPatGo (mkMS s2 1 (fst c) sumT (fst fr) (msCov ms) (msCatch ms)) env name bind at (fst (snd (snd c))) (fst (snd (snd (snd c)))) (snd (snd (snd (snd c)))) (fst (snd c)) scrutTy level))
let conEntry = fn (ms env e name bind at scrutTy scrutAt level)
	match e
		ECtor c -> (conCtor ms env c name bind at scrutTy scrutAt level)
		_ -> ⟨0 ⟨(withSt ms (addErr (msSt ms) (posMsg at (cat name " is not a constructor")))) env⟩⟩
let conPat = fn (ms env name bind at scrutTy scrutAt level)
	match (findE env name)
		Found e -> (conEntry ms env e name bind at scrutTy scrutAt level)
		Missing -> ⟨0 ⟨(withSt ms (addErr (msSt ms) (posMsg at (cat name " is not a constructor")))) env⟩⟩
let armPat = fn (ms env pat scrutTy scrutAt level)
	match pat
		PCon p -> (conPat ms env (fst p) (fst (snd p)) (snd (snd p)) scrutTy scrutAt level)
		PBind p -> ⟨1 ⟨(withCatch ms) (envCons env ⟨(fst p) (EVar (Scheme ⟨~ scrutTy⟩))⟩)⟩⟩
		PWild p -> ⟨1 ⟨(withCatch ms) env⟩⟩
		PRec p -> (recPat ms env p scrutTy scrutAt level)
let armBody = fn (inf ms env body resTy level)
	let r = (inf (msSt ms) env body level)
	let s2 = (unifyAt (snd r) (atOfE body) (fst r) resTy)
	(if (= (grew (snd r) s2) 1) ⟨0 (withSt ms s2)⟩ ⟨1 (withSt ms s2)⟩)
letrec armsLoop = fn (inf ms env arms resTy scrutTy scrutAt level)
	if (= (@ arms) 1)
		⟨1 ms⟩
	else
		let arm = (hdOr arms ⟨(PWild ⟨0 0⟩) ⟨(ENil ⟨0 0⟩) ⟨0 0⟩⟩⟩)
		let pat = (fst arm)
		let body = (fst (snd arm))
		let aAt = (snd (snd arm))
		if (= (msCatch ms) 1)
			⟨0 (withSt ms (addErr (msSt ms) (posMsg aAt "an arm after a catch-all arm is unreachable")))⟩
		else
			let pr = (armPat ms env pat scrutTy scrutAt level)
			if (= (fst pr) 0)
				⟨0 (fst (snd pr))⟩
			else
				let br = (armBody inf (fst (snd pr)) (snd (snd pr)) body resTy level)
				(if (= (fst br) 0) ⟨0 (snd br)⟩ (armsLoop inf (snd br) env (tl arms) resTy scrutTy scrutAt level))
let sumCtorsEntry = fn e
	match e
		ESum s -> (snd (snd s))
		_ -> ~
let sumCtorsOf = fn (env name)
	match (findE env (cat "#" name))
		Found e -> (sumCtorsEntry e)
		Missing -> ~
let inferMatchWith = fn (inf st env p level)
	let rs = (inf st env (fst p) level)
	let rr = (fresh (snd rs) level)
	let r = (armsLoop inf (mkMS (snd rr) 0 "Result" (TVar 0) ~ ~ 0) env (fst (snd p)) (fst rr) (fst rs) (atOfE (fst p)) level)
	if (= (fst r) 0)
		(fresh (msSt (snd r)) level)
	elseif (= (msCatch (snd r)) 1)
		⟨(fst rr) (msSt (snd r))⟩
	else
		let missing = (missingNames (sumCtorsOf env (msName (snd r))) (msCov (snd r)))
		(if (= (@ missing) 1) ⟨(fst rr) (msSt (snd r))⟩ (fresh (addErr (msSt (snd r)) (posMsg (snd (snd p)) (cat "match does not cover " (joinNames missing)))) level))
letrec infer = fn (st env node level)
	letrec inferItems = fn (st0 items item)
		if (= (@ items) 1)
			⟨1 st0⟩
		else
			let x = (hdOr items (ENil ⟨0 0⟩))
			let r = (infer st0 env x level)
			let s1 = (unifyAt (snd r) (atOfE x) (fst r) item)
			(if (= (grew (snd r) s1) 1) ⟨0 s1⟩ (inferItems s1 (tl items) item))
	letrec appArgs = fn (st0 cur args at)
		if (= (@ args) 1)
			⟨1 ⟨cur st0⟩⟩
		else
			let x = (hdOr args (ENil ⟨0 0⟩))
			let r = (infer st0 env x level)
			let p1 = (fresh (snd r) level)
			let p2 = (fresh (snd p1) level)
			let s1 = (unifyAt (snd p2) at cur (tArrow (fst p1) (fst p2)))
			if (= (grew (snd p2) s1) 1)
				⟨0 ⟨cur s1⟩⟩
			else
				let s2 = (unifyAt s1 (atOfE x) (fst r) (fst p1))
				(if (= (grew s1 s2) 1) ⟨0 ⟨(fst p2) s2⟩⟩ (appArgs s2 (fst p2) (tl args) at))
	letrec inferFn = fn (st0 envF names body)
		if (= (@ names) 1)
			let rr = (fresh st0 level)
			let rb = (infer (snd rr) (envCons envF ⟨"#ret" (EVar (Scheme ⟨~ (fst rr)⟩))⟩) body level)
			let s1 = (unifyAt (snd rb) (atOfE body) (fst rb) (fst rr))
			(if (= (grew (snd rb) s1) 1) ⟨0 ⟨(fst rr) s1⟩⟩ ⟨1 ⟨(fst rr) s1⟩⟩)
		else
			let p = (fresh st0 level)
			let envF2 = (envCons envF ⟨(hdOr names ~) (EVar (Scheme ⟨~ (fst p)⟩))⟩)
			let rest = (inferFn (snd p) envF2 (tl names) body)
			⟨(fst rest) ⟨(tArrow (fst p) (fst (snd rest))) (snd (snd rest))⟩⟩
	letrec bindVars = fn (st0 envB bs)
		if (= (@ bs) 1)
			⟨st0 ⟨envB ~⟩⟩
		else
			let f = (fresh st0 (+ level 1))
			let rest = (bindVars (snd f) (envCons envB ⟨(fst (hdOr bs ⟨~ ⟨(ENil ⟨0 0⟩) ⟨0 0⟩⟩⟩)) (EVar (Scheme ⟨~ (fst f)⟩))⟩) (tl bs))
			⟨(fst rest) ⟨(fst (snd rest)) (cons (fst f) (snd (snd rest)))⟩⟩
	letrec inferBinds = fn (st0 envI bs vs)
		if (= (@ bs) 1)
			st0
		else
			let b = (hdOr bs ⟨~ ⟨(ENil ⟨0 0⟩) ⟨0 0⟩⟩⟩)
			let v = (infer st0 envI (fst (snd b)) (+ level 1))
			let s2 = (unifyAt (snd v) (snd (snd b)) (fst v) (hdOr vs (TVar 0)))
			inferBinds s2 envI (tl bs) (tl vs)
	letrec bindEnv = fn (sx envB bs vs)
		if (= (@ bs) 1)
			envB
		else
			bindEnv sx (envCons envB ⟨(fst (hdOr bs ⟨~ ⟨(ENil ⟨0 0⟩) ⟨0 0⟩⟩⟩)) (EVar (generalize sx level (hdOr vs (TVar 0))))⟩) (tl bs) (tl vs)
	match node
		EInt p -> ⟨tInt st⟩
		EStr p -> ⟨(tList tInt) st⟩
		ENil p ->
			let fr = (fresh st level)
			⟨(tList (fst fr)) (snd fr)⟩
		EName p -> (lookupName st env p level)
		EList p ->
			let item = (fresh st level)
			let r = (inferItems (snd item) (fst p) (fst item))
			(if (= (fst r) 1) ⟨(tList (fst item)) (snd r)⟩ (fresh (snd r) level))
		EPair p ->
			let ra = (infer st env (fst p) level)
			let rb = (infer (snd ra) env (fst (snd p)) level)
			⟨(tPair (fst ra) (fst rb)) (snd rb)⟩
		EApp p ->
			let rf = (infer st env (fst p) level)
			let r = (appArgs (snd rf) (fst rf) (fst (snd p)) (snd (snd p)))
			(if (= (fst r) 1) (snd r) (fresh (snd (snd r)) level))
		EFn p ->
			let r = (inferFn st env (fst p) (fst (snd p)))
			(if (= (fst r) 1) (snd r) (fresh (snd (snd r)) level))
		ELet p ->
			if (= (fst (snd (snd (snd p)))) 1)
				let f = (fresh st (+ level 1))
				let recEnv = (envCons env ⟨(fst p) (EVar (Scheme ⟨~ (fst f)⟩))⟩)
				let v = (infer (snd f) recEnv (fst (snd p)) (+ level 1))
				let s2 = (unifyAt (snd v) (atOfE (fst (snd p))) (fst v) (fst f))
				if (= (grew (snd v) s2) 1)
					(fresh s2 level)
				else
					let env2 = (envCons env ⟨(fst p) (EVar (generalize s2 level (fst f)))⟩)
					(infer s2 env2 (fst (snd (snd p))) level)
			else
				let v = (infer st env (fst (snd p)) (+ level 1))
				let env2 = (envCons env ⟨(fst p) (EVar (generalize (snd v) level (fst v)))⟩)
				(infer (snd v) env2 (fst (snd (snd p))) level)
		EMutual p ->
			let bv = (bindVars st env (fst p))
			let st2 = (inferBinds (fst bv) (fst (snd bv)) (fst p) (snd (snd bv)))
			(infer st2 (bindEnv st2 env (fst p) (snd (snd bv))) (fst (snd p)) level)
		EIf p ->
			let rc = (infer st env (fst p) level)
			let rt = (infer (snd rc) env (fst (snd p)) level)
			let re = (infer (snd rt) env (fst (snd (snd p))) level)
			let s1 = (unifyAt (snd re) (atOfE (fst p)) (fst rc) tInt)
			if (= (grew (snd re) s1) 1)
				(fresh s1 level)
			else
				let s2 = (unifyAt s1 (atOfE (fst (snd (snd p)))) (fst re) (fst rt))
				(if (= (grew s1 s2) 1) (fresh s2 level) ⟨(fst rt) s2⟩)
		EMatch p -> (inferMatchWith infer st env p level)
		ETry p ->
			let rt = (infer st env (fst p) level)
			let okT = (fresh (snd rt) level)
			let errT = (fresh (snd okT) level)
			let s1 = (unifyAt (snd errT) (atOfE (fst p)) (fst rt) (tRes (fst okT) (fst errT)))
			if (= (grew (snd errT) s1) 1)
				(fresh s1 level)
			else
				let rr = (fresh s1 level)
				let s2 = (unifyAt (snd rr) (snd p) (tRes (fst rr) (fst errT)) (retOf env))
				(if (= (grew (snd rr) s2) 1) (fresh s2 level) ⟨(fst okT) s2⟩)
		ECheck p ->
			let r = (infer st env (fst p) level)
			let t = (fresh (snd r) (- 0 1))
			⟨(tRes (fst t) (tList tInt)) (addPend (snd t) (atOfE node) (fst t))⟩
		EUntyped p ->
			let r = (infer st env (fst p) level)
			⟨tDyn (snd r)⟩
		ERec p -> (recLit infer st env p level)
		EWith p -> (withE infer st env p level)
		_ ->
			let fr = (fresh st level)
			⟨(fst fr) (addErr (snd fr) (posMsg (atOfE node) "this form is not checked yet"))⟩
let tvarId = fn t
	match t
		TVar i -> i
		TCon p -> 0
letrec idsOf = fn l
	(if (= (@ l) 1) ~ (cons (tvarId (hdOr l (TVar 0))) (idsOf (tl l))))
let isNoType = fn t
	match t
		NoType -> 1
		_ -> 0
let findIs = fn (env key)
	match (findE env key)
		Found e -> 1
		Missing -> 0
letrec ctorItems = fn (cs k)
	(if (= (@ cs) 1) ~ (cons ⟨(fst (hdOr cs ⟨~ ⟨NoType ⟨0 0⟩⟩⟩)) ⟨k (- 1 (isNoType (fst (snd (hdOr cs ⟨~ ⟨NoType ⟨0 0⟩⟩⟩)))))⟩⟩ (ctorItems (tl cs) (+ k 1))))
letrec zipNM = fn (names ids)
	(if (= (@ names) 1) ~ (cons ⟨(hdOr names ~) (TVar (first ids))⟩ (zipNM (tl names) (tl ids))))
letrec pmFind = fn (pm name)
	(if (= (@ pm) 1) ⟨0 (TVar 0)⟩ (if (same (fst (hdOr pm ⟨~ (TVar 0)⟩)) name) ⟨1 (snd (hdOr pm ⟨~ (TVar 0)⟩))⟩ (pmFind (tl pm) name)))
let isCapB = fn w
	(if (< (first w) 65) 0 (if (< 90 (first w)) 0 1))
let sumArity = fn (ids name at args)
	(if (= (lenOf ids) (lenOf args)) (Ok (TCon ⟨name args⟩)) (Err (posMsg at (cat name (cat " takes " (cat (showNat (lenOf ids)) (cat " types, but is given " (showNat (lenOf args)))))))))
let sumApplyEntry = fn (e name at args)
	match e
		ESum s -> (sumArity (fst (snd s)) name at args)
		_ -> (Err (posMsg at (cat name " is not a type")))
let sumApplied = fn (env name at args)
	match (findE env (cat "#" name))
		Found e -> (sumApplyEntry e name at args)
		Missing -> (Err (posMsg at (cat name " is not a type")))
let convName = fn (env pm name at)
	if (isCapB name)
		(if (same name "Int") (Ok tInt) (sumApplied env name at ~))
	else
		let f = (pmFind pm name)
		(if (= (fst f) 1) (Ok (snd f)) (Err (posMsg at (cat name " is not a type variable of this declaration"))))
letrec convArgs = fn (conv env pm args)
	if (= (@ args) 1)
		(Ok ~)
	else
		match (conv env pm (hdOr args NoType))
			Err e -> (Err e)
			Ok a ->
				match (convArgs conv env pm (tl args))
					Err e -> (Err e)
					Ok more -> (Ok (cons a more))
let convApp = fn (conv env pm p)
	match (convArgs conv env pm (fst (snd p)))
		Err e -> (Err e)
		Ok args -> (sumApplied env (fst p) (snd (snd p)) args)
let convPair = fn (conv env pm p)
	match (conv env pm (fst p))
		Err e -> (Err e)
		Ok a ->
			match (conv env pm (fst (snd p)))
				Err e -> (Err e)
				Ok b -> (Ok (tPair a b))
let convFunT = fn (conv env pm p)
	match (conv env pm (fst p))
		Err e -> (Err e)
		Ok a ->
			match (conv env pm (fst (snd p)))
				Err e -> (Err e)
				Ok b -> (Ok (tArrow a b))
let convListT = fn (conv env pm item)
	match (conv env pm item)
		Err e -> (Err e)
		Ok a -> (Ok (tList a))
letrec convType = fn (env pm t)
	match t
		TName p -> (convName env pm (fst p) (snd p))
		TApp p -> (convApp convType env pm p)
		TPair p -> (convPair convType env pm p)
		TList p -> (convListT convType env pm (fst p))
		TFun p -> (convFunT convType env pm p)
		NoType -> (Ok (TVar 0))
		TRec fs -> (Err "a record is not a type")
letrec convFields = fn (env pm fs)
	if (= (@ fs) 1)
		(Ok ~)
	else
		let f = (hdOr fs ⟨~ ⟨NoType ⟨0 0⟩⟩⟩)
		if (findIs env (fst f))
			(Err (posMsg (snd (snd f)) (cat (fst f) " is already declared")))
		else
			let ty = ((convType env pm (fst (snd f)))?)
			let more = ((convFields env pm (tl fs))?)
			(Ok (cons ty more))
letrec addAccessors = fn (env cname sumN ids names tys j n)
	if (= (@ names) 1)
		env
	else
		let fieldTy = (hdOr tys (TVar 0))
		let sch = (Scheme ⟨ids (tArrow (TCon ⟨sumN (varsOf ids)⟩) fieldTy)⟩)
		(addAccessors (envCons (envCons env ⟨(hdOr names ~) (EVar sch)⟩) ⟨(cat "@" (hdOr names ~)) (EAcc ⟨cname ⟨j n⟩⟩)⟩) cname sumN ids (tl names) (tl tys) (+ j 1) n)
let recEnv = fn (env pm cname fs k sumN ids)
	let tys = ((convFields env pm fs)?)
	let names = (fieldNames fs)
	let pay = (payloadOfT tys)
	let env1 = (envCons env ⟨cname (ERecC ⟨sumN ⟨ids ⟨k ⟨names pay⟩⟩⟩⟩)⟩)
	(Ok (addAccessors env1 cname sumN ids names tys 1 (lenOf names)))
letrec prepSums = fn (st env ds)
	if (= (@ ds) 1)
		(Ok ⟨st ⟨env ~⟩⟩)
	else
		let d = (hdOr ds ⟨~ ⟨~ ⟨~ ⟨0 0⟩⟩⟩⟩)
		let name = (fst d)
		if (if (same name "Int") 1 (findIs env (cat "#" name)))
			(Err (posMsg (snd (snd (snd d))) (cat name " is already declared")))
		else
			let fr = (freshN st (lenOf (fst (snd d))) (- 0 1))
			let ids = (idsOf (fst fr))
			let env2 = (envCons env ⟨(cat "#" name) (ESum ⟨name ⟨ids (ctorItems (fst (snd (snd d))) 0)⟩⟩)⟩)
			let more = ((prepSums (snd fr) env2 (tl ds))?)
			(Ok ⟨(fst more) ⟨(fst (snd more)) (cons ⟨d ids⟩ (snd (snd more)))⟩⟩)
letrec conPass = fn (st env cs k pm sumN ids)
	if (= (@ cs) 1)
		(Ok ⟨st env⟩)
	else
		let c = (hdOr cs ⟨~ ⟨NoType ⟨0 0⟩⟩⟩)
		let cname = (fst c)
		let pay = (fst (snd c))
		let at = (snd (snd c))
		if (findIs env cname)
			(Err (posMsg at (cat cname " is already declared")))
		elseif (= (isNoType pay) 1)
			(conPass st (envCons env ⟨cname (ECtor ⟨sumN ⟨ids ⟨k ⟨0 (TVar 0)⟩⟩⟩⟩)⟩) (tl cs) (+ k 1) pm sumN ids)
		elseif (= (isRecT pay) 1)
			let ne = ((recEnv env pm cname (recFieldsOf pay) k sumN ids)?)
			(conPass st ne (tl cs) (+ k 1) pm sumN ids)
		else
			let ty = ((convType env pm pay)?)
			(conPass st (envCons env ⟨cname (ECtor ⟨sumN ⟨ids ⟨k ⟨1 ty⟩⟩⟩⟩)⟩) (tl cs) (+ k 1) pm sumN ids)
letrec ctorsPass = fn (st env infos)
	if (= (@ infos) 1)
		(Ok ⟨st env⟩)
	else
		let inf = (hdOr infos ⟨⟨~ ⟨~ ⟨~ ⟨0 0⟩⟩⟩⟩ ~⟩)
		let d = (fst inf)
		let pm = (zipNM (fst (snd d)) (snd inf))
		let r = ((conPass st env (fst (snd (snd d))) 0 pm (fst d) (snd inf))?)
		(ctorsPass (fst r) (snd r) (tl infos))
let declareAll = fn (st env ds)
	let p = ((prepSums st env ds)?)
	(ctorsPass (fst p) (fst (snd p)) (snd (snd p)))
let inferBody = fn (st env ex)
	let rv = (fresh st 0)
	let r = (infer (snd rv) (envCons env ⟨"#ret" (EVar (Scheme ⟨~ (fst rv)⟩))⟩) ex 0)
	let st1 = (snd r)
	if (= (badProgram (bindsOf st1) (fst r)) 1)
		let st3 = (addErr st1 (posMsg (atOfE ex) (cat "the program must be a function of its input, but it is " (render (bindsOf st1) (fst r)))))
		⟨(render (bindsOf st3) (fst r)) (errsOf st3)⟩
	else
		let inp = (fresh st1 0)
		let outp = (fresh (snd inp) 0)
		let st2 = (unifyAt (snd outp) (atOfE ex) (fst r) (tArrow (fst inp) (fst outp)))
		⟨(render (bindsOf st2) (fst r)) (errsOf st2)⟩
let inferProgram = fn prog
	match (declareAll (mkSt 1000 TEmpty ~) builtinEnv (fst prog))
		Err msg -> ⟨"" (cons msg ~)⟩
		Ok d -> (inferBody (fst d) (snd d) (snd prog))
; Imports (Req InferI). Each import is a library program, which is inferred and generalised here, so its scheme is a value of this checker, not text. Its type variables are resolved (zonk) before it leaves its own state, since the state is not kept. Each library has its own range of variable ids, from 1000 * k, and the program starts above all of them, so the ids of an imported scheme never meet the program's bindings.
letrec appendE = fn (a b)
	(if (= (@ a) 1) b (cons (hdOr a ~) (appendE (tl a) b)))
letrec zonk = fn (bs t)
	letrec zargs = fn args
		(if (= (@ args) 1) ~ (cons (zonk bs (hdOr args (TVar 0))) (zargs (tl args))))
	match (prune bs t)
		TVar y -> (TVar y)
		TCon p -> (TCon ⟨(fst p) (zargs (snd p))⟩)
let schemeBody = fn (st env ex)
	let rv = (fresh st 0)
	let r = (infer (snd rv) (envCons env ⟨"#ret" (EVar (Scheme ⟨~ (fst rv)⟩))⟩) ex 0)
	let st1 = (snd r)
	if (= (badProgram (bindsOf st1) (fst r)) 1)
		let st3 = (addErr st1 (posMsg (atOfE ex) (cat "the program must be a function of its input, but it is " (render (bindsOf st1) (fst r)))))
		⟨(Scheme ⟨~ (TVar 0)⟩) (errsOf st3)⟩
	else
		let inp = (fresh st1 0)
		let outp = (fresh (snd inp) 0)
		let st2 = (unifyAt (snd outp) (atOfE ex) (fst r) (tArrow (fst inp) (fst outp)))
		let bs = (bindsOf st2)
		⟨(Scheme ⟨(freeAbove bs (- 0 1) (fst r) ~) (zonk bs (fst r))⟩) (errsOf st2)⟩
let schemeProgram = fn (base prog)
	match (declareAll (mkSt base TEmpty ~) builtinEnv (fst prog))
		Err msg -> ⟨(Scheme ⟨~ (TVar 0)⟩) (cons msg ~)⟩
		Ok d -> (schemeBody (fst d) (snd d) (snd prog))
letrec importsOf = fn (imps k env errs)
	if (= (@ imps) 1)
		⟨env errs⟩
	else
		let imp = (hdOr imps ⟨~ ⟨~ (ENil ⟨0 0⟩)⟩⟩)
		let r = (schemeProgram (* k 1000) (snd imp))
		(importsOf (tl imps) (+ k 1) (envCons env ⟨(fst imp) (EVar (fst r))⟩) (appendE errs (snd r)))
let inferWithEnv = fn (base env prog)
	match (declareAll (mkSt base TEmpty ~) env (fst prog))
		Err msg -> ⟨"" (cons msg ~)⟩
		Ok d -> (inferBody (fst d) (snd d) (snd prog))
let inferProgramI = fn (imps prog)
	let ie = (importsOf imps 1 builtinEnv ~)
	if (= (@ (snd ie)) 1)
		(inferWithEnv (+ (* (lenOf imps) 1000) 1000) (fst ie) prog)
	else
		⟨"" (snd ie)⟩
letrec memberB = fn (k l)
	(if (= (@ l) 1) 0 (if (same (hdOr l ~) k) 1 (memberB k (tl l))))
let sumIdsOf = fn e
	match e
		ESum s -> (fst (snd s))
		_ -> ~
let ctorTyOf = fn e
	match e
		ECtor p -> (snd (snd (snd (snd p))))
		ERecC p -> (snd (snd (snd (snd p))))
		_ -> (TVar 0)
; THE TESTS OF THE CHECKER: the describer of a type, as the Luau checker's describe gives it. The stack holds the keys of the types being described; a recursive reference adds its key to used, and a type whose key is in used when it is done is wrapped in KFixdef.
let describeTop = fn (bs env t)
	letrec
		describeGo = fn (bs env stack used t)
			match (prune bs t)
				TVar y -> ⟨KAny used⟩
				TCon p -> (describeCon bs env stack used (fst p) (snd p))
		describeCon = fn (bs env stack used name args)
			(if (same name "Dyn") ⟨KAny used⟩ (describeCon2 bs env stack used name args))
		describeCon2 = fn (bs env stack used name args)
			(if (same name "Int") ⟨KInt used⟩ (describeCon3 bs env stack used name args))
		describeCon3 = fn (bs env stack used name args)
			(if (same name "->") ⟨KFn used⟩ (describeCon4 bs env stack used name args))
		describeCon4 = fn (bs env stack used name args)
			(if (same name "Pin") ⟨KPin used⟩ (describeCon5 bs env stack used name args))
		describeCon5 = fn (bs env stack used name args)
			(if (same name "pair") (describePair bs env stack used args) (describeNamed bs env stack used name args))
		describePair = fn (bs env stack used args)
			let ta = (describeGo bs env stack used (hdOr args (TVar 0)))
			let tb = (describeGo bs env stack (snd ta) (hdOr (tl args) (TVar 0)))
			⟨(KPair ⟨(fst ta) (fst tb)⟩) (snd tb)⟩
		describeNamed = fn (bs env stack used name args)
			let key = (render bs (TCon ⟨name args⟩))
			if (= (memberB key stack) 1)
				⟨(KRec key) (addB key used)⟩
			else
				let body = (describeBody bs env (cons key stack) used name args)
				if (= (memberB key (snd body)) 1)
					⟨(KFixdef ⟨key (fst body)⟩) (snd body)⟩
				else
					body
		addB = fn (k l)
			(if (= (memberB k l) 1) l (cons k l))
		describeBody = fn (bs env stack used name args)
			(if (same name "list") (describeList bs env stack used name args) (describeSum bs env stack used name args))
		describeList = fn (bs env stack used name args)
			let item = (describeGo bs env stack used (hdOr args (TVar 0)))
			let rest = (describeGo bs env stack (snd item) (TCon ⟨name args⟩))
			⟨(KList ⟨(fst item) (fst rest)⟩) (snd rest)⟩
		describeSum = fn (bs env stack used name args)
			match (findE env (cat "#" name))
				Found e -> (describeSumOk bs env stack used e args)
				Missing -> ⟨KAny used⟩
		describeSumOk = fn (bs env stack used e args)
			let m = (zipM (sumIdsOf e) args)
			let cs = (describeCtors bs env (sumCtorsEntry e) m stack used)
			⟨(KSum (fst cs)) (snd cs)⟩
		describeCtors = fn (bs env cs m stack used)
			if (= (@ cs) 1)
				⟨~ used⟩
			else
				let c = (hdOr cs ⟨~ ⟨0 0⟩⟩)
				let pay = (ctorPayTest bs env stack used c m)
				let rest = (describeCtors bs env (tl cs) m stack (snd pay))
				⟨(cons ⟨(fst (snd c)) (fst pay)⟩ (fst rest)) (snd rest)⟩
		ctorPayTest = fn (bs env stack used c m)
			(if (= (snd (snd c)) 1) (ctorPayOf bs env stack used (fst c) m) ⟨KNil used⟩)
		ctorPayOf = fn (bs env stack used cname m)
			match (findE env cname)
				Found e -> (describeGo bs env stack used (subst bs m (ctorTyOf e)))
				Missing -> ⟨KNil used⟩
	(fst (describeGo bs env ~ ~ t))
; The type variables of a text, numbered from 1 by where they first appear: the same numbering as the host checker's, so the expected type of a check reads the same on both. A variable is a question mark and its id; the id's digits are the key.
let canonIsDigit = fn c
	(if (< 47 c) (if (< c 58) 1 0) 0)
letrec canonDigits = fn l
	(if (= (@ l) 1) ~ (if (canonIsDigit (hdOr l 0)) (cons (hdOr l 0) (canonDigits (tl l))) ~))
letrec canonSkip = fn l
	(if (= (@ l) 1) l (if (canonIsDigit (hdOr l 0)) (canonSkip (tl l)) l))
letrec canonFind = fn (m key)
	(if (= (@ m) 1) (-1) (if (same (fst (hdOr m ⟨~ 0⟩)) key) (snd (hdOr m ⟨~ 0⟩)) (canonFind (tl m) key)))
letrec canonGo = fn (l m n out)
	if (= (@ l) 1)
		⟨out ⟨m n⟩⟩
	else
		if (= (hdOr l 0) 63)
			if (canonIsDigit (hdOr (tl l) 0))
				let key = (canonDigits (tl l))
				let found = (canonFind m key)
				if (< found 0)
					(canonGo (canonSkip (tl l)) (cons ⟨key (+ n 1)⟩ m) (+ n 1) (cat out (cons 63 (showNat (+ n 1)))))
				else
					(canonGo (canonSkip (tl l)) m n (cat out (cons 63 (showNat found))))
			else
				(canonGo (tl l) m n (cat out (cons 63 ~)))
		else
			(canonGo (tl l) m n (cat out (cons (hdOr l 0) ~)))
let canonVars = fn s
	(fst (canonGo s ~ 0 ~))
letrec checksOf = fn (bs env pend)
	if (= (@ pend) 1)
		~
	else
		let p = (hdOr pend ⟨⟨0 0⟩ (TVar 0)⟩)
		(cons ⟨(fst p) ⟨(canonVars (render bs (snd p))) (describeTop bs env (snd p))⟩⟩ (checksOf bs env (tl pend)))
let inputInfo = fn (bs env inp)
	(HasInputCheck ⟨(describeTop bs env inp) (canonVars (render bs inp))⟩)
let inferBodyT = fn (st env ex)
	let rv = (fresh st 0)
	let r = (infer (snd rv) (envCons env ⟨"#ret" (EVar (Scheme ⟨~ (fst rv)⟩))⟩) ex 0)
	let st1 = (snd r)
	if (= (badProgram (bindsOf st1) (fst r)) 1)
		let st3 = (addErr st1 (posMsg (atOfE ex) (cat "the program must be a function of its input, but it is " (render (bindsOf st1) (fst r)))))
		⟨(render (bindsOf st3) (fst r)) ⟨(errsOf st3) ⟨~ NoInputCheck⟩⟩⟩
	else
		let inp = (fresh st1 0)
		let outp = (fresh (snd inp) 0)
		let st2 = (unifyAt (snd outp) (atOfE ex) (fst r) (tArrow (fst inp) (fst outp)))
		⟨(render (bindsOf st2) (fst r)) ⟨(errsOf st2) ⟨(checksOf (bindsOf st2) env (pendOf st2)) (inputInfo (bindsOf st2) env (fst inp))⟩⟩⟩
let inferWithEnvT = fn (base env prog)
	match (declareAll (mkSt base TEmpty ~) env (fst prog))
		Err msg -> ⟨"" ⟨(cons msg ~) ⟨~ NoInputCheck⟩⟩⟩
		Ok d -> (inferBodyT (fst d) (snd d) (snd prog))
let inferProgramIT = fn (imps prog)
	let ie = (importsOf imps 1 builtinEnv ~)
	if (= (@ (snd ie)) 1)
		(inferWithEnvT (+ (* (lenOf imps) 1000) 1000) (fst ie) prog)
	else
		⟨"" ⟨(snd ie) ⟨~ NoInputCheck⟩⟩⟩
; Every request gives the same shape: the text, the errors, the checks' tests and the input's test. The requests that only need the first two give no tests, and no input check.
let padR = fn r
	⟨(fst r) ⟨(snd r) ⟨~ NoInputCheck⟩⟩⟩
fn p
	match p
		Unify q -> (padR (runUnify q))
		Gen q -> (padR (runGen q))
		Inst q -> (padR (runInst q))
		Infer ex -> (padR (inferProgram ex))
		InferI q -> (padR (inferProgramI (fst q) (snd q)))
		InferT q -> (inferProgramIT (fst q) (snd q))
---
Unify ⟨(TCon ⟨"Int" ~⟩) (TCon ⟨"Int" ~⟩)⟩ => ⟨"Int" ⟨~ ⟨~ NoInputCheck⟩⟩⟩ fuel 1000000
Unify ⟨(TCon ⟨"Int" ~⟩) (TCon ⟨"list" [(TCon ⟨"Int" ~⟩)]⟩)⟩ => ⟨"Int" ⟨["expected [Int], but this is Int"] ⟨~ NoInputCheck⟩⟩⟩ fuel 1000000
Unify ⟨(TVar 1) (TCon ⟨"Int" ~⟩)⟩ => ⟨"Int" ⟨~ ⟨~ NoInputCheck⟩⟩⟩ fuel 1000000
Unify ⟨(TVar 1) (TVar 2)⟩ => ⟨"?2" ⟨~ ⟨~ NoInputCheck⟩⟩⟩ fuel 1000000
Unify ⟨(TVar 1) (TCon ⟨"list" [(TVar 1)]⟩)⟩ => ⟨"?1" ⟨["?1 would be an infinite type"] ⟨~ NoInputCheck⟩⟩⟩ fuel 1000000
Unify ⟨(TCon ⟨"Dyn" ~⟩) (TCon ⟨"Int" ~⟩)⟩ => ⟨"Dyn" ⟨["expected Int, but this is Dyn"] ⟨~ NoInputCheck⟩⟩⟩ fuel 1000000
Unify ⟨(TVar 1) (TCon ⟨"Dyn" ~⟩)⟩ => ⟨"Dyn" ⟨~ ⟨~ NoInputCheck⟩⟩⟩ fuel 1000000
Unify ⟨(TCon ⟨"pair" [(TCon ⟨"Int" ~⟩) (TCon ⟨"Int" ~⟩)]⟩) (TCon ⟨"list" [(TCon ⟨"Int" ~⟩)]⟩)⟩ => ⟨"⟨Int Int⟩" ⟨["expected [Int], but this is ⟨Int Int⟩"] ⟨~ NoInputCheck⟩⟩⟩ fuel 1000000
Unify ⟨(TCon ⟨"->" [(TCon ⟨"Int" ~⟩) (TCon ⟨"Int" ~⟩)]⟩) (TCon ⟨"->" [(TCon ⟨"Int" ~⟩) (TCon ⟨"Int" ~⟩)]⟩)⟩ => ⟨"(Int -> Int)" ⟨~ ⟨~ NoInputCheck⟩⟩⟩ fuel 1000000
Unify ⟨(TCon ⟨"->" [(TCon ⟨"Int" ~⟩) (TCon ⟨"Int" ~⟩)]⟩) (TCon ⟨"->" [(TCon ⟨"list" [(TCon ⟨"Int" ~⟩)]⟩) (TCon ⟨"list" [(TCon ⟨"Int" ~⟩)]⟩)]⟩)⟩ => ⟨"(Int -> Int)" ⟨["expected [Int], but this is Int"] ⟨~ NoInputCheck⟩⟩⟩ fuel 1000000
Unify ⟨(TCon ⟨"Option" [(TCon ⟨"Int" ~⟩)]⟩) (TCon ⟨"Option" [(TVar 3)]⟩)⟩ => ⟨"Option Int" ⟨~ ⟨~ NoInputCheck⟩⟩⟩ fuel 1000000
Gen ⟨-1 (TVar 1)⟩ => ⟨"forall ?1. ?1" ⟨~ ⟨~ NoInputCheck⟩⟩⟩ fuel 1000000
Gen ⟨-1 (TCon ⟨"->" [(TVar 1) (TVar 2)]⟩)⟩ => ⟨"forall ?1 ?2. (?1 -> ?2)" ⟨~ ⟨~ NoInputCheck⟩⟩⟩ fuel 1000000
Gen ⟨-1 (TCon ⟨"Int" ~⟩)⟩ => ⟨"Int" ⟨~ ⟨~ NoInputCheck⟩⟩⟩ fuel 1000000
Gen ⟨0 (TVar 1)⟩ => ⟨"?1" ⟨~ ⟨~ NoInputCheck⟩⟩⟩ fuel 1000000
Inst ⟨0 (Scheme ⟨[1] (TCon ⟨"->" [(TVar 1) (TVar 1)]⟩)⟩)⟩ => ⟨"(?1000 -> ?1000)" ⟨~ ⟨~ NoInputCheck⟩⟩⟩ fuel 1000000
Inst ⟨0 (Scheme ⟨[1 2] (TCon ⟨"->" [(TVar 1) (TVar 2)]⟩)⟩)⟩ => ⟨"(?1000 -> ?1001)" ⟨~ ⟨~ NoInputCheck⟩⟩⟩ fuel 1000000
Inst ⟨0 (Scheme ⟨[] (TVar 5)⟩)⟩ => ⟨"?5" ⟨~ ⟨~ NoInputCheck⟩⟩⟩ fuel 1000000
Inst ⟨0 (Scheme ⟨[1] (TCon ⟨"list" [(TVar 1)]⟩)⟩)⟩ => ⟨"[?1000]" ⟨~ ⟨~ NoInputCheck⟩⟩⟩ fuel 1000000

