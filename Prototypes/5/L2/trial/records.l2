; The record helpers of types.prog, written with indentation (the trial of INDENTATION.md). The same code as records.prog.
; A record literal with its fields checked, and the field values.
let recLit = fn (inf st env node level)
	let name = fst node
	let inits = fst (snd node)
	let at = snd (snd node)
	let ro = recOf env name
	if (= (fst ro) 0)
		let fr = fresh st level
		((fst fr) . (addErr (snd fr) (posMsg at (cat name " is not a record"))))
	else
		let r = snd ro
		let sumN = fst r
		let ids = fst (snd r)
		let names = fst (snd (snd (snd r)))
		let pay = snd (snd (snd (snd r)))
		let inst = instMap st level ~ ids
		let st1 = fst inst
		let m = snd inst
		let payT = subst (bindsOf st1) m pay
		let sumT = subst (bindsOf st1) m (TCon (sumN . (varsOf ids)))
		let bad = firstBadInit name names inits ~ 0
		if (= (fst bad) 1)
			fresh (addErr st1 (posMsg (fst (snd bad)) (snd (snd bad)))) level
		else
			let mis = firstMissing names inits
			if (= (fst mis) 1)
				fresh (addErr st1 (posMsg at (cat name (cat " needs the field " (snd mis))))) level
			else
				let fl = litVals inf st1 env level names inits payT 1 (lenOf names)
				if (= (fst fl) 0)
					fresh (snd fl) level
				else
					(sumT . (snd fl))
; The field values of a with, in the order they are given, each unified with its field's type.
letrec withVals = fn (inf st env level names inits payT n)
	if (= (@ inits) 1)
		(1 . st)
	else
		let init = hdOr inits (~ . ((ENil (0 . 0)) . (0 . 0)))
		let fty = fieldAtT payT (nameIndex (fst init) names 1) n
		let r = inf st env (fst (snd init)) level
		let s1 = unifyAt (snd r) (atOfE (fst (snd init))) (fst r) fty
		if (= (grew (snd r) s1) 1)
			(0 . s1)
		else
			withVals inf s1 env level names (tl inits) payT n
; A record with some fields changed. The record is found by its first field, which is an accessor of one record. The base has the record's type.
let withE = fn (inf st env node level)
	let base = fst node
	let inits = fst (snd node)
	let at = snd (snd node)
	let ao = accOf env (fst (hdOr inits (~ . ((ENil (0 . 0)) . (0 . 0)))))
	if (= (fst ao) 0)
		let first = hdOr inits (~ . ((ENil (0 . 0)) . (0 . 0)))
		let fr = fresh st level
		((fst fr) . (addErr (snd fr) (posMsg (snd (snd first)) (cat (fst first) " is not a field of a record"))))
	else
		let recName = fst (snd ao)
		let ro = recOf env recName
		let r = snd ro
		let ids = fst (snd r)
		let names = fst (snd (snd (snd r)))
		let pay = snd (snd (snd (snd r)))
		let inst = instMap st level ~ ids
		let st1 = fst inst
		let m = snd inst
		let payT = subst (bindsOf st1) m pay
		let sumT = subst (bindsOf st1) m (TCon ((fst r) . (varsOf ids)))
		let br = inf st1 env base level
		let s2 = unifyAt (snd br) (atOfE base) (fst br) sumT
		if (= (grew (snd br) s2) 1)
			fresh s2 level
		else
			let bad = firstBadInit recName names inits ~ 1
			if (= (fst bad) 1)
				fresh (addErr s2 (posMsg (fst (snd bad)) (snd (snd bad)))) level
			else
				let vs = withVals inf s2 env level names inits payT (lenOf names)
				if (= (fst vs) 0)
					fresh (snd vs) level
				else
					(sumT . (snd vs))
; A record pattern. The first constructor fixes the sum, as a constructor pattern does.
letrec recMissing = fn (ms env seen names name at)
	if (= (@ names) 1)
		(1 . (ms . env))
	else
		if (= (nameIn (hdOr names ~) seen) 1)
			recMissing ms env seen (tl names) name at
		else
			(0 . ((withSt ms (addErr (msSt ms) (posMsg at (cat name (cat " needs the field " (hdOr names ~)))))) . env))
letrec recPats = fn (ms env seen pats names pt name at)
	if (= (@ pats) 1)
		recMissing ms env seen names name at
	else
		let pf = hdOr pats (~ . (~ . (0 . 0)))
		let fname = fst pf
		let j = nameIndex fname names 1
		if (= j 0)
			(0 . ((withSt ms (addErr (msSt ms) (posMsg (snd (snd pf)) (cat name (cat " has no field " fname))))) . env))
		else
			if (= (nameIn fname seen) 1)
				(0 . ((withSt ms (addErr (msSt ms) (posMsg (snd (snd pf)) (cat fname " is given twice")))) . env))
			else
				let env2 = (if (= (@ (fst (snd pf))) 1) env (cons ((fst (snd pf)) . (EVar (Scheme (~ . (fieldAtT pt j (lenOf names)))))) env))
				recPats ms env2 (cons fname seen) (tl pats) names pt name at
let recBind = fn (ms env pats names ids pay tag name at)
	let ms1 = mkMS (msSt ms) (msFixed ms) (msName ms) (msTy ms) (msArgs ms) (cons tag (msCov ms)) (msCatch ms)
	let pt = subst (bindsOf (msSt ms1)) (zipM ids (msArgs ms1)) pay
	recPats ms1 env ~ pats names pt name at
let recPat = fn (ms env p scrutTy scrutAt level)
	let name = fst p
	let pats = fst (snd p)
	let at = snd (snd p)
	let ro = recOf env name
	if (= (fst ro) 0)
		(0 . ((withSt ms (addErr (msSt ms) (posMsg at (cat name " is not a record")))) . env))
	else
		let r = snd ro
		let sumN = fst r
		let ids = fst (snd r)
		let tag = fst (snd (snd r))
		let names = fst (snd (snd (snd r)))
		let pay = snd (snd (snd (snd r)))
		if (= (msFixed ms) 1)
			if (same sumN (msName ms))
				recBind ms env pats names ids pay tag name at
			else
				(0 . ((withSt ms (addErr (msSt ms) (posMsg at (cat name (cat " belongs to " (cat sumN (cat ", but the match is on " (msName ms)))))))) . env))
		else
			let fr = freshN (msSt ms) (lenOf ids) level
			let sumT = TCon (sumN . (fst fr))
			let s2 = unifyAt (snd fr) scrutAt scrutTy sumT
			if (= (grew (snd fr) s2) 1)
				(0 . ((withSt ms s2) . env))
			else
				recBind (mkMS s2 1 sumN sumT (fst fr) (msCov ms) (msCatch ms)) env pats names ids pay tag name at
0
