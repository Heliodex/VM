The number of items in a list. The output is Ok of its length, since taking the tail can fail. nil has length 0.
---

---
fn xs
	letrec go = fn (l n)
		if (= (@ l) 1)
			(Ok n)
		else
			let t = ((tail l)?)
			(go t (+ n 1))
	(go xs 0)
---
~ => Ok 0 fuel 1000
[1 2 3] => Ok 3 fuel 1000
[5] => Ok 1 fuel 1000
"abc" => Ok 3 fuel 1000

