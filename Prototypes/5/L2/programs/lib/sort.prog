Sorts a list of integers, by insertion. It uses insert from lib/insert.prog, which is imported as a standard library function.
---
insert = lib/insert.prog
---
fn xs
	letrec s = (fn l
		(if (= (@ l) 1)
		(Ok ~)
		(let h = (head l)?
		let t = (tail l)?
		let r = (s t)?
		insert (h . r))))
	s xs
---
~ => Ok ~ fuel 100000
[3 1 2] => Ok [1 2 3] fuel 100000
[5 5 1] => Ok [1 5 5] fuel 100000
[-1 0 -3] => Ok [-3 -1 0] fuel 100000
