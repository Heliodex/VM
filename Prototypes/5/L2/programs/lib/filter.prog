Keeps the items of a list that a test accepts. The input is the pair (pred . xs): pred is a function of one argument that gives nonzero for an item to keep. The output is Ok of the kept items, in order.
---

---
fn p
	let pred = (fst p)
	letrec f = (fn l
		(if (= (@ l) 1)
		(Ok ~)
		(let h = (head l)?
		let t = (tail l)?
		let r = (f t)?
		if (pred h) (Ok (cons h r)) (Ok r))))
	f (snd p)
---
((fn x (< x 3)) . [1 5 2 4]) => Ok [1 2] fuel 1000
((fn x (< x 3)) . ~) => Ok ~ fuel 1000
((fn x 0) . [1 2]) => Ok ~ fuel 1000
