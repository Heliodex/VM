The first part of the L2 checker, written in L2 with no mutation. The state is a value: a counter for the next variable, the bindings of the variables, and the errors so far. A binding is a list of (id . Bind), and a new binding is consed on the front, so a lookup finds the newest. Every operation gives back the state it changes. This file holds the types, the state, and unification. A test's output is the rendered first type, with the errors, as the Luau checker writes them.
---
---
type Ty = TVar Int | TCon ([Int] . [Ty])
type Bind = Unbound Int | Bound Ty
type St = St (Int . (Tr . [[Int]]))
type Scheme = Scheme ([Int] . Ty)
type Entry = EVar Scheme | ECtor ([Int] . ([Int] . (Int . (Int . Ty)))) | ESum ([Int] . ([Int] . [([Int] . (Int . Int))]))
type Look = Found Entry | Missing
type PTy = TName ([Int] . (Int . Int)) | TApp ([Int] . ([PTy] . (Int . Int))) | TPair (PTy . (PTy . (Int . Int))) | TList (PTy . (Int . Int)) | TFun (PTy . (PTy . (Int . Int))) | NoType
type Req = Unify (Ty . Ty) | Gen (Int . Ty) | Inst (Int . Scheme) | Infer ([([Int] . ([[Int]] . ([([Int] . (PTy . (Int . Int)))] . (Int . Int))))] . Expr)
type MS = MS (St . (Int . ([Int] . (Ty . ([Ty] . ([Int] . Int))))))
type Expr = EInt (Int . (Int . Int)) | EStr ([Int] . (Int . Int)) | ENil (Int . Int) | EName ([Int] . (Int . Int)) | EList ([Expr] . (Int . Int)) | EPair (Expr . (Expr . (Int . Int))) | EApp (Expr . ([Expr] . (Int . Int))) | EFn ([[Int]] . (Expr . (Int . Int))) | ELet ([Int] . (Expr . (Expr . (Int . (Int . Int))))) | EMutual ([([Int] . (Expr . (Int . Int)))] . (Expr . (Int . Int))) | EIf (Expr . (Expr . (Expr . (Int . Int)))) | EMatch (Expr . ([(Pat . (Expr . (Int . Int)))] . (Int . Int))) | ETry (Expr . (Int . Int)) | ECheck (Expr . (Int . Int)) | EUntyped (Expr . (Int . Int))
type Tr = TEmpty | TNode (Bind . (Tr . Tr))
type Pat = PCon ([Int] . ([Int] . (Int . Int))) | PBind ([Int] . (Int . Int)) | PWild (Int . Int)

let hdOr = (fn (l dflt)
	match (head l) {
		Ok x -> x
		Err e -> dflt
	})
let first = (fn l
	match (head l) {
		Ok c -> c
		Err e -> -1
	})
let tl = (fn l
	match (tail l) {
		Ok t -> t
		Err e -> ~
	})
let div10 = (fn n
	match (/ n 10) {
		Ok q -> q
		Err e -> 0
	})
let mod10 = (fn n
	match (% n 10) {
		Ok r -> r
		Err e -> 0
	})
letrec same = (fn (a b)
	(if (= (@ a) 1)
		(= (@ b) 1)
		(if (= (@ b) 1)
			0
			(if (= (first a) (first b))
				(same (tl a) (tl b))
				0))))
letrec lenOf = (fn l
	(if (= (@ l) 1) 0 (+ 1 (lenOf (tl l)))))
letrec cat = (fn (a b)
	(if (= (@ a) 1)
		b
		(cons (first a) (cat (tl a) b))))
letrec showNat = (fn n
	(if (< n 10)
		(cons (+ 48 n) ~)
		(cat (showNat (div10 n)) (cons (+ 48 (mod10 n)) ~))))
let varName = (fn id
	(cat "?" (showNat id)))

let stP = (fn st
	match st {
		St p -> p
	})
let nextOf = (fn st
	(fst (stP st)))
let bindsOf = (fn st
	(fst (snd (stP st))))
let errsOf = (fn st
	(snd (snd (stP st))))
let mkSt = (fn (n bs es)
	(St (n . (bs . es))))
letrec snoc = (fn (l x)
	(if (= (@ l) 1)
		(cons x ~)
		(match (head l) {
			Ok h -> (cons h (snoc (tl l) x))
			Err e -> (cons x ~)
		})))
let addErr = (fn (st msg)
	(mkSt (nextOf st) (bindsOf st) (snoc (errsOf st) msg)))

let halfOf = (fn n
	match (/ n 2) {
		Ok q -> q
		Err e -> 0
	})
let oddOf = (fn n
	match (% n 2) {
		Ok r -> r
		Err e -> 0
	})
let pickSide = (fn (lr b)
	(if (= b 1) (snd lr) (fst lr)))
; The bindings are a binary trie on the id: the path from the root takes the bits of the id, lowest first, and the node at the end of the path holds the id's binding. A node with no binding holds Unbound 0, which is what a missing id means.
letrec findB = (fn (bs id)
	match bs {
		TEmpty -> (Unbound 0)
		TNode p -> (if (= id 0) (fst p) (findB (pickSide (snd p) (oddOf id)) (halfOf id)))
	})
letrec setB = (fn (bs id b)
	match bs {
		TEmpty -> (setB (TNode ((Unbound 0) . (TEmpty . TEmpty))) id b)
		TNode p -> (if (= id 0)
			(TNode (b . (snd p)))
			(if (= (oddOf id) 1)
				(TNode ((fst p) . ((fst (snd p)) . (setB (snd (snd p)) (halfOf id) b))))
				(TNode ((fst p) . ((setB (fst (snd p)) (halfOf id) b) . (snd (snd p)))))))
	})
let levelOf = (fn b
	match b {
		Unbound lv -> lv
		Bound t -> 0
	})
let fresh = (fn (st level)
	(let n = (nextOf st)
	((TVar n) . (mkSt (+ n 1) (setB (bindsOf st) n (Unbound level)) (errsOf st)))))

letrec prune = (fn (bs t)
	(match t {
		TVar id -> (match (findB bs id) {
			Bound u -> (prune bs u)
			Unbound lv -> t
		})
		TCon p -> t
	}))

letrec occurs = (fn (bs id t)
	(letrec all = (fn args
		(if (= (@ args) 1)
			0
			(if (occurs bs id (hdOr args (TVar 0))) 1 (all (tl args)))))
	(match (prune bs t) {
		TVar y -> (= y id)
		TCon p -> (all (snd p))
	})))

letrec lowerT = (fn (bs t level)
	(letrec lowerArgs = (fn (b args)
		(if (= (@ args) 1)
			b
			(lowerArgs (lowerT b (hdOr args (TVar 0)) level) (tl args))))
	(match (prune bs t) {
		TVar y -> (if (< level (levelOf (findB bs y))) (setB bs y (Unbound level)) bs)
		TCon p -> (lowerArgs bs (snd p))
	})))

let hasArgs = (fn (bs a)
	match (prune bs a) {
		TVar y -> 0
		TCon p -> (if (= (@ (snd p)) 1) 0 1)
	})

letrec render = (fn (bs t)
	(letrec argText = (fn a
		(if (= (hasArgs bs a) 1)
			(cat "(" (cat (render bs a) ")"))
			(render bs a)))
	(letrec argsText = (fn args
		(if (= (@ args) 1)
			~
			(cat " " (cat (argText (hdOr args (TVar 0))) (argsText (tl args))))))
	(letrec renderCon = (fn (name args)
		(if (same name "->")
			(cat "(" (cat (render bs (hdOr args (TVar 0))) (cat " -> " (cat (render bs (hdOr (tl args) (TVar 0))) ")"))))
		(if (same name "pair")
			(cat "(" (cat (render bs (hdOr args (TVar 0))) (cat " . " (cat (render bs (hdOr (tl args) (TVar 0))) ")"))))
		(if (same name "list")
			(cat "[" (cat (render bs (hdOr args (TVar 0))) "]"))
			(if (= (@ args) 1)
				name
				(cat name (argsText args)))))))
	(match (prune bs t) {
		TVar y -> (varName y)
		TCon p -> (renderCon (fst p) (snd p))
	})))))

let mismatch = (fn (st a e)
	(addErr st (cat "expected " (cat (render (bindsOf st) e) (cat ", but this is " (render (bindsOf st) a))))))

let bindVar = (fn (st id t)
	(if (occurs (bindsOf st) id t)
		(addErr st (cat (varName id) " would be an infinite type"))
		(mkSt (nextOf st) (setB (lowerT (bindsOf st) t (levelOf (findB (bindsOf st) id))) id (Bound t)) (errsOf st))))

letrec unify = (fn (st a0 e0)
	(letrec unifyArgs = (fn (st0 aa ea)
		(if (= (@ aa) 1)
			st0
			(let st1 = (unify st0 (hdOr aa (TVar 0)) (hdOr ea (TVar 0)))
			(if (< (lenOf (errsOf st0)) (lenOf (errsOf st1)))
				st1
				(unifyArgs st1 (tl aa) (tl ea))))))
	(let unifyCon = (fn (st2 na aa ne ea a e)
		(if (if (same na "Dyn") (same ne "Dyn") 0)
			st2
			(if (if (same na "Dyn") 1 (same ne "Dyn"))
				(mismatch st2 a e)
				(if (if (same na ne) (= (lenOf aa) (lenOf ea)) 0)
					(unifyArgs st2 aa ea)
					(mismatch st2 a e)))))
	(let bs = (bindsOf st)
	(let a = (prune bs a0)
	(let e = (prune bs e0)
	(match a {
		TVar x -> (match e {
			TVar y -> (if (= x y) st (bindVar st x e))
			TCon q -> (bindVar st x e)
		})
		TCon p -> (match e {
			TVar y -> (bindVar st y a)
			TCon q -> (unifyCon st (fst p) (snd p) (fst q) (snd q) a e)
		})
	})))))))

letrec memberI = (fn (x l)
	(if (= (@ l) 1)
		0
		(if (= (first l) x) 1 (memberI x (tl l)))))

letrec freeAbove = (fn (bs level t acc)
	(letrec argsFree = (fn (acc2 args)
		(if (= (@ args) 1)
			acc2
			(argsFree (freeAbove bs level (hdOr args (TVar 0)) acc2) (tl args))))
	(match (prune bs t) {
		TVar y -> (if (if (< level (levelOf (findB bs y))) (if (memberI y acc) 0 1) 0) (snoc acc y) acc)
		TCon p -> (argsFree acc (snd p))
	})))

let generalize = (fn (st level t)
	(Scheme ((freeAbove (bindsOf st) level t ~) . t)))

let schemeVars = (fn s
	match s {
		Scheme p -> (fst p)
	})
let schemeTy = (fn s
	match s {
		Scheme p -> (snd p)
	})

letrec lookupM = (fn (m id dflt)
	(if (= (@ m) 1)
		dflt
		(if (= (fst (hdOr m (0 . (TVar 0)))) id) (snd (hdOr m (0 . (TVar 0)))) (lookupM (tl m) id dflt))))

letrec subst = (fn (bs m t)
	(letrec substArgs = (fn args
		(if (= (@ args) 1)
			~
			(cons (subst bs m (hdOr args (TVar 0))) (substArgs (tl args)))))
	(match (prune bs t) {
		TVar y -> (lookupM m y (TVar y))
		TCon p -> (TCon ((fst p) . (substArgs (snd p))))
	})))

letrec instMap = (fn (st level m vars)
	(if (= (@ vars) 1)
		(st . m)
		(let fr = (fresh st level)
		(instMap (snd fr) level (cons ((first vars) . (fst fr)) m) (tl vars)))))

let instantiate = (fn (st level s)
	(let r = (instMap st level ~ (schemeVars s))
	((subst (bindsOf (fst r)) (snd r) (schemeTy s)) . (fst r))))

letrec idsText = (fn l
	(if (= (@ l) 1)
		~
		(cat (varName (first l)) (if (= (@ (tl l)) 1) ~ (cat " " (idsText (tl l)))))))

let schemeText = (fn (bs s)
	(if (= (@ (schemeVars s)) 1)
		(render bs (schemeTy s))
		(cat "forall " (cat (idsText (schemeVars s)) (cat ". " (render bs (schemeTy s)))))))

let runUnify = (fn q
	(let st = (unify (mkSt 1000 TEmpty ~) (fst q) (snd q))
	((render (bindsOf st) (fst q)) . (errsOf st))))
let runGen = (fn q
	(let st = (mkSt 1000 TEmpty ~)
	(let s = (generalize st (fst q) (snd q))
	((schemeText (bindsOf st) s) . ~))))
let runInst = (fn q
	(let st = (mkSt 1000 TEmpty ~)
	(let r = (instantiate st (fst q) (snd q))
	((render (bindsOf (snd r)) (fst r)) . (errsOf (snd r))))))

let atOfE = (fn e
	match e {
		EInt p -> (snd p)
		EStr p -> (snd p)
		ENil p -> p
		EName p -> (snd p)
		EList p -> (snd p)
		EPair p -> (snd (snd p))
		EApp p -> (snd (snd p))
		EFn p -> (snd (snd p))
		ELet p -> (snd (snd (snd (snd p))))
		EMutual p -> (snd (snd p))
		EIf p -> (snd (snd (snd p)))
		EMatch p -> (snd (snd p))
		ETry p -> (snd p)
		ECheck p -> (snd p)
		EUntyped p -> (snd p)
	})
letrec lastMsg = (fn l
	(if (= (@ (tl l)) 1)
		(hdOr l ~)
		(lastMsg (tl l))))
let posMsg = (fn (at msg)
	(cat "line " (cat (showNat (fst at)) (cat ", column " (cat (showNat (snd at)) (cat ": " msg))))))

let tInt = (TCon ("Int" . ~))
let tDyn = (TCon ("Dyn" . ~))
let tArrow = (fn (a b)
	(TCon ("->" . [a b])))
let tList = (fn a
	(TCon ("list" . [a])))
let tPair = (fn (a b)
	(TCon ("pair" . [a b])))
let tRes = (fn (a e)
	(TCon ("Result" . [a e])))
let tPin = (fn a
	(TCon ("Pin" . [a])))
let mono = (fn (name ty)
	(name . (EVar (Scheme (~ . ty)))))
let poly = (fn (vars name ty)
	(name . (EVar (Scheme (vars . ty)))))

let builtinEnv = [
	(mono "+" (tArrow tInt (tArrow tInt tInt)))
	(mono "-" (tArrow tInt (tArrow tInt tInt)))
	(mono "*" (tArrow tInt (tArrow tInt tInt)))
	(mono "<" (tArrow tInt (tArrow tInt tInt)))
	(mono "=" (tArrow tInt (tArrow tInt tInt)))
	(mono "/" (tArrow tInt (tArrow tInt (tRes tInt (tList tInt)))))
	(mono "%" (tArrow tInt (tArrow tInt (tRes tInt (tList tInt)))))
	(poly [1] "@" (tArrow (TVar 1) tInt))
	(poly [1] "head" (tArrow (tList (TVar 1)) (tRes (TVar 1) (tList tInt))))
	(poly [1] "tail" (tArrow (tList (TVar 1)) (tRes (tList (TVar 1)) (tList tInt))))
	(poly [1 2] "fst" (tArrow (tPair (TVar 1) (TVar 2)) (TVar 1)))
	(poly [1 2] "snd" (tArrow (tPair (TVar 1) (TVar 2)) (TVar 2)))
	(poly [1] "cons" (tArrow (TVar 1) (tArrow (tList (TVar 1)) (tList (TVar 1)))))
	(poly [1] "pin" (tArrow (TVar 1) (tPin (TVar 1))))
	(poly [1] "force" (tArrow (tPin (TVar 1)) (TVar 1)))
	(poly [1] "fix" (tArrow (tArrow (TVar 1) (TVar 1)) (TVar 1)))
	("Ok" . (ECtor ("Result" . ([1 2] . (0 . (1 . (TVar 1)))))))
	("Err" . (ECtor ("Result" . ([1 2] . (1 . (1 . (TVar 2)))))))
	("#Result" . (ESum ("Result" . ([1 2] . [("Ok" . (0 . 1)) ("Err" . (1 . 1))]))))
]

letrec findE = (fn (env name)
	(if (= (@ env) 1)
		Missing
		(if (same (fst (hdOr env (~ . (EVar (Scheme (~ . (TVar 0))))))) name)
			(Found (snd (hdOr env (~ . (EVar (Scheme (~ . (TVar 0))))))))
			(findE (tl env) name))))

; A unification adds at most one error, so the error it adds gets the position of the node.
let addPos = (fn (st0 st1 at)
	(if (< (lenOf (errsOf st0)) (lenOf (errsOf st1)))
		(mkSt (nextOf st1) (bindsOf st1) (snoc (errsOf st0) (posMsg at (lastMsg (errsOf st1)))))
		st1))
let unifyAt = (fn (st at a e)
	(addPos st (unify st a e) at))

letrec varsOf = (fn l
	(if (= (@ l) 1)
		~
		(cons (TVar (first l)) (varsOf (tl l)))))
let ctorSch = (fn (name params hasPay payload)
	(if (= hasPay 1)
		(Scheme (params . (tArrow payload (TCon (name . (varsOf params))))))
		(Scheme (params . (TCon (name . (varsOf params)))))))
let ctorScheme = (fn c
	match c {
		ECtor p -> (ctorSch (fst p) (fst (snd p)) (fst (snd (snd (snd p)))) (snd (snd (snd (snd p)))))
		_ -> (Scheme (~ . (TVar 0)))
	})
let retEntry = (fn e
	match e {
		EVar s -> (schemeTy s)
		_ -> (TVar 0)
	})
let retOf = (fn env
	match (findE env "#ret") {
		Found e -> (retEntry e)
		Missing -> (TVar 0)
	})

let notBound = (fn (st p level)
	(let fr = (fresh st level)
	((fst fr) . (addErr (snd fr) (posMsg (snd p) (cat (fst p) " is not bound"))))))
let lookupEntry = (fn (st e p level)
	match e {
		EVar s -> (instantiate st level s)
		ECtor c -> (instantiate st level (ctorScheme (ECtor c)))
		_ -> (notBound st p level)
	})
let lookupName = (fn (st env p level)
	match (findE env (fst p)) {
		Found e -> (lookupEntry st e p level)
		Missing -> (notBound st p level)
	})

; A program's type must be a function, unless it is not known yet: a concrete type that is not an arrow is an error.
let badProgram = (fn (bs t)
	match (prune bs t) {
		TVar y -> 0
		TCon p -> (if (same (fst p) "->") 0 1)
	})

; A step of a node that unifies with the node's own type. When it fails, the node is abandoned: the Luau checker raises there, and the node gets a fresh type, so no later step of the node runs. A failure in a child does not abandon the node, since the child is abandoned on its own.
let grew = (fn (a b)
	(if (< (lenOf (errsOf a)) (lenOf (errsOf b))) 1 0))


let msP = (fn ms
	match ms {
		MS p -> p
	})
let msSt = (fn ms
	(fst (msP ms)))
let msFixed = (fn ms
	(fst (snd (msP ms))))
let msName = (fn ms
	(fst (snd (snd (msP ms)))))
let msTy = (fn ms
	(fst (snd (snd (snd (msP ms))))))
let msArgs = (fn ms
	(fst (snd (snd (snd (snd (msP ms)))))))
let msCov = (fn ms
	(fst (snd (snd (snd (snd (snd (msP ms))))))))
let msCatch = (fn ms
	(snd (snd (snd (snd (snd (snd (msP ms))))))))
let mkMS = (fn (st fixed nm ty args cov catch)
	(MS (st . (fixed . (nm . (ty . (args . (cov . catch))))))))
let withSt = (fn (ms st)
	(mkMS st (msFixed ms) (msName ms) (msTy ms) (msArgs ms) (msCov ms) (msCatch ms)))
let withCatch = (fn ms
	(mkMS (msSt ms) (msFixed ms) (msName ms) (msTy ms) (msArgs ms) (msCov ms) 1))
letrec freshN = (fn (st0 n level)
	(if (= n 0)
		(~ . st0)
		(let r = (fresh st0 level)
		(let more = (freshN (snd r) (- n 1) level)
		((cons (fst r) (fst more)) . (snd more))))))
letrec zipM = (fn (ps as)
	(if (= (@ ps) 1)
		~
		(cons ((first ps) . (hdOr as (TVar 0))) (zipM (tl ps) (tl as)))))
letrec missingNames = (fn (ctors cov)
	(if (= (@ ctors) 1)
		~
		(let rest = (missingNames (tl ctors) cov)
		(if (= (memberI (fst (snd (hdOr ctors (~ . (0 . 0))))) cov) 1)
			rest
			(cons (fst (hdOr ctors (~ . (0 . 0)))) rest)))))
letrec joinNames = (fn l
	(if (= (@ l) 1)
		~
		(if (= (@ (tl l)) 1)
			(hdOr l ~)
			(cat (hdOr l ~) (cat ", " (joinNames (tl l)))))))

; The constructor of a pattern, once the sum is known: its tag is covered, and its payload is bound to the name.
let conPatGo = (fn (ms env name bind at tagv hasPay pay params scrutTy level)
	let ms1 = (mkMS (msSt ms) (msFixed ms) (msName ms) (msTy ms) (msArgs ms) (cons tagv (msCov ms)) (msCatch ms))
	let pt = (subst (bindsOf (msSt ms1)) (zipM params (msArgs ms1)) pay)
	(if (= (@ bind) 1)
		(1 . (ms1 . env))
		(if (= hasPay 0)
			(0 . ((withSt ms1 (addErr (msSt ms1) (posMsg at (cat name " has no payload to bind")))) . env))
			(1 . (ms1 . (cons (bind . (EVar (Scheme (~ . pt)))) env))))))
let conCtor = (fn (ms env c name bind at scrutTy scrutAt level)
	(if (= (msFixed ms) 1)
		(if (same (fst c) (msName ms))
			(conPatGo ms env name bind at (fst (snd (snd c))) (fst (snd (snd (snd c)))) (snd (snd (snd (snd c)))) (fst (snd c)) scrutTy level)
			(0 . ((withSt ms (addErr (msSt ms) (posMsg at (cat name (cat " belongs to " (cat (fst c) (cat ", but the match is on " (msName ms)))))))) . env)))
		(let fr = (freshN (msSt ms) (lenOf (fst (snd c))) level)
		(let sumT = (TCon ((fst c) . (fst fr)))
		(let s2 = (unifyAt (snd fr) scrutAt scrutTy sumT)
		(if (= (grew (snd fr) s2) 1)
			(0 . ((withSt ms s2) . env))
			(conPatGo (mkMS s2 1 (fst c) sumT (fst fr) (msCov ms) (msCatch ms)) env name bind at (fst (snd (snd c))) (fst (snd (snd (snd c)))) (snd (snd (snd (snd c)))) (fst (snd c)) scrutTy level)))))))
let conEntry = (fn (ms env e name bind at scrutTy scrutAt level)
	match e {
		ECtor c -> (conCtor ms env c name bind at scrutTy scrutAt level)
		_ -> (0 . ((withSt ms (addErr (msSt ms) (posMsg at (cat name " is not a constructor")))) . env))
	})
let conPat = (fn (ms env name bind at scrutTy scrutAt level)
	match (findE env name) {
		Found e -> (conEntry ms env e name bind at scrutTy scrutAt level)
		Missing -> (0 . ((withSt ms (addErr (msSt ms) (posMsg at (cat name " is not a constructor")))) . env))
	})
let armPat = (fn (ms env pat scrutTy scrutAt level)
	(match pat {
		PCon p -> (conPat ms env (fst p) (fst (snd p)) (snd (snd p)) scrutTy scrutAt level)
		PBind p -> (1 . ((withCatch ms) . (cons ((fst p) . (EVar (Scheme (~ . scrutTy)))) env)))
		PWild p -> (1 . ((withCatch ms) . env))
	}))
let armBody = (fn (inf ms env body resTy level)
	(let r = (inf (msSt ms) env body level)
	(let s2 = (unifyAt (snd r) (atOfE body) (fst r) resTy)
	(if (= (grew (snd r) s2) 1)
		(0 . (withSt ms s2))
		(1 . (withSt ms s2))))))
letrec armsLoop = (fn (inf ms env arms resTy scrutTy scrutAt level)
	(if (= (@ arms) 1)
		(1 . ms)
		(let arm = (hdOr arms (PWild (0 . 0) . ((ENil (0 . 0)) . (0 . 0))))
		(let pat = (fst arm)
		(let body = (fst (snd arm))
		(let aAt = (snd (snd arm))
		(if (= (msCatch ms) 1)
			(0 . (withSt ms (addErr (msSt ms) (posMsg aAt "an arm after a catch-all arm is unreachable"))))
			(let pr = (armPat ms env pat scrutTy scrutAt level)
			(if (= (fst pr) 0)
				(0 . (fst (snd pr)))
				(let br = (armBody inf (fst (snd pr)) (snd (snd pr)) body resTy level)
				(if (= (fst br) 0)
					(0 . (snd br))
					(armsLoop inf (snd br) env (tl arms) resTy scrutTy scrutAt level))))))))))))
let sumCtorsEntry = (fn e
	match e {
		ESum s -> (snd (snd s))
		_ -> ~
	})
let sumCtorsOf = (fn (env name)
	match (findE env (cat "#" name)) {
		Found e -> (sumCtorsEntry e)
		Missing -> ~
	})
let inferMatchWith = (fn (inf st env p level)
	(let rs = (inf st env (fst p) level)
	(let rr = (fresh (snd rs) level)
	(let r = (armsLoop inf (mkMS (snd rr) 0 "Result" (TVar 0) ~ ~ 0) env (fst (snd p)) (fst rr) (fst rs) (atOfE (fst p)) level)
	(if (= (fst r) 0)
		(fresh (msSt (snd r)) level)
		(if (= (msCatch (snd r)) 1)
			((fst rr) . (msSt (snd r)))
			(let missing = (missingNames (sumCtorsOf env (msName (snd r))) (msCov (snd r)))
			(if (= (@ missing) 1)
				((fst rr) . (msSt (snd r)))
				(fresh (addErr (msSt (snd r)) (posMsg (snd (snd p)) (cat "match does not cover " (joinNames missing)))) level)))))))))

letrec infer = (fn (st env node level)
	(letrec inferItems = (fn (st0 items item)
		(if (= (@ items) 1)
			(1 . st0)
			(let x = (hdOr items (ENil (0 . 0)))
			(let r = (infer st0 env x level)
			(let s1 = (unifyAt (snd r) (atOfE x) (fst r) item)
			(if (= (grew (snd r) s1) 1)
				(0 . s1)
				(inferItems s1 (tl items) item)))))))
	(letrec appArgs = (fn (st0 cur args at)
		(if (= (@ args) 1)
			(1 . (cur . st0))
			(let x = (hdOr args (ENil (0 . 0)))
			(let r = (infer st0 env x level)
			(let p1 = (fresh (snd r) level)
			(let p2 = (fresh (snd p1) level)
			(let s1 = (unifyAt (snd p2) at cur (tArrow (fst p1) (fst p2)))
			(if (= (grew (snd p2) s1) 1)
				(0 . (cur . s1))
				(let s2 = (unifyAt s1 (atOfE x) (fst r) (fst p1))
				(if (= (grew s1 s2) 1)
					(0 . ((fst p2) . s2))
					(appArgs s2 (fst p2) (tl args) at)))))))))))
	(letrec inferFn = (fn (st0 envF names body)
		(if (= (@ names) 1)
			(let rr = (fresh st0 level)
			(let rb = (infer (snd rr) (cons ("#ret" . (EVar (Scheme (~ . (fst rr))))) envF) body level)
			(let s1 = (unifyAt (snd rb) (atOfE body) (fst rb) (fst rr))
			(if (= (grew (snd rb) s1) 1)
				(0 . ((fst rr) . s1))
				(1 . ((fst rr) . s1))))))
			(let p = (fresh st0 level)
			(let envF2 = (cons ((hdOr names ~) . (EVar (Scheme (~ . (fst p))))) envF)
			(let rest = (inferFn (snd p) envF2 (tl names) body)
			((fst rest) . ((tArrow (fst p) (fst (snd rest))) . (snd (snd rest)))))))))
	(match node {
		EInt p -> (tInt . st)
		EStr p -> ((tList tInt) . st)
		ENil p -> (let fr = (fresh st level)
			((tList (fst fr)) . (snd fr)))
		EName p -> (lookupName st env p level)
		EList p -> (let item = (fresh st level)
			(let r = (inferItems (snd item) (fst p) (fst item))
			(if (= (fst r) 1)
				((tList (fst item)) . (snd r))
				(fresh (snd r) level))))
		EPair p -> (let ra = (infer st env (fst p) level)
			(let rb = (infer (snd ra) env (fst (snd p)) level)
			((tPair (fst ra) (fst rb)) . (snd rb))))
		EApp p -> (let rf = (infer st env (fst p) level)
			(let r = (appArgs (snd rf) (fst rf) (fst (snd p)) (snd (snd p)))
			(if (= (fst r) 1)
				(snd r)
				(fresh (snd (snd r)) level))))
		EFn p -> (let r = (inferFn st env (fst p) (fst (snd p)))
			(if (= (fst r) 1)
				(snd r)
				(fresh (snd (snd r)) level)))
		ELet p -> (if (= (fst (snd (snd (snd p)))) 1)
			(let f = (fresh st (+ level 1))
			(let recEnv = (cons ((fst p) . (EVar (Scheme (~ . (fst f))))) env)
			(let v = (infer (snd f) recEnv (fst (snd p)) (+ level 1))
			(let s2 = (unifyAt (snd v) (atOfE (fst (snd p))) (fst v) (fst f))
			(if (= (grew (snd v) s2) 1)
				(fresh s2 level)
				(let env2 = (cons ((fst p) . (EVar (generalize s2 level (fst f)))) env)
				(infer s2 env2 (fst (snd (snd p))) level)))))))
			(let v = (infer st env (fst (snd p)) (+ level 1))
			(let env2 = (cons ((fst p) . (EVar (generalize (snd v) level (fst v)))) env)
			(infer (snd v) env2 (fst (snd (snd p))) level))))
		EIf p -> (let rc = (infer st env (fst p) level)
			(let rt = (infer (snd rc) env (fst (snd p)) level)
			(let re = (infer (snd rt) env (fst (snd (snd p))) level)
			(let s1 = (unifyAt (snd re) (atOfE (fst p)) (fst rc) tInt)
			(if (= (grew (snd re) s1) 1)
				(fresh s1 level)
				(let s2 = (unifyAt s1 (atOfE (fst (snd (snd p)))) (fst re) (fst rt))
				(if (= (grew s1 s2) 1)
					(fresh s2 level)
					((fst rt) . s2))))))))
		EMatch p -> (inferMatchWith infer st env p level)
		ETry p -> (let rt = (infer st env (fst p) level)
			(let okT = (fresh (snd rt) level)
			(let errT = (fresh (snd okT) level)
			(let s1 = (unifyAt (snd errT) (atOfE (fst p)) (fst rt) (tRes (fst okT) (fst errT)))
			(if (= (grew (snd errT) s1) 1)
				(fresh s1 level)
				(let rr = (fresh s1 level)
				(let s2 = (unifyAt (snd rr) (snd p) (tRes (fst rr) (fst errT)) (retOf env))
				(if (= (grew (snd rr) s2) 1)
					(fresh s2 level)
					((fst okT) . s2)))))))))
		ECheck p -> (let r = (infer st env (fst p) level)
			(let t = (fresh (snd r) (- 0 1))
			((tRes (fst t) (tList tInt)) . (snd t))))
		EUntyped p -> (let r = (infer st env (fst p) level)
			(tDyn . (snd r)))
		_ -> (let fr = (fresh st level)
			((fst fr) . (addErr (snd fr) (posMsg (atOfE node) "this form is not checked yet"))))
	})))))

; The type of a whole program: a function of its input. Its output is the rendered type, and the errors.
let tvarId = (fn t
	match t {
		TVar i -> i
		TCon p -> 0
	})
letrec idsOf = (fn l
	(if (= (@ l) 1)
		~
		(cons (tvarId (hdOr l (TVar 0))) (idsOf (tl l)))))
let isNoType = (fn t
	match t {
		NoType -> 1
		_ -> 0
	})
let findIs = (fn (env key)
	match (findE env key) {
		Found e -> 1
		Missing -> 0
	})
letrec ctorItems = (fn (cs k)
	(if (= (@ cs) 1)
		~
		(cons ((fst (hdOr cs (~ . (NoType . (0 . 0))))) . (k . (- 1 (isNoType (fst (snd (hdOr cs (~ . (NoType . (0 . 0)))))))))) (ctorItems (tl cs) (+ k 1)))))
letrec zipNM = (fn (names ids)
	(if (= (@ names) 1)
		~
		(cons ((hdOr names ~) . (TVar (first ids))) (zipNM (tl names) (tl ids)))))
letrec pmFind = (fn (pm name)
	(if (= (@ pm) 1)
		(0 . (TVar 0))
		(if (same (fst (hdOr pm (~ . (TVar 0)))) name)
			(1 . (snd (hdOr pm (~ . (TVar 0)))))
			(pmFind (tl pm) name))))
let isCapB = (fn w
	(if (< (first w) 65) 0 (if (< 90 (first w)) 0 1)))

; The type of a declared constructor's payload, with the declaration's parameters as variables.
let sumArity = (fn (ids name at args)
	(if (= (lenOf ids) (lenOf args))
		(Ok (TCon (name . args)))
		(Err (posMsg at (cat name (cat " takes " (cat (showNat (lenOf ids)) (cat " types, but is given " (showNat (lenOf args))))))))))
let sumApplyEntry = (fn (e name at args)
	match e {
		ESum s -> (sumArity (fst (snd s)) name at args)
		_ -> (Err (posMsg at (cat name " is not a type")))
	})
let sumApplied = (fn (env name at args)
	match (findE env (cat "#" name)) {
		Found e -> (sumApplyEntry e name at args)
		Missing -> (Err (posMsg at (cat name " is not a type")))
	})
let convName = (fn (env pm name at)
	(if (isCapB name)
		(if (same name "Int")
			(Ok tInt)
			(sumApplied env name at ~))
		(let f = (pmFind pm name)
		(if (= (fst f) 1)
			(Ok (snd f))
			(Err (posMsg at (cat name " is not a type variable of this declaration")))))))
; Converts the arguments of a sum type, in order. The converter is passed in, since the arguments refer back to the type converter.
letrec convArgs = (fn (conv env pm args)
	(if (= (@ args) 1)
		(Ok ~)
		(match (conv env pm (hdOr args NoType)) {
			Err e -> (Err e)
			Ok a -> (match (convArgs conv env pm (tl args)) {
				Err e -> (Err e)
				Ok more -> (Ok (cons a more))
			})
		})))
let convApp = (fn (conv env pm p)
	match (convArgs conv env pm (fst (snd p))) {
		Err e -> (Err e)
		Ok args -> (sumApplied env (fst p) (snd (snd p)) args)
	})
let convPair = (fn (conv env pm p)
	match (conv env pm (fst p)) {
		Err e -> (Err e)
		Ok a -> (match (conv env pm (fst (snd p))) {
			Err e -> (Err e)
			Ok b -> (Ok (tPair a b))
		})
	})
let convFunT = (fn (conv env pm p)
	match (conv env pm (fst p)) {
		Err e -> (Err e)
		Ok a -> (match (conv env pm (fst (snd p))) {
			Err e -> (Err e)
			Ok b -> (Ok (tArrow a b))
		})
	})
let convListT = (fn (conv env pm item)
	match (conv env pm item) {
		Err e -> (Err e)
		Ok a -> (Ok (tList a))
	})
letrec convType = (fn (env pm t)
	match t {
		TName p -> (convName env pm (fst p) (snd p))
		TApp p -> (convApp convType env pm p)
		TPair p -> (convPair convType env pm p)
		TList p -> (convListT convType env pm (fst p))
		TFun p -> (convFunT convType env pm p)
		NoType -> (Ok (TVar 0))
	})
; The first pass declares every sum, with its parameters and constructors, so that the sums can refer to one another.
letrec prepSums = (fn (st env ds)
	(if (= (@ ds) 1)
		(Ok (st . (env . ~)))
		(let d = (hdOr ds (~ . (~ . (~ . (0 . 0)))))
		(let name = (fst d)
		(if (if (same name "Int") 1 (findIs env (cat "#" name)))
			(Err (posMsg (snd (snd (snd d))) (cat name " is already declared")))
			(let fr = (freshN st (lenOf (fst (snd d))) (- 0 1))
			(let ids = (idsOf (fst fr))
			(let env2 = (cons ((cat "#" name) . (ESum (name . (ids . (ctorItems (fst (snd (snd d))) 0))))) env)
			(let more = (prepSums (snd fr) env2 (tl ds))?
			(Ok ((fst more) . ((fst (snd more)) . (cons (d . ids) (snd (snd more)))))))))))))))

; The second pass gives each constructor its entry, with its payload type.
letrec conPass = (fn (st env cs k pm sumN ids)
	(if (= (@ cs) 1)
		(Ok (st . env))
		(let c = (hdOr cs (~ . (NoType . (0 . 0))))
		(let cname = (fst c)
		(let pay = (fst (snd c))
		(let at = (snd (snd c))
		(if (findIs env cname)
			(Err (posMsg at (cat cname " is already declared")))
			(if (= (isNoType pay) 1)
				(conPass st (cons (cname . (ECtor (sumN . (ids . (k . (0 . (TVar 0))))))) env) (tl cs) (+ k 1) pm sumN ids)
				(let ty = (convType env pm pay)?
				(conPass st (cons (cname . (ECtor (sumN . (ids . (k . (1 . ty)))))) env) (tl cs) (+ k 1) pm sumN ids))))))))))
letrec ctorsPass = (fn (st env infos)
	(if (= (@ infos) 1)
		(Ok (st . env))
		(let inf = (hdOr infos ((~ . (~ . (~ . (0 . 0)))) . ~))
		(let d = (fst inf)
		(let pm = (zipNM (fst (snd d)) (snd inf))
		(let r = (conPass st env (fst (snd (snd d))) 0 pm (fst d) (snd inf))?
		(ctorsPass (fst r) (snd r) (tl infos))))))))
let declareAll = (fn (st env ds)
	(let p = (prepSums st env ds)?
	(ctorsPass (fst p) (fst (snd p)) (snd (snd p)))))

let inferBody = (fn (st env ex)
	(let rv = (fresh st 0)
	(let r = (infer (snd rv) (cons ("#ret" . (EVar (Scheme (~ . (fst rv))))) env) ex 0)
	(let st1 = (snd r)
	(if (= (badProgram (bindsOf st1) (fst r)) 1)
		(let st3 = (addErr st1 (posMsg (atOfE ex) (cat "the program must be a function of its input, but it is " (render (bindsOf st1) (fst r)))))
		((render (bindsOf st3) (fst r)) . (errsOf st3)))
		(let inp = (fresh st1 0)
		(let outp = (fresh (snd inp) 0)
		(let st2 = (unifyAt (snd outp) (atOfE ex) (fst r) (tArrow (fst inp) (fst outp)))
		((render (bindsOf st2) (fst r)) . (errsOf st2))))))))))

; The type of a whole program: its declarations, then the body, which is a function of its input.
let inferProgram = (fn prog
	(match (declareAll (mkSt 1000 TEmpty ~) builtinEnv (fst prog)) {
		Err msg -> ("" . (cons msg ~))
		Ok d -> (inferBody (fst d) (snd d) (snd prog))
	}))

fn p
	match p {
		Unify q -> (runUnify q)
		Gen q -> (runGen q)
		Inst q -> (runInst q)
		Infer ex -> (inferProgram ex)
	}
---
Unify ((TCon ("Int" . ~)) . (TCon ("Int" . ~))) => ("Int" . ~) fuel 1000000
Unify ((TCon ("Int" . ~)) . (TCon ("list" . [(TCon ("Int" . ~))]))) => ("Int" . ["expected [Int], but this is Int"]) fuel 1000000
Unify ((TVar 1) . (TCon ("Int" . ~))) => ("Int" . ~) fuel 1000000
Unify ((TVar 1) . (TVar 2)) => ("?2" . ~) fuel 1000000
Unify ((TVar 1) . (TCon ("list" . [(TVar 1)]))) => ("?1" . ["?1 would be an infinite type"]) fuel 1000000
Unify ((TCon ("Dyn" . ~)) . (TCon ("Int" . ~))) => ("Dyn" . ["expected Int, but this is Dyn"]) fuel 1000000
Unify ((TVar 1) . (TCon ("Dyn" . ~))) => ("Dyn" . ~) fuel 1000000
Unify ((TCon ("pair" . [(TCon ("Int" . ~)) (TCon ("Int" . ~))])) . (TCon ("list" . [(TCon ("Int" . ~))]))) => ("(Int . Int)" . ["expected [Int], but this is (Int . Int)"]) fuel 1000000
Unify ((TCon ("->" . [(TCon ("Int" . ~)) (TCon ("Int" . ~))])) . (TCon ("->" . [(TCon ("Int" . ~)) (TCon ("Int" . ~))]))) => ("(Int -> Int)" . ~) fuel 1000000
Unify ((TCon ("->" . [(TCon ("Int" . ~)) (TCon ("Int" . ~))])) . (TCon ("->" . [(TCon ("list" . [(TCon ("Int" . ~))])) (TCon ("list" . [(TCon ("Int" . ~))]))]))) => ("(Int -> Int)" . ["expected [Int], but this is Int"]) fuel 1000000
Unify (TCon ("Option" . [(TCon ("Int" . ~))]) . (TCon ("Option" . [(TVar 3)]))) => ("Option Int" . ~) fuel 1000000
Gen (-1 . (TVar 1)) => ("forall ?1. ?1" . ~) fuel 1000000
Gen (-1 . (TCon ("->" . [(TVar 1) (TVar 2)]))) => ("forall ?1 ?2. (?1 -> ?2)" . ~) fuel 1000000
Gen (-1 . (TCon ("Int" . ~))) => ("Int" . ~) fuel 1000000
Gen (0 . (TVar 1)) => ("?1" . ~) fuel 1000000
Inst (0 . (Scheme ([1] . (TCon ("->" . [(TVar 1) (TVar 1)]))))) => ("(?1000 -> ?1000)" . ~) fuel 1000000
Inst (0 . (Scheme ([1 2] . (TCon ("->" . [(TVar 1) (TVar 2)]))))) => ("(?1000 -> ?1001)" . ~) fuel 1000000
Inst (0 . (Scheme ([] . (TVar 5)))) => ("?5" . ~) fuel 1000000
Inst (0 . (Scheme ([1] . (TCon ("list" . [(TVar 1)]))))) => ("[?1000]" . ~) fuel 1000000
