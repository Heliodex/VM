The first part of the L2 checker, written in L2 with no mutation. The state is a value: a counter for the next variable, the bindings of the variables, and the errors so far. A binding is a list of (id . Bind), and a new binding is consed on the front, so a lookup finds the newest. Every operation gives back the state it changes. This file holds the types, the state, and unification. A test's output is the rendered first type, with the errors, as the Luau checker writes them.
---
---
type Ty = TVar Int | TCon ([Int] . [Ty])
type Bind = Unbound Int | Bound Ty
type St = St (Int . ([(Int . Bind)] . [[Int]]))
type Scheme = Scheme ([Int] . Ty)
type Look = Found Scheme | Missing
type Req = Unify (Ty . Ty) | Gen (Int . Ty) | Inst (Int . Scheme) | Infer Expr
type MS = MS (St . (Int . ([Int] . (Ty . ([Ty] . ([Int] . Int))))))
type Expr = EInt (Int . (Int . Int)) | EStr ([Int] . (Int . Int)) | ENil (Int . Int) | EName ([Int] . (Int . Int)) | EList ([Expr] . (Int . Int)) | EPair (Expr . (Expr . (Int . Int))) | EApp (Expr . ([Expr] . (Int . Int))) | EFn ([[Int]] . (Expr . (Int . Int))) | ELet ([Int] . (Expr . (Expr . (Int . (Int . Int))))) | EMutual ([([Int] . (Expr . (Int . Int)))] . (Expr . (Int . Int))) | EIf (Expr . (Expr . (Expr . (Int . Int)))) | EMatch (Expr . ([(Pat . (Expr . (Int . Int)))] . (Int . Int))) | ETry (Expr . (Int . Int)) | ECheck (Expr . (Int . Int)) | EUntyped (Expr . (Int . Int))
type Pat = PCon ([Int] . ([Int] . (Int . Int))) | PBind ([Int] . (Int . Int)) | PWild (Int . Int)

let first = (fn l
	match (head l) {
		Ok c -> c
		Err e -> -1
	})
let tl = (fn l
	match (tail l) {
		Ok t -> t
		Err e -> ~
	})
let hdE = (fn l
	match (head l) {
		Ok e -> e
		Err e -> (0 . (Unbound 0))
	})
let hdM = (fn l
	match (head l) {
		Ok e -> e
		Err e -> (0 . (TVar 0))
	})
let hdT = (fn l
	match (head l) {
		Ok t -> t
		Err e -> (TVar 0)
	})
let div10 = (fn n
	match (/ n 10) {
		Ok q -> q
		Err e -> 0
	})
let mod10 = (fn n
	match (% n 10) {
		Ok r -> r
		Err e -> 0
	})
letrec same = (fn (a b)
	(if (= (@ a) 1)
		(= (@ b) 1)
		(if (= (@ b) 1)
			0
			(if (= (first a) (first b))
				(same (tl a) (tl b))
				0))))
letrec lenOf = (fn l
	(if (= (@ l) 1) 0 (+ 1 (lenOf (tl l)))))
letrec cat = (fn (a b)
	(if (= (@ a) 1)
		b
		(cons (first a) (cat (tl a) b))))
letrec showNat = (fn n
	(if (< n 10)
		(cons (+ 48 n) ~)
		(cat (showNat (div10 n)) (cons (+ 48 (mod10 n)) ~))))
let varName = (fn id
	(cat "?" (showNat id)))

let stP = (fn st
	match st {
		St p -> p
	})
let nextOf = (fn st
	(fst (stP st)))
let bindsOf = (fn st
	(fst (snd (stP st))))
let errsOf = (fn st
	(snd (snd (stP st))))
let mkSt = (fn (n bs es)
	(St (n . (bs . es))))
letrec snoc = (fn (l x)
	(if (= (@ l) 1)
		(cons x ~)
		(match (head l) {
			Ok h -> (cons h (snoc (tl l) x))
			Err e -> (cons x ~)
		})))
let addErr = (fn (st msg)
	(mkSt (nextOf st) (bindsOf st) (snoc (errsOf st) msg)))

letrec findB = (fn (bs id)
	(if (= (@ bs) 1)
		(Unbound 0)
		(if (= (fst (hdE bs)) id)
			(snd (hdE bs))
			(findB (tl bs) id))))
let levelOf = (fn b
	match b {
		Unbound lv -> lv
		Bound t -> 0
	})
let fresh = (fn (st level)
	(let n = (nextOf st)
	((TVar n) . (mkSt (+ n 1) (cons (n . (Unbound level)) (bindsOf st)) (errsOf st)))))

letrec prune = (fn (bs t)
	(match t {
		TVar id -> (match (findB bs id) {
			Bound u -> (prune bs u)
			Unbound lv -> t
		})
		TCon p -> t
	}))

letrec occurs = (fn (bs id t)
	(letrec all = (fn args
		(if (= (@ args) 1)
			0
			(if (occurs bs id (hdT args)) 1 (all (tl args)))))
	(match (prune bs t) {
		TVar y -> (= y id)
		TCon p -> (all (snd p))
	})))

letrec lowerT = (fn (bs t level)
	(letrec lowerArgs = (fn (b args)
		(if (= (@ args) 1)
			b
			(lowerArgs (lowerT b (hdT args) level) (tl args))))
	(match (prune bs t) {
		TVar y -> (if (< level (levelOf (findB bs y))) (cons (y . (Unbound level)) bs) bs)
		TCon p -> (lowerArgs bs (snd p))
	})))

let hasArgs = (fn (bs a)
	match (prune bs a) {
		TVar y -> 0
		TCon p -> (if (= (@ (snd p)) 1) 0 1)
	})

letrec render = (fn (bs t)
	(letrec argText = (fn a
		(if (= (hasArgs bs a) 1)
			(cat "(" (cat (render bs a) ")"))
			(render bs a)))
	(letrec argsText = (fn args
		(if (= (@ args) 1)
			~
			(cat " " (cat (argText (hdT args)) (argsText (tl args))))))
	(letrec renderCon = (fn (name args)
		(if (same name "->")
			(cat "(" (cat (render bs (hdT args)) (cat " -> " (cat (render bs (hdT (tl args))) ")"))))
		(if (same name "pair")
			(cat "(" (cat (render bs (hdT args)) (cat " . " (cat (render bs (hdT (tl args))) ")"))))
		(if (same name "list")
			(cat "[" (cat (render bs (hdT args)) "]"))
			(if (= (@ args) 1)
				name
				(cat name (argsText args)))))))
	(match (prune bs t) {
		TVar y -> (varName y)
		TCon p -> (renderCon (fst p) (snd p))
	})))))

let mismatch = (fn (st a e)
	(addErr st (cat "expected " (cat (render (bindsOf st) e) (cat ", but this is " (render (bindsOf st) a))))))

let bindVar = (fn (st id t)
	(if (occurs (bindsOf st) id t)
		(addErr st (cat (varName id) " would be an infinite type"))
		(mkSt (nextOf st) (cons (id . (Bound t)) (lowerT (bindsOf st) t (levelOf (findB (bindsOf st) id)))) (errsOf st))))

letrec unify = (fn (st a0 e0)
	(letrec unifyArgs = (fn (st0 aa ea)
		(if (= (@ aa) 1)
			st0
			(let st1 = (unify st0 (hdT aa) (hdT ea))
			(if (< (lenOf (errsOf st0)) (lenOf (errsOf st1)))
				st1
				(unifyArgs st1 (tl aa) (tl ea))))))
	(let unifyCon = (fn (st2 na aa ne ea a e)
		(if (if (same na "Dyn") (same ne "Dyn") 0)
			st2
			(if (if (same na "Dyn") 1 (same ne "Dyn"))
				(mismatch st2 a e)
				(if (if (same na ne) (= (lenOf aa) (lenOf ea)) 0)
					(unifyArgs st2 aa ea)
					(mismatch st2 a e)))))
	(let bs = (bindsOf st)
	(let a = (prune bs a0)
	(let e = (prune bs e0)
	(match a {
		TVar x -> (match e {
			TVar y -> (if (= x y) st (bindVar st x e))
			TCon q -> (bindVar st x e)
		})
		TCon p -> (match e {
			TVar y -> (bindVar st y a)
			TCon q -> (unifyCon st (fst p) (snd p) (fst q) (snd q) a e)
		})
	})))))))

letrec memberI = (fn (x l)
	(if (= (@ l) 1)
		0
		(if (= (first l) x) 1 (memberI x (tl l)))))

letrec freeAbove = (fn (bs level t acc)
	(letrec argsFree = (fn (acc2 args)
		(if (= (@ args) 1)
			acc2
			(argsFree (freeAbove bs level (hdT args) acc2) (tl args))))
	(match (prune bs t) {
		TVar y -> (if (if (< level (levelOf (findB bs y))) (if (memberI y acc) 0 1) 0) (snoc acc y) acc)
		TCon p -> (argsFree acc (snd p))
	})))

let generalize = (fn (st level t)
	(Scheme ((freeAbove (bindsOf st) level t ~) . t)))

let schemeVars = (fn s
	match s {
		Scheme p -> (fst p)
	})
let schemeTy = (fn s
	match s {
		Scheme p -> (snd p)
	})

letrec lookupM = (fn (m id dflt)
	(if (= (@ m) 1)
		dflt
		(if (= (fst (hdM m)) id) (snd (hdM m)) (lookupM (tl m) id dflt))))

letrec subst = (fn (bs m t)
	(letrec substArgs = (fn args
		(if (= (@ args) 1)
			~
			(cons (subst bs m (hdT args)) (substArgs (tl args)))))
	(match (prune bs t) {
		TVar y -> (lookupM m y (TVar y))
		TCon p -> (TCon ((fst p) . (substArgs (snd p))))
	})))

letrec instMap = (fn (st level m vars)
	(if (= (@ vars) 1)
		(st . m)
		(let fr = (fresh st level)
		(instMap (snd fr) level (cons ((first vars) . (fst fr)) m) (tl vars)))))

let instantiate = (fn (st level s)
	(let r = (instMap st level ~ (schemeVars s))
	((subst (bindsOf (fst r)) (snd r) (schemeTy s)) . (fst r))))

letrec idsText = (fn l
	(if (= (@ l) 1)
		~
		(cat (varName (first l)) (if (= (@ (tl l)) 1) ~ (cat " " (idsText (tl l)))))))

let schemeText = (fn (bs s)
	(if (= (@ (schemeVars s)) 1)
		(render bs (schemeTy s))
		(cat "forall " (cat (idsText (schemeVars s)) (cat ". " (render bs (schemeTy s)))))))

let runUnify = (fn q
	(let st = (unify (mkSt 1000 ~ ~) (fst q) (snd q))
	((render (bindsOf st) (fst q)) . (errsOf st))))
let runGen = (fn q
	(let st = (mkSt 1000 ~ ~)
	(let s = (generalize st (fst q) (snd q))
	((schemeText (bindsOf st) s) . ~))))
let runInst = (fn q
	(let st = (mkSt 1000 ~ ~)
	(let r = (instantiate st (fst q) (snd q))
	((render (bindsOf (snd r)) (fst r)) . (errsOf (snd r))))))

let atOfE = (fn e
	match e {
		EInt p -> (snd p)
		EStr p -> (snd p)
		ENil p -> p
		EName p -> (snd p)
		EList p -> (snd p)
		EPair p -> (snd (snd p))
		EApp p -> (snd (snd p))
		EFn p -> (snd (snd p))
		ELet p -> (snd (snd (snd (snd p))))
		EMutual p -> (snd (snd p))
		EIf p -> (snd (snd (snd p)))
		EMatch p -> (snd (snd p))
		ETry p -> (snd p)
		ECheck p -> (snd p)
		EUntyped p -> (snd p)
	})
let hdX = (fn l
	match (head l) {
		Ok x -> x
		Err e -> (ENil (0 . 0))
	})
let hdN = (fn l
	match (head l) {
		Ok n -> n
		Err e -> ~
	})
let hdP = (fn l
	match (head l) {
		Ok p -> p
		Err e -> (~ . (Scheme (~ . (TVar 0))))
	})
let hdMsg = (fn l
	match (head l) {
		Ok m -> m
		Err e -> ~
	})
letrec lastMsg = (fn l
	(if (= (@ (tl l)) 1)
		(hdMsg l)
		(lastMsg (tl l))))
let posMsg = (fn (at msg)
	(cat "line " (cat (showNat (fst at)) (cat ", column " (cat (showNat (snd at)) (cat ": " msg))))))

let tInt = (TCon ("Int" . ~))
let tArrow = (fn (a b)
	(TCon ("->" . [a b])))
let tList = (fn a
	(TCon ("list" . [a])))
let tPair = (fn (a b)
	(TCon ("pair" . [a b])))
let tRes = (fn (a e)
	(TCon ("Result" . [a e])))
let tPin = (fn a
	(TCon ("Pin" . [a])))
let mono = (fn (name ty)
	(name . (Scheme (~ . ty))))
let poly = (fn (vars name ty)
	(name . (Scheme (vars . ty))))

let builtinEnv = [
	(mono "+" (tArrow tInt (tArrow tInt tInt)))
	(mono "-" (tArrow tInt (tArrow tInt tInt)))
	(mono "*" (tArrow tInt (tArrow tInt tInt)))
	(mono "<" (tArrow tInt (tArrow tInt tInt)))
	(mono "=" (tArrow tInt (tArrow tInt tInt)))
	(mono "/" (tArrow tInt (tArrow tInt (tRes tInt (tList tInt)))))
	(mono "%" (tArrow tInt (tArrow tInt (tRes tInt (tList tInt)))))
	(poly [1] "@" (tArrow (TVar 1) tInt))
	(poly [1] "head" (tArrow (tList (TVar 1)) (tRes (TVar 1) (tList tInt))))
	(poly [1] "tail" (tArrow (tList (TVar 1)) (tRes (tList (TVar 1)) (tList tInt))))
	(poly [1 2] "fst" (tArrow (tPair (TVar 1) (TVar 2)) (TVar 1)))
	(poly [1 2] "snd" (tArrow (tPair (TVar 1) (TVar 2)) (TVar 2)))
	(poly [1] "cons" (tArrow (TVar 1) (tArrow (tList (TVar 1)) (tList (TVar 1)))))
	(poly [1] "pin" (tArrow (TVar 1) (tPin (TVar 1))))
	(poly [1] "force" (tArrow (tPin (TVar 1)) (TVar 1)))
	(poly [1] "fix" (tArrow (tArrow (TVar 1) (TVar 1)) (TVar 1)))
	(poly [1 2] "Ok" (tArrow (TVar 1) (tRes (TVar 1) (TVar 2))))
	(poly [1 2] "Err" (tArrow (TVar 2) (tRes (TVar 1) (TVar 2))))
]

letrec findE = (fn (env name)
	(if (= (@ env) 1)
		Missing
		(if (same (fst (hdP env)) name)
			(Found (snd (hdP env)))
			(findE (tl env) name))))

; A unification adds at most one error, so the error it adds gets the position of the node.
let addPos = (fn (st0 st1 at)
	(if (< (lenOf (errsOf st0)) (lenOf (errsOf st1)))
		(mkSt (nextOf st1) (bindsOf st1) (snoc (errsOf st0) (posMsg at (lastMsg (errsOf st1)))))
		st1))
let unifyAt = (fn (st at a e)
	(addPos st (unify st a e) at))

let lookupName = (fn (st env p level)
	match (findE env (fst p)) {
		Found s -> (instantiate st level s)
		Missing -> (let fr = (fresh st level)
			((fst fr) . (addErr (snd fr) (posMsg (snd p) (cat (fst p) " is not bound")))))
	})

; A program's type must be a function, unless it is not known yet: a concrete type that is not an arrow is an error.
let badProgram = (fn (bs t)
	match (prune bs t) {
		TVar y -> 0
		TCon p -> (if (same (fst p) "->") 0 1)
	})

; A step of a node that unifies with the node's own type. When it fails, the node is abandoned: the Luau checker raises there, and the node gets a fresh type, so no later step of the node runs. A failure in a child does not abandon the node, since the child is abandoned on its own.
let grew = (fn (a b)
	(if (< (lenOf (errsOf a)) (lenOf (errsOf b))) 1 0))

; The built-in sum Result: each constructor is (name . (tag . (has payload . payload type)))
let resultCtors = [("Ok" . (0 . (1 . (TVar 1)))) ("Err" . (1 . (1 . (TVar 2))))]
let resultName = "Result"
let resultParams = [1 2]

let msP = (fn ms
	match ms {
		MS p -> p
	})
let msSt = (fn ms
	(fst (msP ms)))
let msFixed = (fn ms
	(fst (snd (msP ms))))
let msName = (fn ms
	(fst (snd (snd (msP ms)))))
let msTy = (fn ms
	(fst (snd (snd (snd (msP ms))))))
let msArgs = (fn ms
	(fst (snd (snd (snd (snd (msP ms)))))))
let msCov = (fn ms
	(fst (snd (snd (snd (snd (snd (msP ms))))))))
let msCatch = (fn ms
	(snd (snd (snd (snd (snd (snd (msP ms))))))))
let mkMS = (fn (st fixed nm ty args cov catch)
	(MS (st . (fixed . (nm . (ty . (args . (cov . catch))))))))
let withSt = (fn (ms st)
	(mkMS st (msFixed ms) (msName ms) (msTy ms) (msArgs ms) (msCov ms) (msCatch ms)))
let withCatch = (fn ms
	(mkMS (msSt ms) (msFixed ms) (msName ms) (msTy ms) (msArgs ms) (msCov ms) 1))
let hdCt = (fn l
	match (head l) {
		Ok c -> c
		Err e -> (~ . (0 . (0 . (TVar 0))))
	})
letrec ctorIn = (fn (ctors name)
	(if (= (@ ctors) 1)
		(0 . (0 . (0 . (TVar 0))))
		(if (same (fst (hdCt ctors)) name)
			(1 . (snd (hdCt ctors)))
			(ctorIn (tl ctors) name))))
letrec freshN = (fn (st0 n level)
	(if (= n 0)
		(~ . st0)
		(let r = (fresh st0 level)
		(let more = (freshN (snd r) (- n 1) level)
		((cons (fst r) (fst more)) . (snd more))))))
letrec zipM = (fn (ps as)
	(if (= (@ ps) 1)
		~
		(cons ((first ps) . (hdT as)) (zipM (tl ps) (tl as)))))
letrec missingNames = (fn (ctors cov)
	(if (= (@ ctors) 1)
		~
		(let rest = (missingNames (tl ctors) cov)
		(if (= (memberI (fst (snd (hdCt ctors))) cov) 1)
			rest
			(cons (fst (hdCt ctors)) rest)))))
letrec joinNames = (fn l
	(if (= (@ l) 1)
		~
		(if (= (@ (tl l)) 1)
			(hdN l)
			(cat (hdN l) (cat ", " (joinNames (tl l)))))))

; The constructor of a pattern. The first constructor fixes the sum, and the scrutinee is used at it.
let conPatGo = (fn (ms env bind at tagv hasPay pay scrutTy level)
	(let ms1 = (mkMS (msSt ms) (msFixed ms) (msName ms) (msTy ms) (msArgs ms) (cons tagv (msCov ms)) (msCatch ms))
	(let pt = (subst (bindsOf (msSt ms1)) (zipM resultParams (msArgs ms1)) pay)
	(if (= (@ bind) 1)
		(1 . (ms1 . env))
		(if (= hasPay 0)
			(0 . ((withSt ms1 (addErr (msSt ms1) (posMsg at (cat "" "has no payload to bind")))) . env))
			(1 . (ms1 . (cons (bind . (Scheme (~ . pt))) env))))))))
let conPat = (fn (ms env name bind at scrutTy scrutAt level)
	(let c = (ctorIn resultCtors name)
	(if (= (fst c) 0)
		(0 . ((withSt ms (addErr (msSt ms) (posMsg at (cat name " is not a constructor")))) . env))
		(if (= (msFixed ms) 1)
			(conPatGo ms env bind at (fst (snd c)) (fst (snd (snd c))) (snd (snd (snd c))) scrutTy level)
			(let fr = (freshN (msSt ms) (lenOf resultParams) level)
			(let sumT = (TCon (resultName . (fst fr)))
			(let s2 = (unifyAt (snd fr) scrutAt scrutTy sumT)
			(if (= (grew (snd fr) s2) 1)
				(0 . ((withSt ms s2) . env))
				(conPatGo (mkMS s2 1 resultName sumT (fst fr) (msCov ms) (msCatch ms)) env bind at (fst (snd c)) (fst (snd (snd c))) (snd (snd (snd c))) scrutTy level)))))))))
let armPat = (fn (ms env pat scrutTy scrutAt level)
	(match pat {
		PCon p -> (conPat ms env (fst p) (fst (snd p)) (snd (snd p)) scrutTy scrutAt level)
		PBind p -> (1 . ((withCatch ms) . (cons ((fst p) . (Scheme (~ . scrutTy))) env)))
		PWild p -> (1 . ((withCatch ms) . env))
	}))
let armBody = (fn (inf ms env body resTy level)
	(let r = (inf (msSt ms) env body level)
	(let s2 = (unifyAt (snd r) (atOfE body) (fst r) resTy)
	(if (= (grew (snd r) s2) 1)
		(0 . (withSt ms s2))
		(1 . (withSt ms s2))))))
let hdArm = (fn l
	match (head l) {
		Ok a -> a
		Err e -> (PWild (0 . 0) . ((ENil (0 . 0)) . (0 . 0)))
	})
letrec armsLoop = (fn (inf ms env arms resTy scrutTy scrutAt level)
	(if (= (@ arms) 1)
		(1 . ms)
		(let arm = (hdArm arms)
		(let pat = (fst arm)
		(let body = (fst (snd arm))
		(let aAt = (snd (snd arm))
		(if (= (msCatch ms) 1)
			(0 . (withSt ms (addErr (msSt ms) (posMsg aAt "an arm after a catch-all arm is unreachable"))))
			(let pr = (armPat ms env pat scrutTy scrutAt level)
			(if (= (fst pr) 0)
				(0 . (fst (snd pr)))
				(let br = (armBody inf (fst (snd pr)) (snd (snd pr)) body resTy level)
				(if (= (fst br) 0)
					(0 . (snd br))
					(armsLoop inf (snd br) env (tl arms) resTy scrutTy scrutAt level))))))))))))
let inferMatchWith = (fn (inf st env p level)
	(let rs = (inf st env (fst p) level)
	(let rr = (fresh (snd rs) level)
	(let r = (armsLoop inf (mkMS (snd rr) 0 resultName (TVar 0) ~ ~ 0) env (fst (snd p)) (fst rr) (fst rs) (atOfE (fst p)) level)
	(if (= (fst r) 0)
		(fresh (msSt (snd r)) level)
		(if (= (msCatch (snd r)) 1)
			((fst rr) . (msSt (snd r)))
			(let missing = (missingNames resultCtors (msCov (snd r)))
			(if (= (@ missing) 1)
				((fst rr) . (msSt (snd r)))
				(fresh (addErr (msSt (snd r)) (posMsg (snd (snd p)) (cat "match does not cover " (joinNames missing)))) level)))))))))

letrec infer = (fn (st env node level)
	(letrec inferItems = (fn (st0 items item)
		(if (= (@ items) 1)
			(1 . st0)
			(let x = (hdX items)
			(let r = (infer st0 env x level)
			(let s1 = (unifyAt (snd r) (atOfE x) (fst r) item)
			(if (= (grew (snd r) s1) 1)
				(0 . s1)
				(inferItems s1 (tl items) item)))))))
	(letrec appArgs = (fn (st0 cur args at)
		(if (= (@ args) 1)
			(1 . (cur . st0))
			(let x = (hdX args)
			(let r = (infer st0 env x level)
			(let p1 = (fresh (snd r) level)
			(let p2 = (fresh (snd p1) level)
			(let s1 = (unifyAt (snd p2) at cur (tArrow (fst p1) (fst p2)))
			(if (= (grew (snd p2) s1) 1)
				(0 . (cur . s1))
				(let s2 = (unifyAt s1 (atOfE x) (fst r) (fst p1))
				(if (= (grew s1 s2) 1)
					(0 . ((fst p2) . s2))
					(appArgs s2 (fst p2) (tl args) at)))))))))))
	(letrec inferFn = (fn (st0 envF names body)
		(if (= (@ names) 1)
			(let rr = (fresh st0 level)
			(let rb = (infer (snd rr) envF body level)
			(let s1 = (unifyAt (snd rb) (atOfE body) (fst rb) (fst rr))
			(if (= (grew (snd rb) s1) 1)
				(0 . ((fst rr) . s1))
				(1 . ((fst rr) . s1))))))
			(let p = (fresh st0 level)
			(let envF2 = (cons ((hdN names) . (Scheme (~ . (fst p)))) envF)
			(let rest = (inferFn (snd p) envF2 (tl names) body)
			((fst rest) . ((tArrow (fst p) (fst (snd rest))) . (snd (snd rest)))))))))
	(match node {
		EInt p -> (tInt . st)
		EStr p -> ((tList tInt) . st)
		ENil p -> (let fr = (fresh st level)
			((tList (fst fr)) . (snd fr)))
		EName p -> (lookupName st env p level)
		EList p -> (let item = (fresh st level)
			(let r = (inferItems (snd item) (fst p) (fst item))
			(if (= (fst r) 1)
				((tList (fst item)) . (snd r))
				(fresh (snd r) level))))
		EPair p -> (let ra = (infer st env (fst p) level)
			(let rb = (infer (snd ra) env (fst (snd p)) level)
			((tPair (fst ra) (fst rb)) . (snd rb))))
		EApp p -> (let rf = (infer st env (fst p) level)
			(let r = (appArgs (snd rf) (fst rf) (fst (snd p)) (snd (snd p)))
			(if (= (fst r) 1)
				(snd r)
				(fresh (snd (snd r)) level))))
		EFn p -> (let r = (inferFn st env (fst p) (fst (snd p)))
			(if (= (fst r) 1)
				(snd r)
				(fresh (snd (snd r)) level)))
		ELet p -> (if (= (fst (snd (snd (snd p)))) 1)
			(let f = (fresh st (+ level 1))
			(let recEnv = (cons ((fst p) . (Scheme (~ . (fst f)))) env)
			(let v = (infer (snd f) recEnv (fst (snd p)) (+ level 1))
			(let s2 = (unifyAt (snd v) (atOfE (fst (snd p))) (fst v) (fst f))
			(if (= (grew (snd v) s2) 1)
				(fresh s2 level)
				(let env2 = (cons ((fst p) . (generalize s2 level (fst f))) env)
				(infer s2 env2 (fst (snd (snd p))) level)))))))
			(let v = (infer st env (fst (snd p)) (+ level 1))
			(let env2 = (cons ((fst p) . (generalize (snd v) level (fst v))) env)
			(infer (snd v) env2 (fst (snd (snd p))) level))))
		EIf p -> (let rc = (infer st env (fst p) level)
			(let rt = (infer (snd rc) env (fst (snd p)) level)
			(let re = (infer (snd rt) env (fst (snd (snd p))) level)
			(let s1 = (unifyAt (snd re) (atOfE (fst p)) (fst rc) tInt)
			(if (= (grew (snd re) s1) 1)
				(fresh s1 level)
				(let s2 = (unifyAt s1 (atOfE (fst (snd (snd p)))) (fst re) (fst rt))
				(if (= (grew s1 s2) 1)
					(fresh s2 level)
					((fst rt) . s2))))))))
		EMatch p -> (inferMatchWith infer st env p level)
		_ -> (let fr = (fresh st level)
			((fst fr) . (addErr (snd fr) (posMsg (atOfE node) "this form is not checked yet"))))
	})))))

; The type of a whole program: a function of its input. Its output is the rendered type, and the errors.
let inferProgram = (fn ex
	(let r = (infer (mkSt 1000 ~ ~) builtinEnv ex 0)
	(let st1 = (snd r)
	(if (= (badProgram (bindsOf st1) (fst r)) 1)
		(let st3 = (addErr st1 (posMsg (atOfE ex) (cat "the program must be a function of its input, but it is " (render (bindsOf st1) (fst r)))))
		((render (bindsOf st3) (fst r)) . (errsOf st3)))
		(let inp = (fresh st1 0)
		(let outp = (fresh (snd inp) 0)
		(let st2 = (unifyAt (snd outp) (atOfE ex) (fst r) (tArrow (fst inp) (fst outp)))
		((render (bindsOf st2) (fst r)) . (errsOf st2)))))))))

fn p
	match p {
		Unify q -> (runUnify q)
		Gen q -> (runGen q)
		Inst q -> (runInst q)
		Infer ex -> (inferProgram ex)
	}
---
Unify ((TCon ("Int" . ~)) . (TCon ("Int" . ~))) => ("Int" . ~) fuel 1000000
Unify ((TCon ("Int" . ~)) . (TCon ("list" . [(TCon ("Int" . ~))]))) => ("Int" . ["expected [Int], but this is Int"]) fuel 1000000
Unify ((TVar 1) . (TCon ("Int" . ~))) => ("Int" . ~) fuel 1000000
Unify ((TVar 1) . (TVar 2)) => ("?2" . ~) fuel 1000000
Unify ((TVar 1) . (TCon ("list" . [(TVar 1)]))) => ("?1" . ["?1 would be an infinite type"]) fuel 1000000
Unify ((TCon ("Dyn" . ~)) . (TCon ("Int" . ~))) => ("Dyn" . ["expected Int, but this is Dyn"]) fuel 1000000
Unify ((TVar 1) . (TCon ("Dyn" . ~))) => ("Dyn" . ~) fuel 1000000
Unify ((TCon ("pair" . [(TCon ("Int" . ~)) (TCon ("Int" . ~))])) . (TCon ("list" . [(TCon ("Int" . ~))]))) => ("(Int . Int)" . ["expected [Int], but this is (Int . Int)"]) fuel 1000000
Unify ((TCon ("->" . [(TCon ("Int" . ~)) (TCon ("Int" . ~))])) . (TCon ("->" . [(TCon ("Int" . ~)) (TCon ("Int" . ~))]))) => ("(Int -> Int)" . ~) fuel 1000000
Unify ((TCon ("->" . [(TCon ("Int" . ~)) (TCon ("Int" . ~))])) . (TCon ("->" . [(TCon ("list" . [(TCon ("Int" . ~))])) (TCon ("list" . [(TCon ("Int" . ~))]))]))) => ("(Int -> Int)" . ["expected [Int], but this is Int"]) fuel 1000000
Unify (TCon ("Option" . [(TCon ("Int" . ~))]) . (TCon ("Option" . [(TVar 3)]))) => ("Option Int" . ~) fuel 1000000
Gen (-1 . (TVar 1)) => ("forall ?1. ?1" . ~) fuel 1000000
Gen (-1 . (TCon ("->" . [(TVar 1) (TVar 2)]))) => ("forall ?1 ?2. (?1 -> ?2)" . ~) fuel 1000000
Gen (-1 . (TCon ("Int" . ~))) => ("Int" . ~) fuel 1000000
Gen (0 . (TVar 1)) => ("?1" . ~) fuel 1000000
Inst (0 . (Scheme ([1] . (TCon ("->" . [(TVar 1) (TVar 1)]))))) => ("(?1000 -> ?1000)" . ~) fuel 1000000
Inst (0 . (Scheme ([1 2] . (TCon ("->" . [(TVar 1) (TVar 2)]))))) => ("(?1000 -> ?1001)" . ~) fuel 1000000
Inst (0 . (Scheme ([] . (TVar 5)))) => ("?5" . ~) fuel 1000000
Inst (0 . (Scheme ([1] . (TCon ("list" . [(TVar 1)]))))) => ("[?1000]" . ~) fuel 1000000
