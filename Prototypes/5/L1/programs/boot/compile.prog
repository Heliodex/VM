	(let UNARYS (list "head" "tail" "pin" "force" "fix")
	(letrec rev
		(fn (l acc) (if (? l) acc (rev (tail l) [(head l) acc])))
	(letrec same
		(fn (a b) (if (? a) (? b) (if (? b) 0 (if (= (head a) (head b)) (same (tail a) (tail b)) 0))))
	(letrec member
		(fn (x xs) (if (? xs) 0 (if (same x (head xs)) 1 (member x (tail xs)))))
	(letrec isReserved
		(fn s (member s RESERVED))
	(letrec lenOf
		(fn l (if (? l) 0 (+ 1 (lenOf (tail l)))))
	(letrec lastOf
		(fn l (if (? (tail l)) (head l) (lastOf (tail l))))
	(letrec initOf
		(fn l (if (? (tail l)) ~ [(head l) (initOf (tail l))]))
	(letrec nthOf
		(fn (l i) (if (= i 1) (head l) (nthOf (tail l) (- i 1))))
