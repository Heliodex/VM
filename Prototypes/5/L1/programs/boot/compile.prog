							(if (defOk def)
									(bdefs (tail bs) [def acc])
									[1 "mutual binds fns, so the functions can call each other"])))))
	(letrec PRIM_TAG
		(fn nm
			(if (same nm "+") 11
					(if (same nm "-") 12
							(if (same nm "*") 13
									(if (same nm "div") 14
											(if (same nm "<") 16
													(if (same nm "=") 17 15)))))))
	(letrec UNARY_TAG
		(fn nm
			(if (same nm "pin") 4 8))
	(mutual (
		(compile (fn (node scope) (let k (head node) (if (= k 0) [0 (qInt (payOf node))] (if (= k 4) [0 (strQ (payOf node))] (if (= k 1) (let p (payOf node) (if (same p "~") [0 qNil] (if (isReserved p) [1 "a reserved word cannot be a variable"] (bind (idxOf scope p 0) (fn i [0 (qVar i)]))))) (if (= k 3) (let items (payOf node) (if (? items) [1 "a pair takes at least two items"] (if (? (tail items)) [1 "a pair takes at least two items"] (pairRight items scope)))) (let items (payOf node) (if (? items) [1 "() is not an expression, and nil is written ~"] (let h (head items) (if (= (head h) 1) (let hn (payOf h) (if (isReserved hn) (compileForm hn items scope) (compileForm ~ items scope))) (compileForm ~ items scope))))))))))))
		(compileForm (fn (nm items scope) (let n (- (lenOf items) 1) (if (same nm "fn") (if (< n 2) [1 "fn needs a parameter and a body"] (let ps (tail (initOf items)) (let body (lastOf items) (bind (paramNames ps ~) (fn ns (let names (rev ns ~) (if (? names) [1 "fn needs at least one parameter"] (bind (compile body (addNames names scope)) (fn b [0 (wrapLams (lenOf names) b)]))))))))) (if (same nm "let") (if (= n 3) (let binder (nthOf items 2) (if (= (head binder) 1) (bind (compile (nthOf items 3) scope) (fn v (bind (compile (nthOf items 4) [(payOf binder) scope]) (fn b [0 (qApp (qLam b) v)])))) [1 "let binds a name"])) [1 "let takes three parts"]) (if (same nm "letrec") (if (= n 3) (let binder (nthOf items 2) (let defn (nthOf items 3) (if (= (head binder) 1) (if (defOk defn) (let inner [(payOf binder) scope] (bind (compile defn inner) (fn d (bind (compile (nthOf items 4) inner) (fn b [0 (qApp (qLam b) (qApp qFixE (qLam d)))]))))) [1 "letrec binds a fn, so the function can call itself"]) [1 "letrec binds a name"]))) [1 "letrec takes three parts"]) (if (same nm "if") (if (= n 3) (bind (compile (nthOf items 2) scope) (fn c (bind (compile (nthOf items 3) scope) (fn t (bind (compile (nthOf items 4) scope) (fn e [0 (qIf c t e)])))))) [1 "if takes three parts"]) (if (same nm "mutual") (if (= n 2) (let bindings (nthOf items 2) (if (= (head bindings) 2) (let binds (payOf bindings) (if (? binds) [1 "mutual binds a list of (name fn) pairs"] (bind (bnames binds ~) (fn ns (bind (bdefs binds ~) (fn ds (let names (rev ns ~) (let defs (rev ds ~) (let chain (chainOf (brsOf defs names) 1) (let dispatch (nList (list (nSym "fn") (nSym " self") (nList (list (nSym "fn") (nSym " tag") (nList (list (nSym "fn") (nSym " x") chain)))))) (compile (nList (list (nSym "let") (nSym " group") (nList (list (nSym "fix") dispatch)) (wrapAll 1 names " group" (nthOf items 3)))) scope))))))))))) [1 "mutual binds a list of (name fn) pairs"])) [1 "mutual takes two parts"]) (if (same nm "list") (bind (compileAll