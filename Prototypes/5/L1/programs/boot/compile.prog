					(if (same (head s) n) [0 i] (idxOf (tail s) n (+ i 1)))))
	(letrec qList
		(fn xs (if (? xs) qNil (qCell (head xs) (qList (tail xs)))))
	(letrec strQ
		(fn cs (if (? cs) qNil (qCell (qInt (head cs)) (strQ (tail cs)))))
