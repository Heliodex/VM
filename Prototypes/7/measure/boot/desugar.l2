The L2 desugarer, written in L2: the stage that turns the parser's tree into the machine's expressions, as Prototypes/6/L2/desugar.luau does. This is the first slice. It covers the literals, names, application, fn, let, letrec, if, match, the checked primitives and the built-in sum Result. Records, with, check, mutual groups and early return (?) give an error that names the form. Each function gives Ok of its result, or Err with the message the host gives, with the same line and column.
---
---
type Expr =
	| EInt (Int . (Int . Int))
	| EStr ([Int] . (Int . Int))
	| ENil (Int . Int)
	| EName ([Int] . (Int . Int))
	| EList ([Expr] . (Int . Int))
	| EPair (Expr . (Expr . (Int . Int)))
	| EApp (Expr . ([Expr] . (Int . Int)))
	| EFn ([[Int]] . (Expr . (Int . Int)))
	| ELet ([Int] . (Expr . (Expr . (Int . (Int . Int)))))
	| EMutual ([([Int] . (Expr . (Int . Int)))] . (Expr . (Int . Int)))
	| EIf (Expr . (Expr . (Expr . (Int . Int))))
	| EMatch (Expr . ([(Pat . (Expr . (Int . Int)))] . (Int . Int)))
	| ETry (Expr . (Int . Int))
	| ECheck (Expr . (Int . Int))
	| EUntyped (Expr . (Int . Int))
	| ERec ([Int] . ([([Int] . (Expr . (Int . Int)))] . (Int . Int)))
	| EWith (Expr . ([([Int] . (Expr . (Int . Int)))] . (Int . Int)))
type Pat =
	| PCon ([Int] . ([Int] . (Int . Int)))
	| PBind ([Int] . (Int . Int))
	| PWild (Int . Int)
type Code =
	| QInt Int
	| QNil
	| CVar Int
	| CLam Code
	| CApp (Code . Code)
	| CCell (Code . Code)
	| CIndex (Int . Code)
	| CIf (Code . (Code . Code))
	| CPin Code
	| CForce Code
	| CConstruct (Int . Code)
	| CTagof Code
	| CPayload Code
	| CPrim1 (Int . Code)
	| CPrim2 (Int . (Code . Code))
; Lists are taken apart with head and tail, which give a Result: hd gives the head, or the default on nil, and tl gives the tail, or nil. A list is not a pair to the checker, so fst and snd are for pairs only.
let hd = fn (l d)
	match (head l)
		Ok c -> c
		Err e -> d
let tl = fn l
	match (tail l)
		Ok t -> t
		Err e -> ~
letrec cat = fn (a b)
	(if (= (@ a) 1) b (cons (hd a 0) (cat (tl a) b)))
letrec same = fn (a b)
	(if (= (@ a) 1) (= (@ b) 1) (if (= (@ b) 1) 0 (if (= (hd a 0) (hd b 0)) (same (tl a) (tl b)) 0)))
letrec countL = fn l
	(if (= (@ l) 1) 0 (+ 1 (countL (tl l))))
letrec buildCells = fn codes
	(if (= (@ codes) 1) QNil (CCell ((hd codes QNil) . (buildCells (tl codes)))))
letrec textCode = fn bs
	(if (= (@ bs) 1) QNil (CCell ((QInt (hd bs 0)) . (textCode (tl bs)))))
letrec wrapLams = fn (n b)
	(if (< n 1) b (wrapLams (- n 1) (CLam b)))
letrec pushNames = fn (scope names)
	(if (= (@ names) 1) scope (pushNames (cons (hd names ~) scope) (tl names)))
letrec indexFrom = fn (scope name i)
	(if (= (@ scope) 1) (-1) (if (same (hd scope ~) name) i (indexFrom (tl scope) name (+ i 1))))
let indexIn = fn (scope name)
	(indexFrom scope name 0)
letrec inList = fn (names s)
	(if (= (@ names) 1) 0 (if (same (hd names ~) s) 1 (inList (tl names) s)))
letrec showInt = fn n
	if (< n 10)
		(Ok (cons (+ 48 n) ~))
	else
		let q = ((/ n 10)?)
		let r = ((% n 10)?)
		let s = ((showInt q)?)
		(Ok (cat s (cons (+ 48 r) ~)))
let errAt = fn (at msg)
	let l = ((showInt (fst at))?)
	let c = ((showInt (snd at))?)
	(Err (cat "line " (cat l (cat ", column " (cat c (cat ": " msg))))))
let primTable = [("+" . 11) ("-" . 12) ("*" . 13) ("/" . 14) ("%" . 15) ("<" . 16) ("=" . 17) ("@" . 18)]
letrec primIn = fn (tbl s)
	(if (= (@ tbl) 1) (-1) (if (same (fst (hd tbl (~ . 0))) s) (snd (hd tbl (~ . 0))) (primIn (tl tbl) s)))
let primOf = fn s
	(primIn primTable s)
let primArity = fn p
	(if (= p 18) 1 2)
let unaryNames = ["head" "tail" "fst" "snd" "pin" "force" "fix"]
let isUnary = fn s
	(inList unaryNames s)
let ctorOf = fn s
	(if (same s "Ok") 0 (if (same s "Err") 1 (-1)))
let isCap = fn name
	(if (< 64 (hd name 0)) (if (< (hd name 0) 91) 1 0) 0)
let blankName = fn name
	(if (same name "_") 1 (same name "~"))
let atOf = fn e
	match e
		EInt p -> (snd p)
		EStr p -> (snd p)
		ENil p -> p
		EName p -> (snd p)
		EList p -> (snd p)
		EPair p -> (snd (snd p))
		EApp p -> (snd (snd p))
		EFn p -> (snd (snd p))
		ELet p -> (snd (snd (snd (snd p))))
		EMutual p -> (snd (snd p))
		EIf p -> (snd (snd (snd p)))
		EMatch p -> (snd (snd p))
		ETry p -> (snd p)
		ECheck p -> (snd p)
		EUntyped p -> (snd p)
		ERec p -> (snd (snd p))
		EWith p -> (snd (snd p))
let isFnNode = fn e
	match e
		EFn p -> 1
		_ -> 0
let atOfArm = fn arm
	(snd (snd arm))
let dummyArm = (PWild (0 . 0) . (ENil (0 . 0) . (0 . 0)))
let primErr = fn (name at)
	(errAt at (cat name " is a primitive, and cannot be bound"))
let checkBinder3 = fn (name at)
	(if (< (primOf name) 0) (if (= (isUnary name) 1) (primErr name at) (Ok ~)) (primErr name at))
let checkBinder2 = fn (name at)
	(if (= (blankName name) 1) (errAt at (cat name " cannot be bound")) (checkBinder3 name at))
let checkBinder = fn (name at)
	(if (= (isCap name) 1) (errAt at (cat name " is a constructor, and cannot be bound")) (checkBinder2 name at))
letrec checkNames = fn (names seen at)
	if (= (@ names) 1)
		(Ok ~)
	else
		let u = ((checkBinder (hd names ~) at)?)
		(if (= (inList seen (hd names ~)) 1) (errAt at (cat (hd names ~) " is named twice in the parameters")) (checkNames (tl names) (cons (hd names ~) seen) at))
let fixInner = (CLam (CApp ((CVar 1) . (CLam (CApp ((CApp ((CVar 1) . (CVar 1))) . (CVar 0)))))))
let fixCode = (CLam (CApp (fixInner . fixInner)))
let stepIndex = fn (side e)
	match e
		CIndex p -> (if (< (fst p) 1125899906842624) (CIndex ((+ (* 2 (fst p)) side) . (snd p))) (CIndex ((+ 2 side) . e)))
		_ -> (CIndex ((+ 2 side) . e))
let divBody = fn (tag reason)
	(CIf ((CPrim2 (17 . ((CVar 0) . (QInt 0)))) . ((CConstruct (1 . (textCode reason))) . (CConstruct (0 . (CPrim2 (tag . ((CVar 1) . (CVar 0)))))))))
let divCheck = fn (tag x y reason)
	(CApp ((CApp ((CLam (CLam (divBody tag reason))) . x)) . y))
let headCheck = fn x
	(CApp ((CLam (CIf ((CPrim2 (17 . ((CPrim1 (18 . (CVar 0))) . (QInt 2)))) . ((CConstruct (0 . (stepIndex 0 (CVar 0)))) . (CConstruct (1 . (textCode "head of an empty list"))))))) . x))
let tailCheck = fn x
	(CApp ((CLam (CIf ((CPrim2 (17 . ((CPrim1 (18 . (CVar 0))) . (QInt 2)))) . ((CConstruct (0 . (stepIndex 1 (CVar 0)))) . (CConstruct (1 . (textCode "tail of an empty list"))))))) . x))
let unaryOf6 = fn (name e)
	(if (same name "force") (CForce e) (CApp (fixCode . e)))
let unaryOf5 = fn (name e)
	(if (same name "pin") (CPin e) (unaryOf6 name e))
let unaryOf4 = fn (name e)
	(if (same name "snd") (stepIndex 1 e) (unaryOf5 name e))
let unaryOf3 = fn (name e)
	(if (same name "fst") (stepIndex 0 e) (unaryOf4 name e))
let unaryOf2 = fn (name e)
	(if (same name "tail") (tailCheck e) (unaryOf3 name e))
let unaryOf = fn (name e)
	(if (same name "head") (headCheck e) (unaryOf2 name e))
let resolveNonPrim3 = fn (name at)
	(if (< (ctorOf name) 0) (errAt at (cat name " is not bound")) (Ok (CLam (CConstruct ((ctorOf name) . (CVar 0))))))
let resolveNonPrim2 = fn (name at)
	(if (= (isUnary name) 1) (Ok (CLam (unaryOf name (CVar 0)))) (resolveNonPrim3 name at))
let resolveNonPrim = fn (name at)
	(if (same name "cons") (Ok (CLam (CLam (CCell ((CVar 1) . (CVar 0)))))) (resolveNonPrim2 name at))
let primValue3 = fn (p)
	(if (= p 15) (Ok (CLam (CLam (divCheck 15 (CVar 1) (CVar 0) "remainder by zero")))) (Ok (CLam (CLam (CPrim2 (p . ((CVar 1) . (CVar 0))))))))
let primValue2 = fn (p)
	(if (= p 14) (Ok (CLam (CLam (divCheck 14 (CVar 1) (CVar 0) "division by zero")))) (primValue3 p))
let primValue = fn (p name at)
	(if (= p 18) (Ok (CLam (CPrim1 (18 . (CVar 0))))) (primValue2 p))
let resolveGlobal = fn (name at)
	let p = (primOf name)
	(if (< p 0) (resolveNonPrim name at) (primValue p name at))
let resolveName = fn (name at scope)
	let i = (indexIn scope name)
	(if (< i 0) (resolveGlobal name at) (Ok (CVar i)))
let binPrim2 = fn (p x y)
	(if (= p 15) (divCheck 15 x y "remainder by zero") (CPrim2 (p . (x . y))))
let binPrim = fn (p x y)
	(if (= p 14) (divCheck 14 x y "division by zero") (binPrim2 p x y))
let appKind3 = fn (name n)
	(if (< (primOf name) 0) (if (< (ctorOf name) 0) 0 (if (< n 1) 0 4)) (if (< n (primArity (primOf name))) 0 3))
let appKind2 = fn (name n)
	(if (= (isUnary name) 1) (if (< n 1) 0 2) (appKind3 name n))
let appKind = fn (name n)
	(if (same name "cons") (if (< n 2) 0 1) (appKind2 name n))
fn e
	letrec
		desugar = fn (node scope)
			match node
				EInt p -> (Ok (QInt (fst p)))
				EStr p -> (Ok (textCode (fst p)))
				ENil p -> (Ok QNil)
				EName p -> (resolveName (fst p) (snd p) scope)
				EList p -> (desugarList (fst p) scope)
				EPair p -> (desugarPair (fst p) (fst (snd p)) scope)
				EApp p -> (desugarApp (fst p) (fst (snd p)) scope)
				EFn p -> (desugarFn (fst p) (fst (snd p)) (snd (snd p)) scope)
				ELet p -> (desugarLet (fst p) (fst (snd p)) (fst (snd (snd p))) (fst (snd (snd (snd p)))) (snd (snd (snd (snd p)))) scope)
				EIf p -> (desugarIf (fst p) (fst (snd p)) (fst (snd (snd p))) scope)
				EMatch p -> (desugarMatch (fst p) (fst (snd p)) scope)
				EUntyped p -> (desugar (fst p) scope)
				ETry p -> (errAt (snd p) "early return (?) is not in the first slice")
				ECheck p -> (errAt (snd p) "check is not in the first slice")
				EMutual p -> (errAt (snd (snd p)) "a mutual group is not in the first slice")
				ERec p -> (errAt (snd (snd p)) "a record is not in the first slice")
				EWith p -> (errAt (snd (snd p)) "with is not in the first slice")
		desugarPair = fn (a b scope)
			let x = ((desugar a scope)?)
			let y = ((desugar b scope)?)
			(Ok (CCell (x . y)))
		desugarItems = fn (items scope)
			if (= (@ items) 1)
				(Ok ~)
			else
				let x = ((desugar (hd items (ENil (0 . 0))) scope)?)
				let rest = ((desugarItems (tl items) scope)?)
				(Ok (cons x rest))
		desugarList = fn (items scope)
			let codes = ((desugarItems items scope)?)
			(Ok (buildCells codes))
		applyArgs = fn (code args scope)
			if (= (@ args) 1)
				(Ok code)
			else
				let x = ((desugar (hd args (ENil (0 . 0))) scope)?)
				(applyArgs (CApp (code . x)) (tl args) scope)
		genericApp = fn (callee args scope)
			let h = ((desugar callee scope)?)
			(applyArgs h args scope)
		consApp = fn (args scope)
			let x = ((desugar (hd args (ENil (0 . 0))) scope)?)
			let y = ((desugar (hd (tl args) (ENil (0 . 0))) scope)?)
			(applyArgs (CCell (x . y)) (tl (tl args)) scope)
		unaryApp = fn (name args scope)
			let x = ((desugar (hd args (ENil (0 . 0))) scope)?)
			(applyArgs (unaryOf name x) (tl args) scope)
		primApp = fn (p args scope)
			let x = ((desugar (hd args (ENil (0 . 0))) scope)?)
			(if (= (primArity p) 1) (applyArgs (CPrim1 (p . x)) (tl args) scope) (primApp2 p x args scope))
		primApp2 = fn (p x args scope)
			let y = ((desugar (hd (tl args) (ENil (0 . 0))) scope)?)
			(applyArgs (binPrim p x y) (tl (tl args)) scope)
		ctorApp = fn (tag args scope)
			let x = ((desugar (hd args (ENil (0 . 0))) scope)?)
			(applyArgs (CConstruct (tag . x)) (tl args) scope)
		appByKind = fn (kind callee name args scope)
			(if (= kind 1) (consApp args scope) (appByKind2 kind callee name args scope))
		appByKind2 = fn (kind callee name args scope)
			(if (= kind 2) (unaryApp name args scope) (appByKind3 kind callee name args scope))
		appByKind3 = fn (kind callee name args scope)
			(if (= kind 3) (primApp (primOf name) args scope) (appByKind4 kind callee name args scope))
		appByKind4 = fn (kind callee name args scope)
			(if (= kind 4) (ctorApp (ctorOf name) args scope) (genericApp callee args scope))
		nameApp = fn (callee name args scope)
			(if (< (indexIn scope name) 0) (appByKind (appKind name (countL args)) callee name args scope) (genericApp callee args scope))
		desugarApp = fn (callee args scope)
			match callee
				EName p -> (nameApp callee (fst p) args scope)
				_ -> (genericApp callee args scope)
		desugarFn = fn (names body at scope)
			let ok = ((checkNames names ~ at)?)
			let b = ((desugar body (pushNames scope names))?)
			(Ok (wrapLams (countL names) b))
		desugarLet = fn (name value body rec at scope)
			let u = ((checkBinder name at)?)
			(if (= rec 1) (desugarRec name value body at scope) (desugarPlainLet name value body scope))
		desugarPlainLet = fn (name value body scope)
			let b = ((desugar body (pushNames scope (cons name ~)))?)
			let v = ((desugar value scope)?)
			(Ok (CApp ((CLam b) . v)))
		desugarRec = fn (name value body at scope)
			(if (= (isFnNode value) 1) (desugarRecBody name value body scope) (errAt (atOf value) "letrec binds a fn, so the function can call itself"))
		desugarRecBody = fn (name value body scope)
			let inner = (pushNames scope (cons name ~))
			let b = ((desugar body inner)?)
			let v = ((desugar value inner)?)
			(Ok (CApp ((CLam b) . (CApp (fixCode . (CLam v))))))
		desugarIf = fn (c t e scope)
			let cc = ((desugar c scope)?)
			let tt = ((desugar t scope)?)
			let ee = ((desugar e scope)?)
			(Ok (CIf (cc . (tt . ee))))
		desugarMatch = fn (scrut arms scope)
			let s = ((desugar scrut scope)?)
			let b = ((buildArms arms (pushNames scope (cons " scrut" ~)))?)
			(Ok (CApp ((CLam b) . s)))
		buildArms = fn (arms scope)
			if (= (@ arms) 1)
				(Ok (CIndex (2 . (QInt 0))))
			else
				armCase (fst (hd arms dummyArm)) (fst (snd (hd arms dummyArm))) (tl arms) scope
		armCase = fn (pat body rest scope)
			match pat
				PWild p -> (wildArm body rest scope)
				PBind p -> (bindArm (fst p) (snd p) body rest scope)
				PCon p -> (conArm (fst p) (fst (snd p)) (snd (snd p)) body rest scope)
		wildArm = fn (body rest scope)
			if (= (@ rest) 1)
				(desugar body scope)
			else
				(errAt (atOfArm (hd rest dummyArm)) "an arm after a catch-all arm is unreachable")
		bindArm = fn (name at body rest scope)
			if (= (@ rest) 1)
				let u = ((checkBinder name at)?)
				let b = ((desugar body (pushNames scope (cons name ~)))?)
				(Ok (CApp ((CLam b) . (CVar 0))))
			else
				(errAt (atOfArm (hd rest dummyArm)) "an arm after a catch-all arm is unreachable")
		conArm = fn (name bind at body rest scope)
			(if (< (ctorOf name) 0) (errAt at (cat name " is not a constructor")) (conArmOk (ctorOf name) bind at body rest scope))
		conArmOk = fn (tag bind at body rest scope)
			let b = ((conBody bind at body scope)?)
			let r = ((buildArms rest scope)?)
			(Ok (CIf ((CPrim2 (17 . ((CTagof (CVar 0)) . (QInt tag)))) . (b . r))))
		conBody = fn (bind at body scope)
			if (= (@ bind) 1)
				(desugar body scope)
			else
				let u = ((checkBinder bind at)?)
				let b = ((desugar body (pushNames scope (cons bind ~)))?)
				(Ok (CApp ((CLam b) . (CPayload (CVar 0)))))
	(desugar e ~)
---
EInt (5 . (1 . 1)) => Ok (QInt 5) fuel 100000
