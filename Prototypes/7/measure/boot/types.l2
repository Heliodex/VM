The first part of the L2 checker, written in L2 with no mutation. The state is a value: a counter for the next variable, the bindings of the variables, and the errors so far. A binding is a list of (id . Bind), and a new binding is consed on the front, so a lookup finds the newest. Every operation gives back the state it changes. This file holds the types, the state, and unification. A test's output is the rendered first type, with the errors, as the Luau checker writes them.
---
---
type Ty = TVar Int | TCon ([Int] . [Ty])
type Bind = Unbound Int | Bound Ty
type St = St (Int . (Tr . [[Int]]))
type Scheme = Scheme ([Int] . Ty)
type Entry =
	| EVar Scheme
	| ECtor ([Int] . ([Int] . (Int . (Int . Ty))))
	| ESum ([Int] . ([Int] . [([Int] . (Int . Int))]))
	| ERecC ([Int] . ([Int] . (Int . ([[Int]] . Ty))))
	| EAcc ([Int] . (Int . Int))
type Look = Found Entry | Missing
type PTy =
	| TName ([Int] . (Int . Int))
	| TApp ([Int] . ([PTy] . (Int . Int)))
	| TPair (PTy . (PTy . (Int . Int)))
	| TList (PTy . (Int . Int))
	| TFun (PTy . (PTy . (Int . Int)))
	| NoType
	| TRec [([Int] . (PTy . (Int . Int)))]
type Req =
	| Unify (Ty . Ty)
	| Gen (Int . Ty)
	| Inst (Int . Scheme)
	| Infer ([([Int] . ([[Int]] . ([([Int] . (PTy . (Int . Int)))] . (Int . Int))))] . Expr)
	| InferI ([([Int] . ([([Int] . ([[Int]] . ([([Int] . (PTy . (Int . Int)))] . (Int . Int))))] . Expr))] . ([([Int] . ([[Int]] . ([([Int] . (PTy . (Int . Int)))] . (Int . Int))))] . Expr))
type MS = MS (St . (Int . ([Int] . (Ty . ([Ty] . ([Int] . Int))))))
type Expr =
	| EInt (Int . (Int . Int))
	| EStr ([Int] . (Int . Int))
	| ENil (Int . Int)
	| EName ([Int] . (Int . Int))
	| EList ([Expr] . (Int . Int))
	| EPair (Expr . (Expr . (Int . Int)))
	| EApp (Expr . ([Expr] . (Int . Int)))
	| EFn ([[Int]] . (Expr . (Int . Int)))
	| ELet ([Int] . (Expr . (Expr . (Int . (Int . Int)))))
	| EMutual ([([Int] . (Expr . (Int . Int)))] . (Expr . (Int . Int)))
	| EIf (Expr . (Expr . (Expr . (Int . Int))))
	| EMatch (Expr . ([(Pat . (Expr . (Int . Int)))] . (Int . Int)))
	| ETry (Expr . (Int . Int))
	| ECheck (Expr . (Int . Int))
	| EUntyped (Expr . (Int . Int))
	| ERec ([Int] . ([([Int] . (Expr . (Int . Int)))] . (Int . Int)))
	| EWith (Expr . ([([Int] . (Expr . (Int . Int)))] . (Int . Int)))
type Tr = TEmpty | TNode (Bind . (Tr . Tr))
type Pat =
	| PCon ([Int] . ([Int] . (Int . Int)))
	| PBind ([Int] . (Int . Int))
	| PWild (Int . Int)
	| PRec ([Int] . ([([Int] . ([Int] . (Int . Int)))] . (Int . Int)))
let hdOr = fn (l dflt)
	match (head l)
		Ok x -> x
		Err e -> dflt
let first = fn l
	match (head l)
		Ok c -> c
		Err e -> -1
let tl = fn l
	match (tail l)
		Ok t -> t
		Err e -> ~
let div10 = fn n
	match (/ n 10)
		Ok q -> q
		Err e -> 0
let mod10 = fn n
	match (% n 10)
		Ok r -> r
		Err e -> 0
letrec same = fn (a b)
	(if (= (@ a) 1) (= (@ b) 1) (if (= (@ b) 1) 0 (if (= (first a) (first b)) (same (tl a) (tl b)) 0)))
letrec lenOf = fn l
	(if (= (@ l) 1) 0 (+ 1 (lenOf (tl l))))
letrec cat = fn (a b)
	(if (= (@ a) 1) b (cons (first a) (cat (tl a) b)))
letrec showNat = fn n
	(if (< n 10) (cons (+ 48 n) ~) (cat (showNat (div10 n)) (cons (+ 48 (mod10 n)) ~)))
let varName = fn id
	(cat "?" (showNat id))
let stP = fn st
	match st
		St p -> p
let nextOf = fn st
	(fst (stP st))
let bindsOf = fn st
	(fst (snd (stP st)))
let errsOf = fn st
	(snd (snd (stP st)))
let mkSt = fn (n bs es)
	(St (n . (bs . es)))
letrec snoc = fn (l x)
	if (= (@ l) 1)
		(cons x ~)
	else
		match (head l)
			Ok h -> (cons h (snoc (tl l) x))
			Err e -> (cons x ~)
let addErr = fn (st msg)
	(mkSt (nextOf st) (bindsOf st) (snoc (errsOf st) msg))
let halfOf = fn n
	match (/ n 2)
		Ok q -> q
		Err e -> 0
let oddOf = fn n
	match (% n 2)
		Ok r -> r
		Err e -> 0
let pickSide = fn (lr b)
	(if (= b 1) (snd lr) (fst lr))
letrec findB = fn (bs id)
	match bs
		TEmpty -> (Unbound 0)
		TNode p -> (if (= id 0) (fst p) (findB (pickSide (snd p) (oddOf id)) (halfOf id)))
letrec setB = fn (bs id b)
	match bs
		TEmpty -> (setB (TNode ((Unbound 0) . (TEmpty . TEmpty))) id b)
		TNode p -> (if (= id 0) (TNode (b . (snd p))) (if (= (oddOf id) 1) (TNode ((fst p) . ((fst (snd p)) . (setB (snd (snd p)) (halfOf id) b)))) (TNode ((fst p) . ((setB (fst (snd p)) (halfOf id) b) . (snd (snd p)))))))
let levelOf = fn b
	match b
		Unbound lv -> lv
		Bound t -> 0
let fresh = fn (st level)
	let n = (nextOf st)
	((TVar n) . (mkSt (+ n 1) (setB (bindsOf st) n (Unbound level)) (errsOf st)))
letrec prune = fn (bs t)
	match t
		TVar id ->
			match (findB bs id)
				Bound u -> (prune bs u)
				Unbound lv -> t
		TCon p -> t
letrec occurs = fn (bs id t)
	letrec all = fn args
		(if (= (@ args) 1) 0 (if (occurs bs id (hdOr args (TVar 0))) 1 (all (tl args))))
	match (prune bs t)
		TVar y -> (= y id)
		TCon p -> (all (snd p))
letrec lowerT = fn (bs t level)
	letrec lowerArgs = fn (b args)
		(if (= (@ args) 1) b (lowerArgs (lowerT b (hdOr args (TVar 0)) level) (tl args)))
	match (prune bs t)
		TVar y -> (if (< level (levelOf (findB bs y))) (setB bs y (Unbound level)) bs)
		TCon p -> (lowerArgs bs (snd p))
let hasArgs = fn (bs a)
	match (prune bs a)
		TVar y -> 0
		TCon p -> (if (= (@ (snd p)) 1) 0 1)
letrec render = fn (bs t)
	letrec argText = fn a
		(if (= (hasArgs bs a) 1) (cat "(" (cat (render bs a) ")")) (render bs a))
	letrec argsText = fn args
		(if (= (@ args) 1) ~ (cat " " (cat (argText (hdOr args (TVar 0))) (argsText (tl args)))))
	letrec renderCon = fn (name args)
		(if (same name "->") (cat "(" (cat (render bs (hdOr args (TVar 0))) (cat " -> " (cat (render bs (hdOr (tl args) (TVar 0))) ")")))) (if (same name "pair") (cat "(" (cat (render bs (hdOr args (TVar 0))) (cat " . " (cat (render bs (hdOr (tl args) (TVar 0))) ")")))) (if (same name "list") (cat "[" (cat (render bs (hdOr args (TVar 0))) "]")) (if (= (@ args) 1) name (cat name (argsText args))))))
	match (prune bs t)
		TVar y -> (varName y)
		TCon p -> (renderCon (fst p) (snd p))
let mismatch = fn (st a e)
	(addErr st (cat "expected " (cat (render (bindsOf st) e) (cat ", but this is " (render (bindsOf st) a)))))
let bindVar = fn (st id t)
	(if (occurs (bindsOf st) id t) (addErr st (cat (varName id) " would be an infinite type")) (mkSt (nextOf st) (setB (lowerT (bindsOf st) t (levelOf (findB (bindsOf st) id))) id (Bound t)) (errsOf st)))
letrec unify = fn (st a0 e0)
	letrec unifyArgs = fn (st0 aa ea)
		if (= (@ aa) 1)
			st0
		else
			let st1 = (unify st0 (hdOr aa (TVar 0)) (hdOr ea (TVar 0)))
			(if (< (lenOf (errsOf st0)) (lenOf (errsOf st1))) st1 (unifyArgs st1 (tl aa) (tl ea)))
	let unifyCon = fn (st2 na aa ne ea a e)
		(if (if (same na "Dyn") (same ne "Dyn") 0) st2 (if (if (same na "Dyn") 1 (same ne "Dyn")) (mismatch st2 a e) (if (if (same na ne) (= (lenOf aa) (lenOf ea)) 0) (unifyArgs st2 aa ea) (mismatch st2 a e))))
	let bs = (bindsOf st)
	let a = (prune bs a0)
	let e = (prune bs e0)
	match a
		TVar x ->
			match e
				TVar y -> (if (= x y) st (bindVar st x e))
				TCon q -> (bindVar st x e)
		TCon p ->
			match e
				TVar y -> (bindVar st y a)
				TCon q -> (unifyCon st (fst p) (snd p) (fst q) (snd q) a e)
letrec memberI = fn (x l)
	(if (= (@ l) 1) 0 (if (= (first l) x) 1 (memberI x (tl l))))
letrec freeAbove = fn (bs level t acc)
	letrec argsFree = fn (acc2 args)
		(if (= (@ args) 1) acc2 (argsFree (freeAbove bs level (hdOr args (TVar 0)) acc2) (tl args)))
	match (prune bs t)
		TVar y -> (if (if (< level (levelOf (findB bs y))) (if (memberI y acc) 0 1) 0) (snoc acc y) acc)
		TCon p -> (argsFree acc (snd p))
let generalize = fn (st level t)
	(Scheme ((freeAbove (bindsOf st) level t ~) . t))
let schemeVars = fn s
	match s
		Scheme p -> (fst p)
let schemeTy = fn s
	match s
		Scheme p -> (snd p)
letrec lookupM = fn (m id dflt)
	(if (= (@ m) 1) dflt (if (= (fst (hdOr m (0 . (TVar 0)))) id) (snd (hdOr m (0 . (TVar 0)))) (lookupM (tl m) id dflt)))
letrec subst = fn (bs m t)
	letrec substArgs = fn args
		(if (= (@ args) 1) ~ (cons (subst bs m (hdOr args (TVar 0))) (substArgs (tl args))))
	match (prune bs t)
		TVar y -> (lookupM m y (TVar y))
		TCon p -> (TCon ((fst p) . (substArgs (snd p))))
letrec instMap = fn (st level m vars)
	if (= (@ vars) 1)
		(st . m)
	else
		let fr = (fresh st level)
		(instMap (snd fr) level (cons ((first vars) . (fst fr)) m) (tl vars))
let instantiate = fn (st level s)
	let r = (instMap st level ~ (schemeVars s))
	((subst (bindsOf (fst r)) (snd r) (schemeTy s)) . (fst r))
letrec idsText = fn l
	(if (= (@ l) 1) ~ (cat (varName (first l)) (if (= (@ (tl l)) 1) ~ (cat " " (idsText (tl l))))))
let schemeText = fn (bs s)
	(if (= (@ (schemeVars s)) 1) (render bs (schemeTy s)) (cat "forall " (cat (idsText (schemeVars s)) (cat ". " (render bs (schemeTy s))))))
let runUnify = fn q
	let st = (unify (mkSt 1000 TEmpty ~) (fst q) (snd q))
	((render (bindsOf st) (fst q)) . (errsOf st))
let runGen = fn q
	let st = (mkSt 1000 TEmpty ~)
	let s = (generalize st (fst q) (snd q))
	((schemeText (bindsOf st) s) . ~)
let runInst = fn q
	let st = (mkSt 1000 TEmpty ~)
	let r = (instantiate st (fst q) (snd q))
	((render (bindsOf (snd r)) (fst r)) . (errsOf (snd r)))
let atOfE = fn e
	match e
		ERec p -> (snd (snd p))
		EWith p -> (snd (snd p))
		EInt p -> (snd p)
		EStr p -> (snd p)
		ENil p -> p
		EName p -> (snd p)
		EList p -> (snd p)
		EPair p -> (snd (snd p))
		EApp p -> (snd (snd p))
		EFn p -> (snd (snd p))
		ELet p -> (snd (snd (snd (snd p))))
		EMutual p -> (snd (snd p))
		EIf p -> (snd (snd (snd p)))
		EMatch p -> (snd (snd p))
		ETry p -> (snd p)
		ECheck p -> (snd p)
		EUntyped p -> (snd p)
letrec lastMsg = fn l
	(if (= (@ (tl l)) 1) (hdOr l ~) (lastMsg (tl l)))
let posMsg = fn (at msg)
	(cat "line " (cat (showNat (fst at)) (cat ", column " (cat (showNat (snd at)) (cat ": " msg)))))
let tInt = (TCon ("Int" . ~))
let tDyn = (TCon ("Dyn" . ~))
let tArrow = fn (a b)
	(TCon ("->" . [a b]))
let tList = fn a
	(TCon ("list" . [a]))
let tPair = fn (a b)
	(TCon ("pair" . [a b]))
let tRes = fn (a e)
	(TCon ("Result" . [a e]))
let tPin = fn a
	(TCon ("Pin" . [a]))
let mono = fn (name ty)
	(name . (EVar (Scheme (~ . ty))))
let poly = fn (vars name ty)
	(name . (EVar (Scheme (vars . ty))))
let builtinEnv = [(mono "+" (tArrow tInt (tArrow tInt tInt))) (mono "-" (tArrow tInt (tArrow tInt tInt))) (mono "*" (tArrow tInt (tArrow tInt tInt))) (mono "<" (tArrow tInt (tArrow tInt tInt))) (mono "=" (tArrow tInt (tArrow tInt tInt))) (mono "/" (tArrow tInt (tArrow tInt (tRes tInt (tList tInt))))) (mono "%" (tArrow tInt (tArrow tInt (tRes tInt (tList tInt))))) (poly [1] "@" (tArrow (TVar 1) tInt)) (poly [1] "head" (tArrow (tList (TVar 1)) (tRes (TVar 1) (tList tInt)))) (poly [1] "tail" (tArrow (tList (TVar 1)) (tRes (tList (TVar 1)) (tList tInt)))) (poly [1 2] "fst" (tArrow (tPair (TVar 1) (TVar 2)) (TVar 1))) (poly [1 2] "snd" (tArrow (tPair (TVar 1) (TVar 2)) (TVar 2))) (poly [1] "cons" (tArrow (TVar 1) (tArrow (tList (TVar 1)) (tList (TVar 1))))) (poly [1] "pin" (tArrow (TVar 1) (tPin (TVar 1)))) (poly [1] "force" (tArrow (tPin (TVar 1)) (TVar 1))) (poly [1] "fix" (tArrow (tArrow (TVar 1) (TVar 1)) (TVar 1))) ("Ok" . (ECtor ("Result" . ([1 2] . (0 . (1 . (TVar 1))))))) ("Err" . (ECtor ("Result" . ([1 2] . (1 . (1 . (TVar 2))))))) ("#Result" . (ESum ("Result" . ([1 2] . [("Ok" . (0 . 1)) ("Err" . (1 . 1))]))))]
letrec findE = fn (env name)
	(if (= (@ env) 1) Missing (if (same (fst (hdOr env (~ . (EVar (Scheme (~ . (TVar 0))))))) name) (Found (snd (hdOr env (~ . (EVar (Scheme (~ . (TVar 0)))))))) (findE (tl env) name)))
let addPos = fn (st0 st1 at)
	(if (< (lenOf (errsOf st0)) (lenOf (errsOf st1))) (mkSt (nextOf st1) (bindsOf st1) (snoc (errsOf st0) (posMsg at (lastMsg (errsOf st1))))) st1)
let unifyAt = fn (st at a e)
	(addPos st (unify st a e) at)
letrec varsOf = fn l
	(if (= (@ l) 1) ~ (cons (TVar (first l)) (varsOf (tl l))))
let ctorSch = fn (name params hasPay payload)
	(if (= hasPay 1) (Scheme (params . (tArrow payload (TCon (name . (varsOf params)))))) (Scheme (params . (TCon (name . (varsOf params))))))
let ctorScheme = fn c
	match c
		ECtor p -> (ctorSch (fst p) (fst (snd p)) (fst (snd (snd (snd p)))) (snd (snd (snd (snd p)))))
		_ -> (Scheme (~ . (TVar 0)))
let retEntry = fn e
	match e
		EVar s -> (schemeTy s)
		_ -> (TVar 0)
let retOf = fn env
	match (findE env "#ret")
		Found e -> (retEntry e)
		Missing -> (TVar 0)
let notBound = fn (st p level)
	let fr = (fresh st level)
	((fst fr) . (addErr (snd fr) (posMsg (snd p) (cat (fst p) " is not bound"))))
let lookupEntry = fn (st e p level)
	match e
		EVar s -> (instantiate st level s)
		ECtor c -> (instantiate st level (ctorScheme (ECtor c)))
		ERecC r ->
			let fr = (fresh st level)
			((fst fr) . (addErr (snd fr) (posMsg (snd p) (cat (fst p) " is a record: write its fields in braces"))))
		_ -> (notBound st p level)
let lookupName = fn (st env p level)
	match (findE env (fst p))
		Found e -> (lookupEntry st e p level)
		Missing -> (notBound st p level)
let badProgram = fn (bs t)
	match (prune bs t)
		TVar y -> 0
		TCon p -> (if (same (fst p) "->") 0 1)
let grew = fn (a b)
	(if (< (lenOf (errsOf a)) (lenOf (errsOf b))) 1 0)
let msP = fn ms
	match ms
		MS p -> p
let msSt = fn ms
	(fst (msP ms))
let msFixed = fn ms
	(fst (snd (msP ms)))
let msName = fn ms
	(fst (snd (snd (msP ms))))
let msTy = fn ms
	(fst (snd (snd (snd (msP ms)))))
let msArgs = fn ms
	(fst (snd (snd (snd (snd (msP ms))))))
let msCov = fn ms
	(fst (snd (snd (snd (snd (snd (msP ms)))))))
let msCatch = fn ms
	(snd (snd (snd (snd (snd (snd (msP ms)))))))
let mkMS = fn (st fixed nm ty args cov catch)
	(MS (st . (fixed . (nm . (ty . (args . (cov . catch)))))))
let withSt = fn (ms st)
	(mkMS st (msFixed ms) (msName ms) (msTy ms) (msArgs ms) (msCov ms) (msCatch ms))
let withCatch = fn ms
	(mkMS (msSt ms) (msFixed ms) (msName ms) (msTy ms) (msArgs ms) (msCov ms) 1)
letrec freshN = fn (st0 n level)
	if (= n 0)
		(~ . st0)
	else
		let r = (fresh st0 level)
		let more = (freshN (snd r) (- n 1) level)
		((cons (fst r) (fst more)) . (snd more))
letrec zipM = fn (ps as)
	(if (= (@ ps) 1) ~ (cons ((first ps) . (hdOr as (TVar 0))) (zipM (tl ps) (tl as))))
letrec missingNames = fn (ctors cov)
	if (= (@ ctors) 1)
		~
	else
		let rest = (missingNames (tl ctors) cov)
		(if (= (memberI (fst (snd (hdOr ctors (~ . (0 . 0))))) cov) 1) rest (cons (fst (hdOr ctors (~ . (0 . 0)))) rest))
letrec joinNames = fn l
	(if (= (@ l) 1) ~ (if (= (@ (tl l)) 1) (hdOr l ~) (cat (hdOr l ~) (cat ", " (joinNames (tl l))))))
let argsOfT = fn t
	match t
		TVar y -> ~
		TCon p -> (snd p)
letrec fieldAtT = fn (t index count)
	(if (= index 1) (if (= count 1) t (hdOr (argsOfT t) (TVar 0))) (fieldAtT (hdOr (tl (argsOfT t)) (TVar 0)) (- index 1) (- count 1)))
letrec payloadOfT = fn tys
	(if (= (@ (tl tys)) 1) (hdOr tys (TVar 0)) (tPair (hdOr tys (TVar 0)) (payloadOfT (tl tys))))
letrec nameIn = fn (n l)
	(if (= (@ l) 1) 0 (if (same n (hdOr l ~)) 1 (nameIn n (tl l))))
letrec nameIndex = fn (n l j)
	(if (= (@ l) 1) 0 (if (same n (hdOr l ~)) j (nameIndex n (tl l) (+ j 1))))
letrec initFor = fn (n inits)
	(if (= (@ inits) 1) (~ . ((ENil (0 . 0)) . (0 . 0))) (if (same (fst (hdOr inits (~ . ((ENil (0 . 0)) . (0 . 0))))) n) (hdOr inits (~ . ((ENil (0 . 0)) . (0 . 0)))) (initFor n (tl inits))))
letrec hasInit = fn (n inits)
	(if (= (@ inits) 1) 0 (if (same (fst (hdOr inits (~ . ((ENil (0 . 0)) . (0 . 0))))) n) 1 (hasInit n (tl inits))))
let recDefault = (~ . (~ . (0 . (~ . (TVar 0)))))
let accDefault = (~ . (0 . 0))
let recEntry = fn e
	match e
		ERecC r -> (1 . r)
		_ -> (0 . recDefault)
let recOf = fn (env name)
	match (findE env name)
		Found e -> (recEntry e)
		Missing -> (0 . recDefault)
let accEntry = fn e
	match e
		EAcc a -> (1 . a)
		_ -> (0 . accDefault)
let accOf = fn (env name)
	match (findE env (cat "@" name))
		Found e -> (accEntry e)
		Missing -> (0 . accDefault)
let isRecT = fn t
	match t
		TRec fs -> 1
		_ -> 0
let recFieldsOf = fn t
	match t
		TRec fs -> fs
		_ -> ~
letrec fieldNames = fn fs
	(if (= (@ fs) 1) ~ (cons (fst (hdOr fs (~ . (NoType . (0 . 0))))) (fieldNames (tl fs))))
letrec firstBadInit = fn (name names inits seen isWith)
	if (= (@ inits) 1)
		(0 . ((0 . 0) . ~))
	else
		let it = (hdOr inits (~ . ((ENil (0 . 0)) . (0 . 0))))
		(if (= (nameIn (fst it) names) 0) (1 . ((snd (snd it)) . (if (= isWith 1) (cat (fst it) (cat " is not a field of " (cat name ", which the with takes from its first field"))) (cat name (cat " has no field " (fst it)))))) (if (= (nameIn (fst it) seen) 1) (1 . ((snd (snd it)) . (cat (fst it) " is given twice"))) (firstBadInit name names (tl inits) (cons (fst it) seen) isWith)))
letrec firstMissing = fn (names inits)
	(if (= (@ names) 1) (0 . ~) (if (= (hasInit (hdOr names ~) inits) 1) (firstMissing (tl names) inits) (1 . (hdOr names ~))))
letrec litVals = fn (inf st env level names inits payT j n)
	if (= (@ names) 1)
		(1 . st)
	else
		let init = (initFor (hdOr names ~) inits)
		let fty = (fieldAtT payT j n)
		let r = (inf st env (fst (snd init)) level)
		let s1 = (unifyAt (snd r) (atOfE (fst (snd init))) (fst r) fty)
		(if (= (grew (snd r) s1) 1) (0 . s1) (litVals inf s1 env level (tl names) inits payT (+ j 1) n))
let recLit = fn (inf st env node level)
	let name = (fst node)
	let inits = (fst (snd node))
	let at = (snd (snd node))
	let ro = (recOf env name)
	if (= (fst ro) 0)
		let fr = (fresh st level)
		((fst fr) . (addErr (snd fr) (posMsg at (cat name " is not a record"))))
	else
		let r = (snd ro)
		let sumN = (fst r)
		let ids = (fst (snd r))
		let names = (fst (snd (snd (snd r))))
		let pay = (snd (snd (snd (snd r))))
		let inst = (instMap st level ~ ids)
		let st1 = (fst inst)
		let m = (snd inst)
		let payT = (subst (bindsOf st1) m pay)
		let sumT = (subst (bindsOf st1) m (TCon (sumN . (varsOf ids))))
		let bad = (firstBadInit name names inits ~ 0)
		if (= (fst bad) 1)
			(fresh (addErr st1 (posMsg (fst (snd bad)) (snd (snd bad)))) level)
		else
			let mis = (firstMissing names inits)
